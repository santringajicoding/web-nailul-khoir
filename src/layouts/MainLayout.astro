---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import SEO from '../components/SEO.astro';

interface Props {
	title: string;
	description?: string;
	image?: string;
	type?: 'website' | 'article';
	publishDate?: string;
	author?: string;
}

const { 
	title, 
	description = "Yayasan Pondok Pesantren Nailul Khoir Majalengka. Lembaga pendidikan Islam jenjang SMPIT, SMK, dan Pondok Pesantren Salafiyah.",
	image = "/images/logo.png", // Default image for share preview
	type = "website",
	publishDate,
	author
} = Astro.props;

// Mendapatkan URL saat ini untuk Canonical Link & Open Graph URL
const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://nailulkhoir.netlify.app');
---

<!doctype html>
<html lang="id" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="theme-color" content="#064e3b" />
		
		<!-- PWA Manifest & Web App Setup -->
		<link rel="manifest" href="/manifest.json" />
		<meta name="mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
		<link rel="apple-touch-icon" href="/images/logo.png" />
		
		<!-- Komponen SEO (Meta, OpenGraph, Twitter, JSON-LD Schema) -->
		<SEO 
		  title={title} 
		  description={description} 
		  image={new URL(image, canonicalURL)} 
		  canonicalURL={canonicalURL} 
		  type={type}
		  publishDate={publishDate}
		  author={author}
		/>

		<!-- Google Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
		
		<!-- AOS CSS -->
		<link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
	</head>
	<body class="bg-gray-50 text-gray-800 font-sans antialiased min-h-screen flex flex-col">
		<Navbar />
		<main class="flex-grow">
			<slot />
		</main>
		<Footer />

		<!-- Tombol WhatsApp Melayang Premium -->
		<a href="https://wa.me/6288218336152?text=Assalamualaykum%20Admin%20Nailul%20Khoir,%20saya%20ingin%20bertanya%20seputar%20informasi%20pendaftaran." 
		   target="_blank" 
		   id="floatingWA"
		   class="fixed bottom-6 right-6 z-50 bg-[#25D366] text-white p-3.5 md:p-4 rounded-full shadow-2xl hover:scale-110 active:scale-90 md:hover:-translate-y-2 transition-all duration-300 group flex items-center justify-center border-4 border-white"
		   aria-label="Chat WhatsApp Admin">
			<!-- Tooltip (Hanya Desktop) -->
			<span class="absolute hidden md:block right-20 bg-white text-gray-800 text-sm font-bold px-4 py-2 rounded-xl shadow-xl opacity-0 translate-x-4 group-hover:translate-x-0 group-hover:opacity-100 transition-all duration-300 pointer-events-none whitespace-nowrap">
				Tanya Admin Kami 👋
				<!-- Panah Segitiga Tooltip -->
				<span class="absolute top-1/2 -right-1 -mt-1 w-3 h-3 bg-white rotate-45"></span>
			</span>
			<svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 md:w-8 md:h-8 fill-current drop-shadow-sm" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.878-.788-1.47-1.761-1.643-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
			<!-- Efek Ping Halus (Mobile Friendly) -->
			<span class="absolute inline-flex w-full h-full rounded-full bg-[#25D366] opacity-20 animate-ping z-[-1] pointer-events-none"></span>
		</a>

		<!-- AOS Script -->
		<script src="https://unpkg.com/aos@2.3.1/dist/aos.js" defer></script>
		<script>
		  document.addEventListener('DOMContentLoaded', function() {
		     setTimeout(() => {
		       // @ts-ignore
		       if (typeof window.AOS !== 'undefined') {
		         // @ts-ignore
		         window.AOS.init({
		            duration: 800,
		            once: true,
		            offset: 100,
		            easing: 'ease-out-cubic'
		         });
		       }
		     }, 300);
		  });
		</script>
		
		<!-- PWA Service Worker Registration & Dynamic Settings -->
		<script>
		  import { supabase } from '../lib/supabase.js';

		  if ('serviceWorker' in navigator) {
		    window.addEventListener('load', () => {
		      navigator.serviceWorker.register('/sw.js').catch(() => {});
		    });
		  }

		  // Dinamisasi Nomor WA
		  async function syncSettings() {
		    try {
		      const { data } = await supabase.from('pengaturan_web').select('value').eq('key', 'contact_wa').single();
		      if (data && data.value) {
		         const waBtn = document.getElementById('floatingWA');
		         if (waBtn) {
		            waBtn.setAttribute('href', `https://wa.me/${data.value.replace(/[^0-9]/g, '')}?text=Assalamualaykum%20Admin%20Nailul%20Khoir,%20saya%20ingin%20bertanya%20seputar%20informasi%20pendaftaran.`);
		         }
		      }
		    } catch (e) {}
		  }
		  syncSettings();
		</script>
	</body>
</html>
