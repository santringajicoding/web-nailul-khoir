---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import SEO from '../components/SEO.astro';
import BottomNav from '../components/BottomNav.astro';
import FloatingWA from '../components/FloatingWA.astro';

interface Props {
	title: string;
	description?: string;
	image?: string;
	type?: 'website' | 'article';
	publishDate?: string;
	author?: string;
}

const { 
	title, 
	description = "Yayasan Pondok Pesantren Nailul Khoir Majalengka. Lembaga pendidikan Islam jenjang SMPIT, SMK, dan Pondok Pesantren Salafiyah.",
	image = "/images/logo.png", // Default image for share preview
	type = "website",
	publishDate,
	author
} = Astro.props;

// Mendapatkan URL saat ini untuk Canonical Link & Open Graph URL
const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://nailulkhoir.netlify.app');
---

<!doctype html>
<html lang="id" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="theme-color" content="#064e3b" />
		
		<!-- PWA Manifest & Web App Setup -->
		<link rel="manifest" href="/manifest.json" />
		<meta name="mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
		<link rel="apple-touch-icon" href="/images/logo.png" />
		
		<!-- Komponen SEO (Meta, OpenGraph, Twitter, JSON-LD Schema) -->
		<SEO 
		  title={title} 
		  description={description} 
		  image={new URL(image, canonicalURL)} 
		  canonicalURL={canonicalURL} 
		  type={type}
		  publishDate={publishDate}
		  author={author}
		/>

		<!-- Google Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@400;500;600;700;800;900&family=Amiri:wght@400;700&family=Aref+Ruqaa:wght@400;700&display=swap" rel="stylesheet">
		
		<!-- AOS CSS -->
		<link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">

		<!-- Theme & Translation Inline Init -->
		<script is:inline>
		  // Instant Theme setup
		  const theme = localStorage.getItem('theme') || 'light';
		  if (theme === 'dark') {
		    document.documentElement.classList.add('dark');
		  } else {
		    document.documentElement.classList.remove('dark');
		  }

		  // Language Dictionary
		  window.translations = {
		    id: {
		      beranda: "BERANDA",
		      berita: "BERITA",
		      asatidz: "ASATIDZ",
		      kajian: "KAJIAN",
		      galeri: "GALERI",
		      donasi: "DONASI",
		      tentang: "TENTANG",
		      faq: "FAQ",
		      ppdb: "PPDB ONLINE",
		      welcome: "Selamat Datang Di",
		      slogan: '"Terwujudnya kader muslim yang kaya akan ilmu, tangguh dalam aqidah, dan mulia dengan akhlaqul karimah."',
		      pendidikan: "PENDIDIKAN TERPADU",
		      pendidikan_title: "Pilihan Program Belajar Formal & Informal",
		      program_pondok: "Pondok Pesantren Salafiyah",
		      program_smp: "SMP IT Nailul Khoir",
		      program_smk: "SMK Nailul Khoir",
		      informasi_publik: "INFORMASI PUBLIK",
		      kabar_terbaru: "Kabar Terbaru",
		      majelis_taklim: "Majelis Taklim Umum",
		      jadwal_kajian: "Jadwal Kajian Pesantren",
		      hubungi_kami: "Hubungi Kami",
		      alamat: "Alamat Kami",
		      kontak: "Kontak",
		      tautan: "Tautan Langsung",
		      hak_cipta: "© 2026 Yayasan Pondok Pesantren Nailul Khoir. Hak Cipta Dilindungi."
		    },
		    ar: {
		      beranda: "الرئيسية",
		      berita: "الأخبار",
		      asatidz: "الأساتذة",
		      kajian: "الدروس",
		      galeri: "المعرض",
		      donasi: "التبرعات",
		      tentang: "معلومات عنا",
		      faq: "الأسئلة الشائعة",
		      ppdb: "التسجيل المباشر",
		      welcome: "مرحباً بكم في",
		      slogan: '"نشأة جيل muslim غني بالعلوم، راسخ في العقيدة، وذو أخلاق كريمة."',
		      pendidikan: "التعليم المتكامل",
		      pendidikan_title: "خيارات برنامج الدراسة الرسمي وغير الرسمي",
		      program_pondok: "معهد السلفية الإسلامي",
		      program_smp: "مدرسة نايل الخير المتوسطة",
		      program_smk: "مدرسة نايل الخير المهنية",
		      informasi_publik: "المعلومات العامة",
		      kabar_terbaru: "آخر الأخبار",
		      majelis_taklim: "مجلس التعليم العام",
		      jadwal_kajian: "جدول الدروس بالمعهد",
		      hubungi_kami: "اتصل بنا",
		      alamat: "عنواننا",
		      kontak: "الاتصال",
		      tautan: "روابط مباشرة",
		      hak_cipta: "© ٢٠٢٦ مؤسسة معهد نيل الخير الإسلامي. جميع الحقوق محفوظة."
		    },
		    su: {
		      beranda: "BUMI",
		      berita: "WARTA",
		      asatidz: "ASATIDZ",
		      kajian: "PANGAOSAN",
		      galeri: "GALERI",
		      donasi: "DONASI",
		      tentang: "PERKAWIS",
		      faq: "FAQ",
		      ppdb: "DAPTAR ONLINE",
		      welcome: "Wilujeng Sumping Di",
		      slogan: '"Ngawujudkeun kader muslim anu beunghar ku elmu, tanggoh dina aqidah, sarta mulia ku akhlaqul karimah."',
		      pendidikan: "ATIKAN TERPADU",
		      pendidikan_title: "Pilihan Program Diajar Formal & Informal",
		      program_pondok: "Pondok Pesantren Salafiyah",
		      program_smp: "SMP IT Nailul Khoir",
		      program_smk: "SMK Nailul Khoir",
		      informasi_publik: "WARA-WARA",
		      kabar_terbaru: "Warta Panganyarna",
		      majelis_taklim: "Majelis Taklim Umum",
		      jadwal_kajian: "Jadwal Pangaosan Pesantren",
		      hubungi_kami: "Hubungi Kami",
		      alamat: "Alamat Kami",
		      kontak: "Kontak",
		      tautan: "Tautan Langsung",
		      hak_cipta: "© 2026 Yayasan Pondok Pesantren Nailul Khoir. Hak Cipta Ditangtayungan."
		    },
		    jv: {
		      beranda: "NGAREP",
		      berita: "PAWARTA",
		      asatidz: "ASATIDZ",
		      kajian: "KAJIAN",
		      galeri: "GALERI",
		      donasi: "DONASI",
		      tentang: "TENTANG",
		      faq: "FAQ",
		      ppdb: "DAFTAR ONLINE",
		      welcome: "Sugeng Rawuh Ing",
		      slogan: '"Mujudake kader muslim sing sugih ngelmu, tangguh ing aqidah, lan mulya kanthi akhlaqul karimah."',
		      pendidikan: "PENDIDIKAN TERPADU",
		      pendidikan_title: "Pilihan Program Sinau Formal & Informal",
		      program_pondok: "Pondok Pesantren Salafiyah",
		      program_smp: "SMP IT Nailul Khoir",
		      program_smk: "SMK Nailul Khoir",
		      informasi_publik: "WARA-WARA",
		      kabar_terbaru: "Pawarta Anyar",
		      majelis_taklim: "Majelis Taklim Umum",
		      jadwal_kajian: "Jadwal Kajian Pesantren",
		      hubungi_kami: "Hubungi Kami",
		      alamat: "Alamat Kami",
		      kontak: "Kontak",
		      tautan: "Tautan Langsung",
		      hak_cipta: "© 2026 Yayasan Pondok Pesantren Nailul Khoir. Hak Cipta Dilindungi."
		    }
		  };

		  // Function to apply translation
		  window.applyLanguage = function(lang) {
		    localStorage.setItem('lang', lang);
		    
		    // Handle RTL direction for Arabic
		    if (lang === 'ar') {
		      document.documentElement.dir = 'rtl';
		      document.documentElement.lang = 'ar';
		    } else {
		      document.documentElement.dir = 'ltr';
		      document.documentElement.lang = lang;
		    }

		    // Update label in dropdown
		    const label = document.getElementById('currentLangLabel');
		    if (label) label.textContent = lang.toUpperCase();

		    // Translate all elements with data-translate attribute
		    const elements = document.querySelectorAll('[data-translate]');
		    elements.forEach(el => {
		      const key = el.getAttribute('data-translate');
		      if (window.translations[lang] && window.translations[lang][key]) {
		        el.textContent = window.translations[lang][key];
		      }
		    });
		  };
		</script>
	</head>
	<body class="bg-gray-50 text-gray-800 dark:bg-slate-950 dark:text-slate-100 font-sans antialiased min-h-screen flex flex-col transition-colors duration-500">
		<Navbar />
		<main class="flex-grow pb-24 lg:pb-0">
			<slot />
		</main>
		<Footer />

		<!-- Tombol WhatsApp Melayang Premium & Bottom Navigation Bar Mobile -->
		<FloatingWA />
		<BottomNav />

		<!-- AOS Script -->
		<script src="https://unpkg.com/aos@2.3.1/dist/aos.js" defer></script>
		<script>
		  document.addEventListener('DOMContentLoaded', function() {
		     setTimeout(() => {
		       // @ts-ignore
		       if (typeof window.AOS !== 'undefined') {
		         // @ts-ignore
		         window.AOS.init({
		            duration: 800,
		            once: true,
		            offset: 100,
		            easing: 'ease-out-cubic'
		         });
		       }
		     }, 300);
		  });
		</script>
		
		<!-- PWA Service Worker Registration & Dynamic Settings -->
		<script>
		  if ('serviceWorker' in navigator) {
		    window.addEventListener('load', () => {
		      navigator.serviceWorker.register('/sw.js').catch(() => {});
		    });
		  }
		</script>
	</body>
</html>
