---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import SEO from '../components/SEO.astro';
import BottomNav from '../components/BottomNav.astro';
import FloatingWA from '../components/FloatingWA.astro';

interface Props {
	title: string;
	description?: string;
	image?: string;
	type?: 'website' | 'article';
	publishDate?: string;
	author?: string;
}

const { 
	title, 
	description = "Yayasan Pondok Pesantren Nailul Khoir Majalengka. Lembaga pendidikan Islam jenjang SMPIT, SMK, dan Pondok Pesantren Salafiyah.",
	image = "/images/logo.png", // Default image for share preview
	type = "website",
	publishDate,
	author
} = Astro.props;

// Mendapatkan URL saat ini untuk Canonical Link & Open Graph URL
const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://nailulkhoir.netlify.app');
---

<!doctype html>
<html lang="id" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="theme-color" content="#43D854" />
		
		<!-- PWA Manifest & Web App Setup -->
		<link rel="manifest" href="/manifest.json" />
		<meta name="mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
		<link rel="apple-touch-icon" href="/images/logo.png" />
		
		<!-- Komponen SEO (Meta, OpenGraph, Twitter, JSON-LD Schema) -->
		<SEO 
		  title={title} 
		  description={description} 
		  image={new URL(image, canonicalURL)} 
		  canonicalURL={canonicalURL} 
		  type={type}
		  publishDate={publishDate}
		  author={author}
		/>

		<!-- Google Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@400;500;600;700;800;900&family=Amiri:wght@400;700&family=Aref+Ruqaa:wght@400;700&display=swap" rel="stylesheet">
		
		<!-- AOS CSS -->
		<link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
	</head>
	<body class="bg-gray-50 text-gray-800 font-sans antialiased min-h-screen flex flex-col">
		<Navbar />
		<main class="flex-grow pb-24 lg:pb-0">
			<slot />
		</main>
		<Footer />

		<!-- Tombol WhatsApp Melayang Premium & Bottom Navigation Bar Mobile -->
		<FloatingWA />
		<BottomNav />

		<!-- AOS Script -->
		<script src="https://unpkg.com/aos@2.3.1/dist/aos.js" defer></script>
		<script>
		  document.addEventListener('DOMContentLoaded', function() {
		     setTimeout(() => {
		       // @ts-ignore
		       if (typeof window.AOS !== 'undefined') {
		         // @ts-ignore
		         window.AOS.init({
		            duration: 800,
		            once: true,
		            offset: 100,
		            easing: 'ease-out-cubic'
		         });
		       }
		     }, 300);
		  });
		</script>
		
		<!-- PWA Service Worker Registration & Dynamic Settings -->
		<script>
		  if ('serviceWorker' in navigator) {
		    window.addEventListener('load', () => {
		      navigator.serviceWorker.register('/sw.js').catch(() => {});
		    });
		  }
		</script>
	</body>
</html>
