---
interface Props {
  title: string;
  adminEmail?: string;
}
const { title, adminEmail } = Astro.props;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | Admin Panel YPP Nailul Khoir</title>
    <link rel="icon" type="image/png" href="/images/logo.png" />
    
    <!-- Quill.js Editor untuk Manajemen Konten -->
    <link href="https://cdn.jsdelivr.net/npm/quill@2.0.2/dist/quill.snow.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/quill@2.0.2/dist/quill.js" is:inline></script>
    <!-- Anti-Flash Auth Guard -->
    <script is:inline>
      (function() {
        if (window.location.pathname === '/admin/login') return;
        
        // Coba deteksi session dari localStorage dengan cara yang lebih stabil
        const hasSession = Object.keys(localStorage).some(key => 
          key.includes('auth-token') || key.startsWith('sb-')
        );

        if (!hasSession) {
          // Jika benar-benar tidak ada tanda token, langsung buang ke login
          window.location.replace('/admin/login');
        }
      })();
    </script>
  </head>
  <body
    class="bg-gray-100 font-sans flex text-gray-800 antialiased h-screen overflow-hidden"
  >
    <!-- Sidebar Mobile Overlay -->
    <div
      id="sidebarOverlay"
      class="fixed inset-0 bg-gray-900/50 backdrop-blur-sm z-30 hidden md:hidden transition-opacity opacity-0"
    >
    </div>

    <!-- Sidebar -->
    <aside
      id="adminSidebar"
      class="w-64 bg-gradient-to-b from-green-900 via-pesantren to-green-950 text-white flex-col flex h-full shadow-2xl z-40 fixed md:relative transform -translate-x-full md:translate-x-0 transition-transform duration-300 ease-in-out overflow-hidden shrink-0"
    >
      <!-- Ornamen Dekoratif Sidebar -->
      <div
        class="absolute top-0 right-0 -mr-8 -mt-8 w-32 h-32 rounded-full bg-white opacity-5 blur-2xl"
      >
      </div>
      <div
        class="absolute bottom-0 left-0 -ml-8 -mb-8 w-40 h-40 rounded-full bg-emas opacity-10 blur-3xl"
      >
      </div>

      <div
        class="p-6 text-center border-b border-green-800/50 flex flex-col items-center relative z-10"
      >
        <div
          class="bg-white/95 p-2 rounded-2xl shadow-xl mb-3 border border-green-800/30 transform transition-transform hover:scale-105"
        >
          <img
            src="/images/logo.png"
            alt="Logo Yayasan"
            class="h-14 w-auto object-contain"
          />
        </div>
        <h2 class="text-lg font-extrabold text-white tracking-wider font-sans">
          Nailul Khoir <span class="text-emas">Admin</span>
        </h2>
        <p
          class="text-[11px] text-green-200 mt-1 uppercase tracking-widest font-semibold opacity-80"
        >
          Sistem Informasi
        </p>
      </div>
      <nav
        class="flex-grow p-4 space-y-1.5 overflow-y-auto relative z-10"
        id="adminSidebarNav"
      >
        <div
          class="text-xs font-bold text-green-300 uppercase tracking-widest mb-3 px-4 opacity-70"
        >
          Menu Utama
        </div>
        <a
          href="/admin/dashboard"
          class="group flex items-center py-3 px-4 rounded-xl text-green-50 hover:bg-white/10 hover:text-white transition-all duration-200 border border-transparent hover:border-white/10"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-5 w-5 mr-3 opacity-70 group-hover:opacity-100 group-hover:text-emas transition-colors"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            ><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" /></svg
          >
          Ringkasan Analytics
        </a>
        <a
          href="/admin/ppdb"
          class="group flex items-center py-3 px-4 rounded-xl text-green-50 hover:bg-white/10 hover:text-white transition-all duration-200 border border-transparent hover:border-white/10"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-5 w-5 mr-3 opacity-70 group-hover:opacity-100 group-hover:text-emas transition-colors"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"
            ></path></svg
          >
          Data Pendaftar (PPDB)
        </a>
        <a
          href="/admin/berita"
          class="group flex items-center py-3 px-4 rounded-xl text-green-50 hover:bg-white/10 hover:text-white transition-all duration-200 border border-transparent hover:border-white/10"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-5 w-5 mr-3 opacity-70 group-hover:opacity-100 group-hover:text-emas transition-colors"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"
            ></path></svg
          >
          Kelola Publikasi
        </a>
        <a
          href="/admin/kajian"
          class="group flex items-center py-3 px-4 rounded-xl text-green-50 hover:bg-white/10 hover:text-white transition-all duration-200 border border-transparent hover:border-white/10"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-5 w-5 mr-3 opacity-70 group-hover:opacity-100 group-hover:text-emas transition-colors"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"
            ></path></svg
          >
          Manajemen Kajian
        </a>
        <a
          href="/admin/syaikhuna"
          class="group flex items-center py-3 px-4 rounded-xl text-green-50 hover:bg-white/10 hover:text-white transition-all duration-200 border border-transparent hover:border-white/10"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-5 w-5 mr-3 opacity-70 group-hover:opacity-100 group-hover:text-emas transition-colors"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"
            ></path></svg
          >
          Data Asatidz
        </a>
        <a
          href="/admin/galeri"
          class="group flex items-center py-3 px-4 rounded-xl text-green-50 hover:bg-white/10 hover:text-white transition-all duration-200 border border-transparent hover:border-white/10"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-5 w-5 mr-3 opacity-70 group-hover:opacity-100 group-hover:text-emas transition-colors"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"
            ></path></svg
          >
          Galeri Foto
        </a>
        <a
          href="/admin/testimoni"
          class="group flex items-center py-3 px-4 rounded-xl text-green-50 hover:bg-white/10 hover:text-white transition-all duration-200 border border-transparent hover:border-white/10"
        >
           <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-5 w-5 mr-3 opacity-70 group-hover:opacity-100 group-hover:text-emas transition-colors"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"
            ></path></svg
          >
          Testimoni Wali
        </a>
        <a
          href="/admin/donasi"
          class="group flex items-center py-3 px-4 rounded-xl text-green-50 hover:bg-white/10 hover:text-white transition-all duration-200 border border-transparent hover:border-white/10"
        >
           <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-5 w-5 mr-3 opacity-70 group-hover:opacity-100 group-hover:text-emas transition-colors"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"
            ></path></svg
          >
          Konfirmasi Donasi
        </a>
        <div
          class="text-xs font-bold text-green-300 uppercase tracking-widest mt-6 mb-3 px-4 opacity-70"
        >
          Sistem
        </div>
        <a
          href="/admin/profil"
          class="group flex items-center py-3 px-4 rounded-xl text-green-50 hover:bg-white/10 hover:text-white transition-all duration-200 border border-transparent hover:border-white/10"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-5 w-5 mr-3 opacity-70 group-hover:opacity-100 group-hover:text-emas transition-colors"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"
            ></path><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path></svg
          >
          Pengaturan Profil Web
        </a>
        <a
          href="/admin/pengaturan"
          class="group flex items-center py-3 px-4 rounded-xl text-green-50 hover:bg-white/10 hover:text-white transition-all duration-200 border border-transparent hover:border-white/10"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-5 w-5 mr-3 opacity-70 group-hover:opacity-100 group-hover:text-emas transition-colors"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"
            ></path></svg
          >
          Desain & Beranda
        </a>
      </nav>
      <!-- Script untuk menandai menu aktif -->
      <script>
        document.addEventListener("DOMContentLoaded", () => {
          const currentPath = window.location.pathname;
          const navLinks = document.querySelectorAll("#adminSidebarNav a");
          navLinks.forEach((link) => {
            if (link.getAttribute("href") === currentPath) {
              link.classList.remove(
                "text-green-50",
                "hover:bg-white/10",
                "hover:text-white",
                "border-transparent",
              );
              link.classList.add(
                "bg-white/10",
                "text-white",
                "font-bold",
                "border-white/10",
                "shadow-inner",
              );
              const icon = link.querySelector("svg");
              if (icon) icon.classList.add("text-emas", "opacity-100");
            }
          });
        });
      </script>
      <div
        class="p-6 relative z-10 bg-black/10 backdrop-blur-sm border-t border-white/10"
      >
        <button
          id="btnLogout"
          class="w-full bg-red-500/90 hover:bg-red-600 text-white py-3 px-4 rounded-xl font-bold transition-all duration-200 shadow-lg shadow-red-500/30 flex justify-center items-center gap-2 border border-red-500 hover:scale-105 active:scale-95"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-5 w-5"
            viewBox="0 0 20 20"
            fill="currentColor"
          >
            <path
              fill-rule="evenodd"
              d="M3 3a1 1 0 00-1 1v12a1 1 0 102 0V4a1 1 0 00-1-1zm10.293 9.293a1 1 0 001.414 1.414l3-3a1 1 0 000-1.414l-3-3a1 1 0 10-1.414 1.414L14.586 9H7a1 1 0 100 2h7.586l-1.293 1.293z"
              clip-rule="evenodd"></path>
          </svg>
          Log Out
        </button>
      </div>
    </aside>

    <!-- Main Content -->
    <main
      class="flex-grow flex flex-col h-full overflow-hidden relative bg-gray-50/50"
    >
      <!-- Floating Header dengan Kaca / Glassmorphism -->
      <header
        class="bg-white/80 backdrop-blur-md shadow-sm h-[72px] flex items-center justify-between px-4 sm:px-6 lg:px-8 z-20 shrink-0 border-b border-gray-200/50"
      >
        <div class="flex items-center md:hidden gap-3">
          <button
            id="btnMobileMenu"
            class="p-2 -ml-2 text-gray-500 hover:text-pesantren hover:bg-green-50 rounded-lg transition-colors focus:outline-none focus:ring-2 focus:ring-pesantren"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-6 w-6"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M4 6h16M4 12h16M4 18h16"></path></svg
            >
          </button>
          <img
            src="/images/logo.png"
            alt="Logo"
            class="h-8 w-auto hidden sm:block"
          />
          <span class="font-extrabold text-pesantren tracking-tight"
            >NK Admin</span
          >
        </div>
        <div class="hidden md:flex items-center gap-4">
          <div class="h-8 w-1.5 bg-emas rounded-full"></div>
          <h1 class="text-2xl font-black text-gray-800 tracking-tight">
            {title}
          </h1>
        </div>
        <div class="flex items-center space-x-4">
          <!-- Notification Bell -->
          <a href="/admin/pesan" class="relative p-2 text-gray-500 hover:text-pesantren hover:bg-green-50 rounded-full transition-colors focus:outline-none focus:ring-2 focus:ring-pesantren" title="Kotak Masuk Pesan">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
            </svg>
            <span id="globalNavBadge" class="hidden font-bold absolute top-0 -right-1 inline-flex items-center justify-center px-1.5 py-0.5 text-[10px] leading-none text-white transform bg-red-500 rounded-full shadow-sm animate-pulse">0</span>
          </a>

          <!-- User Profile Label -->
          <div
            class="hidden sm:flex items-center bg-green-50/80 border border-green-100 px-4 py-2 rounded-full backdrop-blur-sm shadow-inner cursor-pointer hover:bg-green-100 transition-colors"
          >
            <div class="w-2 h-2 rounded-full bg-green-500 mr-2 animate-pulse">
            </div>
            <span
              id="adminEmailDisplay"
              class="text-xs font-bold text-green-800 tracking-wide"
            >
              {adminEmail || "Loading Admin..."}
            </span>
          </div>
        </div>
      </header>

      <!-- Content Area -->
      <div
        class="flex-grow overflow-auto p-4 sm:p-6 md:p-8 bg-gray-50/50 w-full relative"
      >
        <slot />
      </div>
    </main>

    <script>
      import { supabase } from "../lib/supabase.js";

      // Validasi sesi aktif dari server & Load user email
      supabase.auth.getUser().then(({ data: { user }, error }) => {
        if (error || !user) {
          if (window.location.pathname !== '/admin/login') {
            window.sessionStorage.setItem('authError', 'Sesi Anda telah berakhir, silakan login kembali.');
            window.location.replace('/admin/login');
          }
        } else {
          const emailDisplay = document.getElementById("adminEmailDisplay");
          if (emailDisplay) emailDisplay.textContent = user.email || "Admin";
        }
      });

      // Load Unread Messages globally
      const loadGlobalUnread = async () => {
        // Only run if not on login page
        const { count, error } = await supabase
          .from('pesan_masuk')
          .select('*', { count: 'exact', head: true })
          .eq('status_baca', false);
        
        const badge = document.getElementById('globalNavBadge');
        if (badge && count !== null && count > 0) {
          badge.textContent = count.toString();
          badge.classList.remove('hidden');
        } else if (badge) {
          badge.classList.add('hidden');
        }
      };
      
      // Execute the message badge fetch globally
      loadGlobalUnread();

      // Mobile Sidebar Toggle
      const btnMobileMenu = document.getElementById("btnMobileMenu");
      const adminSidebar = document.getElementById("adminSidebar");
      const sidebarOverlay = document.getElementById("sidebarOverlay");

      const toggleSidebar = () => {
        if (adminSidebar && sidebarOverlay) {
          const isClosed = adminSidebar.classList.contains("-translate-x-full");
          if (isClosed) {
            adminSidebar.classList.remove("-translate-x-full");
            sidebarOverlay.classList.remove("hidden");
            setTimeout(() => sidebarOverlay.classList.remove("opacity-0"), 10);
          } else {
            adminSidebar.classList.add("-translate-x-full");
            sidebarOverlay.classList.add("opacity-0");
            setTimeout(() => sidebarOverlay.classList.add("hidden"), 300);
          }
        }
      };

      if (btnMobileMenu) btnMobileMenu.addEventListener("click", toggleSidebar);
      if (sidebarOverlay)
        sidebarOverlay.addEventListener("click", toggleSidebar);

      // Validasi Logout
      const btnLogout = document.getElementById("btnLogout");
      if (btnLogout) {
        btnLogout.addEventListener("click", async () => {
          await supabase.auth.signOut();
          window.location.replace("/admin/login");
        });
      }
    </script>
  </body>
</html>
