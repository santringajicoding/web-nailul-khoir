---
import MainLayout from '../../layouts/MainLayout.astro';
import CardBerita from '../../components/CardBerita.astro';
import { supabase } from '../../lib/supabase.js';

// Mengambil SEMUA berita terbaru dari tabel Supabase
const { data: beritaData, error } = await supabase
  .from('berita')
  .select('*')
  .order('tanggal_berita', { ascending: false });

const beritaList = beritaData || [];
---

<MainLayout title="Berita & Artikel Terkini">
  <!-- Hero Section Khusus Berita -->
  <div class="bg-pesantren py-20 text-white text-center mt-16 md:mt-0 relative overflow-hidden">
    <!-- Dekorasi Background -->
    <div class="absolute inset-0 z-0 opacity-10">
      <div class="absolute -top-10 -left-10 w-40 h-40 bg-emas rounded-full blur-3xl"></div>
      <div class="absolute bottom-0 right-0 w-64 h-64 bg-green-500 rounded-full blur-3xl"></div>
    </div>
    
    <div class="relative z-10 max-w-4xl mx-auto px-4" data-aos="zoom-in">
      <span class="inline-block py-1.5 px-4 rounded-full bg-emas/20 border border-emas/50 text-emas text-sm font-bold tracking-widest mb-4">
        INFORMASI & PUBLIKASI
      </span>
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-display font-black mb-6 text-white tracking-tight drop-shadow-xl">
        Berita <span class="text-emas">Pesantren</span>
      </h1>
      <p class="text-xl md:text-2xl text-green-50 font-medium max-w-2xl mx-auto drop-shadow-md leading-relaxed">
        Kumpulan liputan, artikel pendidikan, dan kabar terbaru dari seluruh kegiatan Yayasan Pondok Pesantren Nailul Khoir.
      </p>
    </div>
  </div>

  <div class="bg-gray-50 py-16 min-h-screen">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      {beritaList.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {beritaList.map((berita, i) => (
             <div class="h-full flex hover:-translate-y-2 transition-transform duration-500" data-aos="fade-up" data-aos-delay={(i % 6) * 100}>
               <CardBerita 
                 id={berita.id}
                 judul={berita.judul} 
                 foto_url={berita.foto_url} 
                 description={berita.description} 
                 tanggal={berita.tanggal_berita} 
               />
             </div>
          ))}
        </div>
      ) : (
        <div class="bg-white rounded-3xl p-16 text-center border border-gray-100 shadow-sm max-w-2xl mx-auto" data-aos="fade-in">
          <div class="w-20 h-20 bg-green-50 rounded-full flex items-center justify-center mx-auto mb-6 shadow-inner border border-green-100">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-pesantren opacity-70" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" /></svg>
          </div>
          <p class="text-gray-900 font-bold text-2xl mb-2">Belum Terdapat Liputan Berita</p>
          <p class="text-gray-500">Silakan kembali lagi nanti untuk membaca informasi serta laporan aktivitas pondok pesantren.</p>
        </div>
      )}
    </div>
  </div>
</MainLayout>
