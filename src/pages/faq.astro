---
import MainLayout from '../layouts/MainLayout.astro';

// Data Statis FAQ (Bisa dikonversi ke Supabase jika dibutuhkan nantinya)
const faqs = [
  {
    q: "Berapa rincian biaya pendaftaran dan SPP bulanan?",
    a: "Untuk biaya masuk (Uang Pangkal) sangat terjangkau, sudah termasuk fasilitas asrama dasar (kasur busa, lemari loker, dan kitab paket awal). Sedangkan untuk SPP (Syahriah) bulanan berkisar di angka Rp500.000,- (Ini sudah mencakup uang makan 3x sehari, listrik asrama, dan iuran kegiatan kepesantrenan). Harap hubungi Admin PPDB untuk rincian pastinya karena dapat menyesuaikan gelombang pendaftaran."
  },
  {
    q: "Apakah santri diperbolehkan membawa Handphone (HP) atau Laptop?",
    a: "Sesuai dengan komitmen mendidik kedisiplinan dan kefokusan belajar, santri DILARANG KERAS membawa alat elektronik genggam (HP, Tablet, dll). Untuk komunikasi dengan orang tua, pesantren menyediakan layanan Wali Akses atau Wartel Pesantren setiap akhir pekan. *Namun*, khusus untuk siswa SMK yang membutuhkan praktek kejuruan, diizinkan membawa Laptop berstiker khusus yang harus dititipkan di Laboratorium Komputer dan hanya dipakai saat jam praktik bengkel/sekolah."
  },
  {
    q: "Bagaimana sistem makan dan pencucian pakaian (Laundry) santri?",
    a: "Pesantren menyediakan dapur umum yang memasak 3 kali sehari (pagi, siang, malam) dengan asupan gizi yang dijaga keragamannya. Untuk pakaian, pesantren menyediakan jasa laundry koperasi (sistem kiloan/paket). Meskipun demikian, untuk melatih kemandirian (*riayah*), santri tetap diajarkan dan diwajibkan mencuci pakaian dalam dan kain sholat khusus secara mandiri di sumur/area basuh yang tersedia."
  },
  {
    q: "Tingkatan pendidikan formal apa saja yang ada di lingkup Yayasan?",
    a: "Yayasan Pondok Pesantren Nailul Khoir memiliki pendidikan formal tingkat menengah yaitu: SMP Islam Terpadu (SMP IT) dengan kurikulum dinas plus kepesantrenan, serta Sekolah Menengah Kejuruan (SMK) dengan fokus pada keahlian Teknologi Informasi (IT) dan Wirausaha. Semua siswa pendidikan formal DIWAJIBKAN untuk menetap di asrama (mondok)."
  },
  {
    q: "Apakah ada tes masuk baca tulis Al-Qur'an? Bagaimana jika anak belum lancar?",
    a: "Iya, terdapat tes seleksi penempatan (Placement Test) baca tulis Al-Qur'an dan pemahaman dasar agama saat pendaftaran. Namun jangan khawatir! Jika hasil tes menunjukkan ananda belum lancar, maka ananda akan dimasukkan ke Kelas Persiapan (Takhassus Iqra'/Pemula) di asrama, sehingga bimbingannya akan dimulai dari dasar (Nol) dengan penuh kesabaran."
  },
  {
    q: "Bagaimana prosedur pendaftaran bagi calon santri dari luar Kota/Provinsi?",
    a: "Sangat mudah. Anda cukup mengisi formulir secara online melalui menu 'Pendaftaran PPDB' di website ini terlebih dahulu. Setelah proses verifikasi sistem selesai, tim Panitia Penerimaan Santri Baru (PSB) kami akan memandu proses administrasi, wawancara santri/wali santri secara \*Online/Video Call\*, hingga kepastian diterima tanpa Anda harus bersusah payah datang langsung ke lokasi sebelum waktu serah terima santri."
  }
];
---

<MainLayout title="Tanya Jawab (FAQ)">
  <!-- Premium Header -->
  <section class="relative bg-gradient-to-b from-gray-950 to-green-950 pt-36 pb-20 text-white overflow-hidden text-center">
    <div class="absolute inset-0 z-0">
      <div class="absolute top-0 right-10 w-64 h-64 bg-emas rounded-full blur-[100px] opacity-20"></div>
      <div class="absolute bottom-0 left-10 w-96 h-96 bg-pesantren rounded-full blur-[120px] opacity-30"></div>
    </div>
    <div class="relative z-10 max-w-4xl mx-auto px-4" data-aos="fade-down">
      <span class="inline-block py-1.5 px-4 rounded-full bg-white/10 border border-white/20 text-emas text-sm font-bold tracking-wider mb-6 backdrop-blur-sm shadow-xl">
        PUSAT BANTUAN ORANG TUA
      </span>
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-black mb-6 tracking-tight drop-shadow-lg text-white">
        Tanya Jawab <span class="text-transparent bg-clip-text bg-gradient-to-r from-emas to-yellow-200">Seputar Pesantren</span>
      </h1>
      <p class="text-xl md:text-2xl text-green-100 font-medium max-w-2xl mx-auto drop-shadow-md leading-relaxed">
        Punya pertanyaan sebelum mendaftar? Temukan jawabannya di bawah ini terkait teknis pendaftaran, biaya, dan tata tertib.
      </p>
    </div>
  </section>

  <!-- Accordion FAQ Section -->
  <section class="py-24 bg-gray-50 relative min-h-screen">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="space-y-6" id="faq-container">
        {faqs.map((faq, index) => (
          <div 
            class="bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden hover:shadow-md transition-shadow group" 
            data-aos="fade-up" 
            data-aos-delay={index * 100}
          >
            <!-- Header Pertanyaan -->
            <button 
              class="faq-button w-full px-8 py-6 flex items-center justify-between focus:outline-none focus:bg-gray-50/50 transition-colors"
              aria-expanded="false"
              data-target={`faq-content-${index}`}
            >
              <div class="flex items-start gap-4 text-left">
                <span class="text-2xl font-black text-emas mt-0.5">Q.</span>
                <span class="text-lg md:text-xl font-bold text-gray-900 group-hover:text-pesantren transition-colors">{faq.q}</span>
              </div>
              
              <!-- Ikon Plus/Minus (Animasi CSS) -->
              <div class="w-10 h-10 rounded-full bg-green-50 flex items-center justify-center text-pesantren shrink-0 ml-4 group-hover:bg-pesantren group-hover:text-white transition-colors">
                <svg class="faq-icon w-6 h-6 transform transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                </svg>
              </div>
            </button>
            
            <!-- Body Jawaban (Hidden by default via height/opacity) -->
            <div 
              id={`faq-content-${index}`} 
              class="faq-content overflow-hidden max-h-0 transition-all duration-500 ease-in-out opacity-0"
            >
              <div class="px-8 pb-8 pt-2 flex items-start gap-4">
                <span class="text-2xl font-black text-gray-300 mt-1">A.</span>
                <div class="text-gray-600 prose prose-lg prose-green max-w-none leading-loose">
                  <!-- Render format Markdown simpel (bold italic) kalau ada, otherwise plain -->
                  {faq.a.split('\n').map(p => <p>{p}</p>)}
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- Kotak Bantuan Ekstra (Call to Action) -->
      <div class="mt-20 bg-pesantren text-white rounded-3xl p-10 md:p-14 text-center shadow-2xl relative overflow-hidden" data-aos="zoom-in" data-aos-delay="400">
        <!-- Dekorasi Batik/Glowing Circle -->
        <div class="absolute top-0 right-0 w-64 h-64 bg-green-500 rounded-full blur-[80px] opacity-20 transform translate-x-1/2 -translate-y-1/2 pointer-events-none"></div>
        
        <div class="relative z-10 max-w-2xl mx-auto">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16 mx-auto mb-6 text-emas" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" /></svg>
          <h2 class="text-3xl font-black mb-4">Masih Punya Pertanyaan Lain?</h2>
          <p class="text-green-100 text-lg mb-8 leading-relaxed">Admin Kesekretariatan & PPDB kami siap membantu menjawab segala kebimbangan Anda dengan ramah setiap hari kerja (08.00 - 16.00 WIB).</p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a href="https://wa.me/6288218336152?text=Assalamu'alaikum,%20saya%20punya%20pertanyaan%20seputar%20PPDB." target="_blank" class="bg-emas hover:bg-yellow-400 text-gray-900 font-black py-4 px-8 rounded-full shadow-lg transition-transform hover:-translate-y-1 flex items-center justify-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.878-.788-1.47-1.761-1.643-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
              Chat via WhatsApp
            </a>
            <a href="/kontak" class="bg-green-800 hover:bg-green-900 border border-green-700 text-white font-bold py-4 px-8 rounded-full shadow-lg transition-colors flex items-center justify-center gap-2">
              Kirim Pesan Email
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Script UI Accordion -->
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const buttons = document.querySelectorAll('.faq-button');
      
      buttons.forEach(button => {
        button.addEventListener('click', () => {
          const targetId = button.getAttribute('data-target');
          if (!targetId) return;

          const content = document.getElementById(targetId);
          const icon = button.querySelector('.faq-icon');
          const isExpanded = button.getAttribute('aria-expanded') === 'true';

          // Menutup semua accordion lain yang terbuka (Opsional, agar rapi)
          document.querySelectorAll('.faq-content').forEach(c => {
             if (c.id !== targetId) {
                c.style.maxHeight = '0px';
                c.style.opacity = '0';
                c.previousElementSibling?.setAttribute('aria-expanded', 'false');
                const otherIcon = c.previousElementSibling?.querySelector('.faq-icon');
                if (otherIcon) otherIcon.innerHTML = `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />`;
                if(otherIcon) otherIcon.classList.remove('rotate-90');
             }
          });

          // Toggle current accordion
          if (isExpanded) {
            button.setAttribute('aria-expanded', 'false');
            if (content) {
              content.style.maxHeight = '0px';
              content.style.opacity = '0';
            }
            // Icon Plus
            if(icon) {
              icon.classList.remove('rotate-90');
              icon.innerHTML = `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />`;
            }
          } else {
            button.setAttribute('aria-expanded', 'true');
            if (content) {
              // Set to scrollHeight untuk membiarkan CSS transition bekerja
              content.style.maxHeight = content.scrollHeight + 'px';
              content.style.opacity = '1';
            }
            // Icon Minus
            if(icon) {
              icon.classList.add('rotate-90');
              icon.innerHTML = `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 12H4" />`;
            }
          }
        });
      });
    });
  </script>
</MainLayout>
