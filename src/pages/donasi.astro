---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="Donasi & Wakaf - Yayasan PP Nailul Khoir" description="Salurkan donasi dan wakaf Anda untuk pembangunan dan operasional Pondok Pesantren Nailul Khoir Majalengka.">
  
  <section class="relative pt-32 pb-20 bg-pesantren overflow-hidden">
    <div class="absolute inset-0 opacity-10">
      <div class="absolute top-0 right-0 w-96 h-96 bg-white rounded-full blur-3xl translate-x-1/2 -translate-y-1/2"></div>
      <div class="absolute bottom-0 left-0 w-96 h-96 bg-emas rounded-full blur-3xl -translate-x-1/2 translate-y-1/2"></div>
    </div>
    
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
      <h1 class="text-4xl md:text-6xl font-display font-black text-white mb-6" data-aos="fade-down">
        Layanan <span class="text-emas">Donasi</span>
      </h1>
      <p class="text-xl text-green-100 max-w-2xl mx-auto leading-relaxed" data-aos="fade-up" data-aos-delay="100">
        Investasi Akhirat Melalui Pembangunan Fasilitas Belajar Santri Penghafal Al-Qur'an.
      </p>
    </div>
  </section>

  <section class="py-20 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">
        
        <!-- Info Rekening -->
        <div data-aos="fade-right">
          <h2 class="text-3xl font-display font-bold text-gray-900 mb-8 border-l-8 border-emas pl-4">Metode Pembayaran</h2>
          <p class="text-gray-600 mb-10 text-lg leading-relaxed">Anda dapat menyalurkan donasi, zakat, infaq, atau wakaf melalui rekening resmi Yayasan Pondok Pesantren Nailul Khoir berikut:</p>
          
          <div class="space-y-6">
            <!-- Bank BSI -->
            <div class="bg-white p-8 rounded-3xl shadow-lg border border-gray-100 hover:shadow-2xl transition-all group">
              <div class="flex items-center justify-between mb-6">
                <img src="https://upload.wikimedia.org/wikipedia/commons/a/a0/Bank_Syariah_Indonesia_logo.svg" alt="BSI Logo" class="h-10" />
                <span class="text-[10px] font-bold text-gray-400 tracking-widest uppercase bg-gray-50 px-3 py-1 rounded-full">Primary</span>
              </div>
              <p class="text-sm font-bold text-gray-400 mb-1 uppercase tracking-wide">Nomor Rekening</p>
              <div class="flex items-center justify-between">
                <h3 id="rectBsi" class="text-2xl md:text-3xl font-black text-pesantren tracking-tight">7177-3307-26</h3>
                <button onclick="copyToClipboard('7177330726', 'bsiBtn')" id="bsiBtn" class="bg-green-50 text-pesantren hover:bg-pesantren hover:text-white p-2 rounded-xl transition-all shadow-sm">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7v8a2 2 0 002 2h6M8 7V5a2 2 0 012-2h4.586a1 1 0 01.707.293l4.414 4.414a1 1 0 01.293.707V7M8 7H6a2 2 0 00-2 2v10a2 2 0 002 2h4a2 2 0 002-2v-4" /></svg>
                </button>
              </div>
              <p class="text-gray-600 mt-4 font-bold border-t border-gray-50 pt-4 flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-emas" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" /></svg>
                a.n Yayasan Nailul Khoir
              </p>
            </div>

            <!-- Pesan Pendukung -->
            <div class="bg-emas/10 p-8 rounded-3xl border border-emas/20">
              <h4 class="font-bold text-pesantren mb-4 flex items-center gap-2 text-xl">
                 <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                 Penting!
              </h4>
              <p class="text-gray-700 leading-relaxed italic">"Perumpamaan orang yang menafkahkan hartanya di jalan Allah adalah serupa dengan sebutir benih yang menumbuhkan tujuh bulir, pada setiap bulir seratus biji. Allah melipat gandakan bagi siapa yang Dia kehendaki." (QS. Al-Baqarah: 261)</p>
            </div>
          </div>
        </div>

        <!-- Form Konfirmasi -->
        <div class="bg-white p-8 md:p-12 rounded-[2.5rem] shadow-2xl border border-gray-100" data-aos="fade-left">
           <h2 class="text-3xl font-display font-bold text-gray-900 mb-6">Konfirmasi Donasi</h2>
           <p class="text-gray-500 mb-8">Mohon lengkapi formulir di bawah ini agar kami dapat memproses dan memverifikasi donasi Anda dengan cepat.</p>
           
           <div id="alertBox" class="hidden mb-6 p-4 rounded-2xl font-bold text-sm"></div>

           <form id="formDonasi" class="space-y-6">
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                 <div>
                    <label class="block text-sm font-bold text-gray-700 mb-2">Nama Donatur <span class="text-red-500">*</span></label>
                    <input type="text" id="nama" name="nama" required class="w-full px-5 py-3.5 bg-gray-50 border border-gray-200 rounded-2xl focus:bg-white focus:ring-4 focus:ring-pesantren/10 focus:border-pesantren outline-none transition-all" placeholder="Hamba Allah">
                 </div>
                 <div>
                    <label class="block text-sm font-bold text-gray-700 mb-2">No. WhatsApp <span class="text-red-500">*</span></label>
                    <input type="text" id="kontak" name="kontak" required class="w-full px-5 py-3.5 bg-gray-50 border border-gray-200 rounded-2xl focus:bg-white focus:ring-4 focus:ring-pesantren/10 focus:border-pesantren outline-none transition-all" placeholder="0812...">
                 </div>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                 <div>
                    <label class="block text-sm font-bold text-gray-700 mb-2">Jumlah Donasi (Rp) <span class="text-red-500">*</span></label>
                    <input type="number" id="jumlah" name="jumlah" required class="w-full px-5 py-3.5 bg-gray-50 border border-gray-200 rounded-2xl focus:bg-white focus:ring-4 focus:ring-pesantren/10 focus:border-pesantren outline-none transition-all" placeholder="50000">
                 </div>
                 <div>
                    <label class="block text-sm font-bold text-gray-700 mb-2">Metode <span class="text-red-500">*</span></label>
                    <select id="metode" name="metode" required class="w-full px-5 py-3.5 bg-gray-50 border border-gray-200 rounded-2xl focus:bg-white focus:ring-4 focus:ring-pesantren/10 focus:border-pesantren outline-none transition-all cursor-pointer">
                       <option value="Transfer Bank BSI">Transfer Bank BSI</option>
                       <option value="Transfer Bank Lain">Bank Lain</option>
                       <option value="Tunai / Cash">Tunai / Langsung</option>
                    </select>
                 </div>
              </div>

              <div>
                <label class="block text-sm font-bold text-gray-700 mb-2">Bukti Transfer (E-Receipt)</label>
                <div class="relative group">
                   <input type="file" id="bukti" name="bukti" accept="image/*" class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-2xl text-sm file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-xs file:font-black file:bg-pesantren file:text-white hover:file:bg-green-800 cursor-pointer">
                </div>
              </div>

              <button type="submit" id="btnSubmit" class="w-full bg-pesantren hover:bg-green-800 text-white font-black py-5 rounded-2xl shadow-xl hover:shadow-2xl transition-all transform hover:-translate-y-1 mt-4">
                 KIRIM KONFIRMASI
              </button>
           </form>
        </div>

      </div>
    </div>
  </section>

  <script>
    import { supabase } from '../lib/supabase.js';
    
    declare global {
      interface Window {
        copyToClipboard: (text: string, btnId: string) => void;
      }
    }

    // Global copy function for script is:inline alternative
    window.copyToClipboard = (text, btnId) => {
       navigator.clipboard.writeText(text).then(() => {
          const btn = document.getElementById(btnId);
          if(btn) btn.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>';
          setTimeout(() => { if(btn) btn.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7v8a2 2 0 002 2h6M8 7V5a2 2 0 012-2h4.586a1 1 0 01.707.293l4.414 4.414a1 1 0 01.293.707V7M8 7H6a2 2 0 00-2 2v10a2 2 0 002 2h4a2 2 0 002-2v-4" /></svg>'; }, 2000);
       });
    };

    const form = document.getElementById('formDonasi') as HTMLFormElement;
    if (form) {
       form.addEventListener('submit', async (e) => {
          e.preventDefault();
          const btn = document.getElementById('btnSubmit') as HTMLButtonElement;
          const alertBox = document.getElementById('alertBox');
          const fileInput = document.getElementById('bukti') as HTMLInputElement;

          // Elements data
          const nama = (document.getElementById('nama') as HTMLInputElement).value.trim();
          const kontak = (document.getElementById('kontak') as HTMLInputElement).value.trim();
          const jumlah = Number((document.getElementById('jumlah') as HTMLInputElement).value);
          const metode = (document.getElementById('metode') as HTMLSelectElement).value;

          const showError = (msg: string) => {
             if(alertBox) {
                alertBox.className = 'mb-6 p-4 rounded-2xl font-bold text-sm bg-red-50 border border-red-200 text-red-800';
                alertBox.innerHTML = `<strong>Gagal Mengirim:</strong><br>${msg}`;
                alertBox.classList.remove('hidden');
                alertBox.scrollIntoView({ behavior: 'smooth', block: 'center' });
             }
             btn.disabled = false;
             btn.textContent = 'KONFIRMASI SEKARANG';
          };

          // Validasi UX
          if (nama.length < 3) return showError('Nama donatur terlalu pendek.');
          if (jumlah < 1000) return showError('Jumlah donasi minimal adalah Rp 1.000.');
          if (!/^(08|628|\+628)[0-9]{7,13}$/.test(kontak)) return showError('Format No. HP tidak valid (Wajib No. WhatsApp aktif).');

          btn.disabled = true;
          btn.innerHTML = `
            <svg class="animate-spin h-5 w-5 mr-3 text-white inline ml-2" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg> Memproses...`;
          
          let publicUrl: string | null = null;

          try {
             // 1. Upload Bukti jika ada
             if (fileInput.files && fileInput.files.length > 0) {
                btn.innerHTML = 'Mengunggah Bukti...';
                const file = fileInput.files[0];
                const fileExt = file.name.split('.').pop();
                const fileName = `donasi/${Date.now()}-${Math.random().toString(36).substring(2)}.${fileExt}`;

                const { error: uploadErr } = await supabase.storage.from('berita_images').upload(fileName, file);
                
                if (uploadErr) {
                   console.error('Storage Error:', uploadErr);
                   alert(`Gagal Upload Gambar: ${uploadErr.message}`);
                   throw new Error('Gagal mengunggah foto bukti. Pastikan file adalah gambar dan ukuran di bawah 2MB.');
                }

                const { data: publicData } = supabase.storage.from('berita_images').getPublicUrl(fileName);
                publicUrl = publicData.publicUrl;
             }

             btn.innerHTML = 'Menyimpan Konfirmasi...';

             // 2. Insert Database
             const payload = {
                nama_donatur: nama,
                kontak: kontak,
                jumlah: jumlah,
                metode: metode,
                bukti_url: publicUrl,
                status: 'Tertunda'
             };

             const { error: dbError } = await supabase.from('donasi').insert([payload]);

             if (dbError) {
                console.error('Database Error:', dbError);
                alert(`Gagal Simpan Data: ${dbError.message}\nDetail: ${dbError.details || '-'}\nHint: ${dbError.hint || '-'}`);
                throw dbError;
             }

             // Sukses
             form.reset();
             if(alertBox) {
                alertBox.className = 'mb-6 p-6 rounded-2xl font-bold bg-green-100 border border-green-200 text-green-900 text-center shadow-md animate-pulse';
                alertBox.innerHTML = `
                   <div class="mb-2 text-2xl">✨ Alhamdulillah, Jazakumullah!</div>
                   <div class="text-sm font-medium">Donasi dari <strong>${nama}</strong> telah kami terima. Admin akan memverifikasi bukti transfer Anda segera.</div>
                `;
                alertBox.classList.remove('hidden');
                alertBox.scrollIntoView({ behavior: 'smooth', block: 'center' });
             }

          } catch (err: any) {
             showError(err.message || 'Terjadi kesalahan sistem.');
          } finally {
             btn.innerHTML = 'KIRIM KONFIRMASI';
             btn.disabled = false;
          }
       });
    }
  </script>
</MainLayout>
