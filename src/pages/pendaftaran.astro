---
import MainLayout from '../layouts/MainLayout.astro';
import { supabase } from '../lib/supabase.js';

// Ambil brosur pdf url dari database
let brosurUrl = '/brosur-ppdb.pdf';
try {
  const { data } = await supabase
    .from('pengaturan_web')
    .select('value')
    .eq('key', 'brosur_pdf_url')
    .single();
  if (data && data.value) {
    brosurUrl = data.value;
  }
} catch (err) {
  console.error("Gagal mengambil brosur url:", err);
}
---

<MainLayout 
  title="Pendaftaran Santri Baru (PPDB)" 
  description="Daftar online sekarang untuk Penerimaan Santri Baru (PPDB) Yayasan Nailul Khoir jenjang SMPIT, SMK IT, dan Pondok Pesantren Salafiyah.">
  <!-- Premium Hero -->
  <div class="relative bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-green-800 via-pesantren to-[#052e1f] py-20 md:py-24 overflow-hidden">
    <div class="absolute inset-0 bg-[url('https://www.transparenttextures.com/patterns/arabesque.png')] opacity-10 mix-blend-overlay"></div>
    <div class="absolute inset-0 bg-gradient-to-b from-transparent to-[#f8fafc]"></div>
    
    <div class="max-w-4xl mx-auto px-4 relative z-10 text-center" data-aos="zoom-in" data-aos-duration="1000">
      <div class="w-24 h-24 bg-white/10 backdrop-blur-md rounded-full flex items-center justify-center mx-auto mb-6 shadow-xl p-2 border border-emas/50 hover:scale-110 transition-transform">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-emas drop-shadow-md" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" /></svg>
      </div>
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-display font-black mb-4 text-transparent bg-clip-text bg-gradient-to-r from-yellow-300 via-emas to-yellow-500 drop-shadow-md tracking-tight">Penerimaan Santri Baru</h1>
      <p class="text-xl text-green-50 font-light max-w-2xl mx-auto drop-shadow-md">Buka gerbang masa depan yang cerah berlandaskan ilmu agama dan IPTEK. Isi formulir pendaftaran PPDB online kami di bawah ini.</p>
    </div>
  </div>

  <div class="max-w-6xl mx-auto px-4 pb-24 -mt-12 md:-mt-16 relative z-20">
    <div class="bg-white rounded-[2rem] shadow-[0_20px_60px_rgba(0,0,0,0.06)] border border-gray-100 overflow-hidden flex flex-col lg:flex-row" data-aos="fade-up">
      
      <!-- Informasi PPDB (Sisi Kiri) -->
      <div class="lg:w-2/5 bg-gradient-to-br from-[#0c2e1f] to-pesantren p-10 md:p-14 text-white relative overflow-hidden flex flex-col justify-between hidden lg:flex">
        <div class="absolute -top-32 -left-32 w-96 h-96 bg-green-500/20 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute bottom-10 -right-10 w-64 h-64 bg-emas/10 rounded-full blur-3xl pointer-events-none"></div>
        
        <div class="relative z-10">
          <h2 class="text-3xl font-display font-bold mb-6 text-emas drop-shadow-sm">Informasi PPDB</h2>
          <p class="text-green-50/80 font-light leading-relaxed mb-10 text-lg">
            Mohon isi seluruh data pokok calon santri dengan valid. Proses seleksi administrasi awal merujuk pada keabsahan data saat mengisi form ini.
          </p>
          
          <div class="space-y-6">
            <div class="flex items-start gap-4 p-4 rounded-2xl bg-white/5 border border-white/10 backdrop-blur-sm">
               <div class="bg-emas/20 p-3 rounded-full text-emas mt-1">
                 <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
               </div>
               <div>
                  <h4 class="font-bold text-white text-lg">Proses Kilat</h4>
                  <p class="text-green-100/70 text-sm mt-1">Admin kami akan merespon selambat-lambatnya 1x24 jam melalui WhatsApp setelah pendaftaran terikirim.</p>
               </div>
            </div>
            
            <div class="flex items-start gap-4 p-4 rounded-2xl bg-white/5 border border-white/10 backdrop-blur-sm">
               <div class="bg-emas/20 p-3 rounded-full text-emas mt-1">
                 <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>
               </div>
               <div>
                  <h4 class="font-bold text-white text-lg">Keamanan Data</h4>
                  <p class="text-green-100/70 text-sm mt-1">Kami berkomitmen menjaga 100% kerahasiaan data wali santri pada database terenkripsi.</p>
               </div>
            </div>
            
            <div class="flex items-start gap-4 p-4 rounded-2xl bg-white/5 border border-white/10 backdrop-blur-sm relative">
               <div class="bg-emas/20 p-3 rounded-full text-emas mt-1">
                 <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8h2a2 2 0 012 2v6a2 2 0 01-2 2h-2v4l-4-4H9a1.994-.586m0 0L11 14h4a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2v4l.586-.586z" /></svg>
               </div>
               <div>
                  <h4 class="font-bold text-white text-lg">Pusat Bantuan</h4>
                  <p class="text-green-100/70 text-sm mt-1">Jika ada kesulitan saat mengisi, chat kami (Hari kerja: 08:00 - 15:00 WIB).</p>
               </div>
               <a href="https://wa.me/6285794405083" target="_blank" class="absolute inset-0 z-20" title="Bantuan Chat WA"></a>
            </div>

            <!-- Unduh Brosur PDF -->
            <div class="mt-8 pt-6 border-t border-white/10 text-center">
              <p class="text-xs text-green-200/50 mb-3 uppercase tracking-widest font-bold">Butuh Informasi Lengkap?</p>
              <a href={brosurUrl} download class="inline-flex items-center justify-center gap-3 w-full py-4 px-6 bg-gradient-to-r from-yellow-500 to-emas text-[#064e3b] font-black rounded-2xl active:scale-95 transition-all shadow-lg hover:shadow-emas/20 hover:scale-[1.01]">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" /></svg>
                UNDUH BROSUR PPDB (PDF)
              </a>
            </div>

          </div>
        </div>
      </div>

      <!-- Form (Sisi Kanan) -->
      <div class="lg:w-3/5 p-5 sm:p-8 md:p-14 bg-white relative">
        <h2 class="text-3xl font-display font-bold text-gray-800 mb-2 lg:hidden">Form Pendaftaran</h2>
        <p class="text-gray-500 mb-8 border-b-2 border-green-500/10 pb-4">Lengkapi isian di bawah ini dengan benar tanpa ada kolom <span class="text-red-500">*</span> yang tertinggal.</p>
        
        <!-- Notifikasi -->
        <div id="alertPendaftaran" class="hidden mb-6 p-5 rounded-2xl font-medium flex items-start gap-3 border shadow-sm transition-all duration-300 transform">
           <div id="alertIcon" class="mt-0.5"></div>
           <div id="alertMessage" class="flex-1"></div>
        </div>

        <form id="formPendaftaran" class="space-y-6">
          <!-- Form Group: Jalur -->
          <div class="space-y-1">
            <label for="jalur" class="block text-sm font-bold text-gray-700">Pilih Program Pendidikan <span class="text-red-500">*</span></label>
            <div class="relative group">
              <div class="absolute inset-y-0 left-0 flex items-center pl-4 pointer-events-none text-gray-400 group-focus-within:text-pesantren transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" /></svg>
              </div>
              <select id="jalur" name="jalur" required 
                class="block w-full pl-11 pr-4 py-3.5 bg-gray-50 border border-gray-200 rounded-xl focus:bg-white focus:ring-4 focus:ring-green-500/10 focus:border-pesantren outline-none transition-all duration-300 appearance-none text-gray-700 font-medium">
                <option value="" disabled selected>-- Pilih Jenjang / Program --</option>
                <option value="SMPIT">SMPIT Nailul Khoir</option>
                <option value="SMK">SMK Nailul Khoir</option>
                                <option value="Pondok Pesantren">Pondok Pesantren (Salafiyah)</option>
              </select>
              <div class="absolute inset-y-0 right-0 flex items-center pr-4 pointer-events-none text-gray-400">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M19 9l-7 7-7-7" /></svg>
              </div>
            </div>
          </div>

          <!-- Form Group: Nama Santri -->
          <div class="space-y-1">
            <label for="nama_santri" class="block text-sm font-bold text-gray-700">Nama Lengkap Santri <span class="text-red-500">*</span></label>
            <div class="relative group">
              <div class="absolute inset-y-0 left-0 flex items-center pl-4 pointer-events-none text-gray-400 group-focus-within:text-pesantren transition-colors">
                 <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" /></svg>
              </div>
              <input type="text" id="nama_santri" name="nama_santri" required 
                class="block w-full pl-11 pr-4 py-3.5 bg-gray-50 border border-gray-200 rounded-xl focus:bg-white focus:ring-4 focus:ring-green-500/10 focus:border-pesantren outline-none transition-all duration-300 text-gray-700 placeholder-gray-400"
                placeholder="Ex. Ahmad Abdullah">
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <!-- Nama Wali -->
            <div class="space-y-1">
              <label for="nama_wali" class="block text-sm font-bold text-gray-700">Nama Wali (Ayah/Ibu) <span class="text-red-500">*</span></label>
              <div class="relative group">
                <div class="absolute inset-y-0 left-0 flex items-center pl-4 pointer-events-none text-gray-400 group-focus-within:text-pesantren transition-colors">
                   <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" /></svg>
                </div>
                <input type="text" id="nama_wali" name="nama_wali" required 
                  class="block w-full pl-11 pr-4 py-3.5 bg-gray-50 border border-gray-200 rounded-xl focus:bg-white focus:ring-4 focus:ring-green-500/10 focus:border-pesantren outline-none transition-all duration-300 text-gray-700 placeholder-gray-400"
                  placeholder="Ex. Budi Santoso">
              </div>
            </div>

            <!-- No WA -->
            <div class="space-y-1">
              <label for="no_hp" class="block text-sm font-bold text-gray-700">No. WhatsApp <span class="text-red-500">*</span></label>
              <div class="relative group">
                <div class="absolute inset-y-0 left-0 flex items-center pl-4 pointer-events-none text-gray-400 group-focus-within:text-pesantren transition-colors">
                   <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
                </div>
                <input type="tel" id="no_hp" name="no_hp" required 
                  class="block w-full pl-11 pr-4 py-3.5 bg-gray-50 border border-gray-200 rounded-xl focus:bg-white focus:ring-4 focus:ring-green-500/10 focus:border-pesantren outline-none transition-all duration-300 text-gray-700 placeholder-gray-400"
                  placeholder="0812xxxxxxxx">
              </div>
            </div>
          </div>

          <!-- Form Group: Alamat -->
          <div class="space-y-1">
            <label for="alamat" class="block text-sm font-bold text-gray-700">Alamat Tempat Tinggal (KK) <span class="text-red-500">*</span></label>
            <div class="relative group">
              <div class="absolute top-4 left-0 flex items-start pl-4 pointer-events-none text-gray-400 group-focus-within:text-pesantren transition-colors">
                 <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
              </div>
              <textarea id="alamat" name="alamat" rows="4" required 
                class="block w-full pl-11 pr-4 py-4 bg-gray-50 border border-gray-200 rounded-xl focus:bg-white focus:ring-4 focus:ring-green-500/10 focus:border-pesantren outline-none transition-all duration-300 text-gray-700 placeholder-gray-400 resize-none leading-relaxed"
                placeholder="Sebutkan Blok/Jalan, RT/RW, Desa, Kecamatan, dan Kabupaten..."></textarea>
            </div>
          </div>

          <!-- Honeypot (Tersembunyi) untuk mencegah BOT -->
          <div class="hidden" aria-hidden="true">
            <input type="text" id="websiteHoneypot" name="website_url" tabindex="-1" autocomplete="off">
          </div>

          <!-- Submit Button -->
          <div class="pt-4 border-t border-gray-100">
            <button type="submit" id="btnSubmitForm" 
              class="w-full bg-gradient-to-r from-pesantren to-green-700 text-white font-bold py-4 px-8 rounded-xl shadow-[0_10px_20px_rgba(4,51,34,0.15)] hover:shadow-[0_15px_30px_rgba(4,51,34,0.25)] transition-all duration-300 hover:-translate-y-1 flex justify-center items-center gap-3 overflow-hidden relative group">
              <!-- Efek kilau -->
              <span class="absolute inset-0 bg-gradient-to-r from-transparent via-white/20 to-transparent -translate-x-full group-hover:animate-[shimmer_1s_infinite]"></span>
              
              <svg id="btnIcon" xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 relative z-10 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 5l7 7-7 7M5 5l7 7-7 7" /></svg>
              
              <span id="btnTextForm" class="text-lg relative z-10 tracking-wide uppercase">Kirimkan Biodata</span>
              
              <!-- Indikator Loading Spinner (Default Hidden) -->
              <svg id="btnSpinnerForm" class="animate-spin h-6 w-6 text-white hidden relative z-10" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
              </svg>
            </button>
            <p class="text-xs text-center text-gray-400 mt-4"><svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 inline-block mr-1 -mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" /></svg> Data dikirim dengan enkripsi end-to-end ke server aman kami.</p>
          </div>
        </form>

      </div>
    </div>
  </div>

  <script>
    import { supabase } from '../lib/supabase.js';

    document.addEventListener('DOMContentLoaded', () => {
      // Setup URL Params detection / Auto Select
      const urlParams = new URLSearchParams(window.location.search);
      const paramJalur = urlParams.get('jalur');
      const selectJalur = document.getElementById('jalur') as HTMLSelectElement;

      // Map params string ke nilai di option
      const paramMap: {[key: string]: string} = {
        'SMPIT': 'SMPIT',
        'SMK': 'SMK',
        'PondokPesantren': 'Pondok Pesantren',
        'Pondok Pesantren': 'Pondok Pesantren' // Handle URL decode spaces
      };

      if (selectJalur && paramJalur && paramMap[paramJalur]) {
        selectJalur.value = paramMap[paramJalur];
      }

      // Logic submit ke Supabase
      const form = document.getElementById('formPendaftaran') as HTMLFormElement;
      const noHpInput = document.getElementById('no_hp') as HTMLInputElement;
      const namaSantriInput = document.getElementById('nama_santri') as HTMLInputElement;
      const namaWaliInput = document.getElementById('nama_wali') as HTMLInputElement;
      const alamatInput = document.getElementById('alamat') as HTMLTextAreaElement;
      const selectJalurEl = document.getElementById('jalur') as HTMLSelectElement;

      // Helper function to show/hide validation borders
      const validateField = (input: HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement, isValid: boolean) => {
         if (isValid) {
            input.classList.remove('border-gray-200', 'border-red-500', 'focus:border-pesantren');
            input.classList.add('border-green-500', 'focus:border-green-500');
         } else {
            input.classList.remove('border-gray-200', 'border-green-500', 'focus:border-pesantren');
            input.classList.add('border-red-500', 'focus:border-red-500');
         }
      };

      const validateNamaSantri = () => {
         const val = namaSantriInput.value.trim();
         const ok = val.length >= 3 && /^[a-zA-Z\s]+$/.test(val);
         validateField(namaSantriInput, ok);
         return ok;
      };

      const validateNamaWali = () => {
         const val = namaWaliInput.value.trim();
         const ok = val.length >= 3 && /^[a-zA-Z\s]+$/.test(val);
         validateField(namaWaliInput, ok);
         return ok;
      };

      const validateNoHp = () => {
         const val = noHpInput.value.trim();
         const ok = /^(08|628|\+628)[0-9]{7,13}$/.test(val);
         validateField(noHpInput, ok);
         return ok;
      };

      const validateAlamat = () => {
         const val = alamatInput.value.trim();
         const ok = val.length >= 15;
         validateField(alamatInput, ok);
         return ok;
      };

      const validateJalur = () => {
         const val = selectJalurEl.value;
         const ok = val !== "";
         validateField(selectJalurEl, ok);
         return ok;
      };

      // Register Blur/Input Listeners
      namaSantriInput?.addEventListener('blur', validateNamaSantri);
      namaSantriInput?.addEventListener('input', () => {
         if (namaSantriInput.classList.contains('border-green-500') || namaSantriInput.classList.contains('border-red-500')) {
            validateNamaSantri();
         }
      });

      namaWaliInput?.addEventListener('blur', validateNamaWali);
      namaWaliInput?.addEventListener('input', () => {
         if (namaWaliInput.classList.contains('border-green-500') || namaWaliInput.classList.contains('border-red-500')) {
            validateNamaWali();
         }
      });

      noHpInput?.addEventListener('blur', validateNoHp);
      noHpInput?.addEventListener('input', () => {
         noHpInput.value = noHpInput.value.replace(/[^0-9]/g, '');
         if (noHpInput.classList.contains('border-green-500') || noHpInput.classList.contains('border-red-500')) {
            validateNoHp();
         }
      });

      alamatInput?.addEventListener('blur', validateAlamat);
      alamatInput?.addEventListener('input', () => {
         if (alamatInput.classList.contains('border-green-500') || alamatInput.classList.contains('border-red-500')) {
            validateAlamat();
         }
      });

      selectJalurEl?.addEventListener('change', validateJalur);

      // Helper to clear validation borders
      const clearValidationBorders = () => {
         const fields = [namaSantriInput, namaWaliInput, noHpInput, alamatInput, selectJalurEl];
         fields.forEach(f => {
            if (f) {
               f.classList.remove('border-green-500', 'border-red-500', 'focus:border-green-500', 'focus:border-red-500');
               f.classList.add('border-gray-200', 'focus:border-pesantren');
            }
         });
      };
      
      form?.addEventListener('submit', async (e) => {
        e.preventDefault();
        
        // Element handlers
        const btnSubmit = document.getElementById('btnSubmitForm') as HTMLButtonElement;
        const btnText = document.getElementById('btnTextForm');
        const btnIcon = document.getElementById('btnIcon');
        const btnSpinner = document.getElementById('btnSpinnerForm');
        
        const alertWrapper = document.getElementById('alertPendaftaran');
        const alertMsg = document.getElementById('alertMessage');
        const alertIcon = document.getElementById('alertIcon');
        
        // Helper UI Error Validation
        const showError = (msg: string) => {
            if (alertWrapper && alertMsg && alertIcon) {
                alertWrapper.className = 'mb-6 p-5 rounded-2xl font-medium flex items-start gap-3 border shadow-sm transition-all duration-300 transform bg-red-50 border-red-200 text-red-800';
                alertIcon.innerHTML = `<svg class="w-6 h-6 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>`;
                alertMsg.innerHTML = `<strong>Data Belum Sesuai!</strong><br><span class="text-sm">${msg}</span>`;
                alertWrapper.classList.remove('hidden');
                alertWrapper.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }
            if (btnSubmit) {
               btnSubmit.disabled = false;
               btnSubmit.classList.remove('opacity-70', 'cursor-not-allowed', 'scale-[0.98]');
            }
            if(btnText) btnText.textContent = 'Kirimkan Biodata';
            if(btnSpinner) btnSpinner.classList.add('hidden');
            if(btnIcon) btnIcon.classList.remove('hidden');
        };
        
        // Honeypot trap check
        const honeypot = (document.getElementById('websiteHoneypot') as HTMLInputElement)?.value;
        if (honeypot) {
            console.warn('Bot blocked!');
            return;
        }

        // Data collection
        const formData = new FormData(form);
        const dataPayload = {
            nama_santri: formData.get('nama_santri')?.toString().trim() || '',
            nama_wali: formData.get('nama_wali')?.toString().trim() || '',
            no_hp: formData.get('no_hp')?.toString().trim() || '',
            alamat: formData.get('alamat')?.toString().trim() || '',
            jalur: formData.get('jalur')?.toString() || '',
            status: 'Tertunda' // Default status verifikasi
        };

        // Trigger all validation visuals
        const jOk = validateJalur();
        const sOk = validateNamaSantri();
        const wOk = validateNamaWali();
        const hOk = validateNoHp();
        const aOk = validateAlamat();
        
        if (!jOk) return showError('Mohon pilih program pendidikan yang diinginkan.');
        if (!sOk) return showError('Nama santri minimal 3 huruf dan hanya boleh berisi huruf/spasi.');
        if (!wOk) return showError('Nama wali/orang tua minimal 3 huruf dan hanya boleh berisi huruf/spasi.');
        if (!hOk) return showError('Nomor WhatsApp harus valid (Diawali 08/628/+, min 9 digit).');
        if (!aOk) return showError('Detail alamat harus lengkap (minimal 15 karakter) agar panitia mudah melakukan verifikasi lokasi.');

        // Start Loading State (Tutup alert yang ada)
        if (alertWrapper) { alertWrapper.classList.add('hidden'); }
        if (btnSubmit) { btnSubmit.disabled = true; btnSubmit.classList.add('opacity-70', 'cursor-not-allowed', 'scale-[0.98]'); }
        if (btnText) { btnText.textContent = 'Menyimpan...'; }
        if (btnIcon) { btnIcon.classList.add('hidden'); }
        if (btnSpinner) { btnSpinner.classList.remove('hidden'); }

        try {
            // Memasukkan data ke tabel Supabase "pendaftaran"
            const { error } = await supabase
                .from('pendaftaran')
                .insert([dataPayload]);
                
            if (error) throw error;
            
            // Tampilkan Alert SUKSES
            if (alertWrapper && alertMsg && alertIcon) {
                alertWrapper.className = 'mb-6 p-6 rounded-2xl font-medium flex items-start gap-4 border shadow-md transition-all duration-300 transform bg-green-50 border-green-200 text-green-900';
                alertIcon.innerHTML = `<div class="bg-green-100 p-2 rounded-full"><svg class="w-8 h-8 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg></div>`;
                alertMsg.innerHTML = `
                   <div class="text-lg font-black mb-1">Pendaftaran Berhasil Terkirim!</div>
                   <div class="text-sm leading-relaxed">
                      Alhamdulillah, biodata ananda <strong>${dataPayload.nama_santri}</strong> telah tersimpan aman. 
                      Kami akan memverifikasi data Bapak/Ibu <strong>${dataPayload.nama_wali}</strong> dan menghubungi via WhatsApp dalam waktu dekat. 
                      Simpan halaman ini atau catat sebagai bukti pendaftaran.
                   </div>
                `;
                alertWrapper.classList.remove('hidden');
                alertWrapper.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }
            
            form.reset();
            clearValidationBorders();
            
        } catch (error: any) {
            showError(error.message);
        } finally {
            // End Loading State
            if (btnSubmit) { btnSubmit.disabled = false; btnSubmit.classList.remove('opacity-70', 'cursor-not-allowed', 'scale-[0.98]'); }
            if (btnText) { btnText.textContent = 'Kirimkan Biodata'; }
            if (btnIcon) { btnIcon.classList.remove('hidden'); }
            if (btnSpinner) { btnSpinner.classList.add('hidden'); }
        }
      });
    });
  </script>
</MainLayout>
