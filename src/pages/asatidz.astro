---
import MainLayout from '../layouts/MainLayout.astro';
import { supabase } from '../lib/supabase.js';

// Fetch asatidz data
const { data: asatidz, error } = await supabase
  .from('syaikhuna')
  .select('*')
  .order('nama', { ascending: true }); // Order by name since created_at might be missing

const asatidzList = asatidz || [];
---

<MainLayout title="Profil Pengasuh & Asatidz | Nailul Khoir">
  <!-- Hero Section -->
  <div class="bg-gradient-to-b from-gray-900 via-pesantren to-gray-950 py-24 text-white text-center mt-16 md:mt-0 relative overflow-hidden">
    <div class="absolute inset-0 opacity-20 pointer-events-none">
        <div class="absolute top-0 left-1/4 w-96 h-96 bg-emas/20 rounded-full blur-[120px]"></div>
        <div class="absolute bottom-0 right-1/4 w-96 h-96 bg-green-500/10 rounded-full blur-[120px]"></div>
    </div>
    
    <div class="relative z-10 max-w-4xl mx-auto px-4" data-aos="fade-down">
      <span class="inline-block py-1 px-4 rounded-full bg-emas/10 border border-emas/20 text-emas text-xs font-bold tracking-[0.3em] uppercase mb-6">
        Dewan Guru & Pengajar
      </span>
      <h1 class="text-4xl md:text-5xl lg:text-7xl font-display font-black mb-6 text-white tracking-tight">
        Profil <span class="text-emas drop-shadow-[0_0_20px_rgba(234,179,8,0.3)]">Asatidz</span>
      </h1>
      <p class="text-lg md:text-xl text-gray-300 font-medium max-w-2xl mx-auto leading-relaxed">
        Mengenal lebih dekat para pengasuh dan dewan guru yang membimbing santri di Yayasan Pondok Pesantren Nailul Khoir Majalengka.
      </p>
    </div>
  </div>

  <section class="py-20 bg-gray-50 relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      
      {asatidzList.length > 0 ? (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-8">
          {asatidzList.map((ustaz, i) => (
            <div 
              class="group bg-white rounded-[2.5rem] overflow-hidden shadow-[0_10px_40px_rgba(0,0,0,0.04)] hover:shadow-[0_20px_60px_rgba(0,0,0,0.1)] transition-all duration-500 hover:-translate-y-2 border border-gray-100 flex flex-col items-center p-6"
              data-aos="fade-up" 
              data-delay={i * 100}
            >
              <!-- Foto Profil Modern -->
              <div class="relative w-40 h-40 md:w-48 md:h-48 mb-6 group">
                <div class="absolute inset-0 bg-emas rounded-[2rem] rotate-6 group-hover:rotate-12 transition-transform duration-500 opacity-20"></div>
                <div class="absolute inset-0 bg-pesantren rounded-[2rem] -rotate-3 group-hover:-rotate-6 transition-transform duration-500 opacity-10"></div>
                <div class="relative w-full h-full rounded-[2rem] overflow-hidden border-4 border-white shadow-xl bg-gray-100">
                  {ustaz.foto_url ? (
                    <img src={ustaz.foto_url} alt={ustaz.nama} class="w-full h-full object-cover grayscale-[0.3] group-hover:grayscale-0 transition-all duration-700 group-hover:scale-110" />
                  ) : (
                    <div class="w-full h-full flex items-center justify-center bg-gray-50">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-20 w-20 text-gray-200" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" /></svg>
                    </div>
                  )}
                </div>
              </div>

              <!-- Info Profil -->
              <div class="text-center w-full px-2">
                <h3 class="text-xl font-black text-gray-900 mb-2 leading-tight tracking-tight group-hover:text-pesantren transition-colors">
                  {ustaz.nama}
                </h3>
                <div class="h-1 w-10 bg-emas/40 rounded-full mx-auto mb-4 group-hover:w-16 transition-all duration-500"></div>
                <p class="text-gray-500 text-sm font-medium leading-relaxed italic line-clamp-4">
                  "{ustaz.description}"
                </p>
              </div>
              
              <!-- Social / Contact Placeholder if needed -->
              <div class="mt-6 flex gap-3 opacity-0 group-hover:opacity-100 transition-opacity duration-500">
                 <div class="w-8 h-8 rounded-full bg-green-50 text-pesantren flex items-center justify-center hover:bg-pesantren hover:text-white transition-colors cursor-pointer">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
                 </div>
              </div>
            </div>
          ))}
        </div>
      ) : (
        <div class="bg-white rounded-3xl p-16 text-center border border-gray-200 shadow-sm max-w-2xl mx-auto" data-aos="fade-in">
          <div class="w-20 h-20 bg-gray-50 rounded-full flex items-center justify-center mx-auto mb-6">
             <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-gray-300" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" /></svg>
          </div>
          <p class="text-gray-900 font-bold text-2xl mb-2">Belum Tersedia</p>
          <p class="text-gray-500">Data profil asatidz sedang dalam proses pembaruan oleh pihak pesantren.</p>
        </div>
      )}
      
      <!-- Call to Action Section -->
      <div class="mt-24 bg-pesantren rounded-[3rem] p-6 sm:p-10 md:p-16 text-center relative overflow-hidden shadow-2xl">
         <div class="absolute -top-20 -right-20 w-64 h-64 bg-white/5 rounded-full blur-3xl"></div>
         <div class="absolute -bottom-20 -left-20 w-64 h-64 bg-emas/20 rounded-full blur-3xl"></div>
         <div class="relative z-10">
            <h2 class="text-3xl md:text-4xl font-display font-black text-white mb-6">Ingin Bergabung Bersama Kami?</h2>
            <p class="text-green-50/80 mb-10 max-w-2xl mx-auto text-lg">Pendaftaran santri baru telah dibuka untuk tahun ajaran ini. Mari menjalin ukhuwah dan menuntut ilmu bersama.</p>
            <div class="flex flex-col sm:flex-row justify-center gap-4">
               <a href="/pendaftaran" class="px-10 py-4 bg-emas text-pesantren font-black rounded-full shadow-xl hover:bg-yellow-400 hover:scale-105 active:scale-95 transition-all text-lg uppercase tracking-wider">
                  Daftar Sekarang
               </a>
            </div>
         </div>
      </div>
    </div>
  </section>
</MainLayout>
