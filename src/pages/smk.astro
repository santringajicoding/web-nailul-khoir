---
import MainLayout from '../layouts/MainLayout.astro';
---
<MainLayout title="SMK Nailul Khoir">
  <!-- Hero Section -->
  <div class="relative bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-slate-800 via-gray-900 to-black py-20 md:py-32 text-white overflow-hidden">
    <!-- Jaringan titik tech/digital -->
    <div class="absolute inset-0 opacity-15 mix-blend-overlay bg-[url('https://www.transparenttextures.com/patterns/cubes.png')] animate-pulse" style="animation-duration: 8s;"></div>
    <div class="absolute inset-0 bg-gradient-to-b from-transparent to-gray-50"></div>
    
    <div class="max-w-4xl mx-auto px-4 relative z-10 text-center" data-aos="zoom-in" data-aos-duration="1000">
      <div class="w-28 h-28 bg-white/10 backdrop-blur-md rounded-full flex items-center justify-center mx-auto mb-8 shadow-[0_0_40px_rgba(250,204,21,0.2)] p-2 border border-blue-400/20 transition-transform duration-500 hover:scale-110">
        <div class="w-full h-full bg-white rounded-full flex items-center justify-center p-3 shadow-inner">
          <img src="/images/logo-smk.png" alt="Logo SMK" class="w-full h-full object-contain mix-blend-multiply drop-shadow-sm" />
        </div>
      </div>
      <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-display font-black mb-6 text-transparent bg-clip-text bg-gradient-to-r from-blue-300 via-white to-emas drop-shadow-sm tracking-tight">SMK Nailul Khoir</h1>
      <p class="text-lg md:text-2xl text-gray-300 font-light max-w-3xl mx-auto drop-shadow-md leading-relaxed border-b border-gray-600 pb-8 inline-block">Mencetak Lulusan Siap Kerja yang Berkompetensi Tinggi di Era Digital dengan Bekal Iman & Takwa.</p>
    </div>
  </div>

  <!-- Content Section -->
  <div class="max-w-5xl mx-auto px-4 py-8 -mt-12 md:-mt-24 relative z-20 mb-20">
    <div class="bg-white rounded-3xl shadow-[0_20px_60px_rgba(0,0,0,0.06)] border border-gray-100 p-6 md:p-14 mx-auto" data-aos="fade-up">
      <div class="text-center md:text-left mb-12">
        <h2 class="text-xs font-bold text-gray-500 uppercase tracking-widest mb-2">Pendidikan Menengah Kejuruan</h2>
        <h3 class="text-3xl md:text-4xl font-display text-gray-900 font-bold">Profil & Kompetensi Keahlian SMK</h3>
      </div>
      
      <p class="text-lg md:text-xl text-gray-600 leading-relaxed font-light mb-12 border-l-4 border-blue-500 pl-6 bg-slate-50 p-6 rounded-r-2xl">
        Sekolah Menengah Kejuruan (SMK) Nailul Khoir berorientasi penuh pada teknologi informasi dan kewirausahaan santri. Kami menyelaraskan spesifikasi keterampilan vokasi abad ke-21 dengan kemandirian layaknya santri salaf.
      </p>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-16">
        <div class="bg-gradient-to-br from-blue-50 to-white p-8 md:p-10 rounded-3xl border border-blue-100 shadow-[0_10px_40px_rgba(59,130,246,0.04)] relative overflow-hidden group hover:shadow-[0_10px_40px_rgba(59,130,246,0.1)] transition-all duration-500 hover:-translate-y-1">
          <div class="absolute -right-10 -top-10 w-40 h-40 bg-blue-100 rounded-full blur-3xl opacity-60 group-hover:bg-blue-200 transition-colors duration-500"></div>
          <div class="w-12 h-12 bg-blue-600 text-white rounded-xl flex items-center justify-center mb-6 shadow-lg shadow-blue-500/30">
             <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" /></svg>
          </div>
          <h4 class="font-display font-bold text-gray-900 text-2xl mb-6 relative z-10">Jurusan Tersedia</h4>
          <ul class="space-y-4 text-gray-600 relative z-10 font-medium">
            <li class="flex items-center p-3 bg-white rounded-xl shadow-sm border border-gray-50"><span class="flex-shrink-0 w-8 h-8 bg-blue-100 text-blue-600 rounded-lg flex items-center justify-center mr-4 text-xs font-bold">RPL</span> <span>Rekayasa Perangkat Lunak</span></li>
            <li class="flex items-center p-3 bg-white rounded-xl shadow-sm border border-gray-50"><span class="flex-shrink-0 w-8 h-8 bg-blue-100 text-blue-600 rounded-lg flex items-center justify-center mr-4 text-xs font-bold">TKJ</span> <span>Teknik Komputer & Jaringan</span></li>
            <li class="flex items-center p-3 bg-white rounded-xl shadow-sm border border-gray-50"><span class="flex-shrink-0 w-8 h-8 bg-blue-100 text-blue-600 rounded-lg flex items-center justify-center mr-4 text-xs font-bold">BDP</span> <span>Bisnis Daring & Pemasaran</span></li>
          </ul>
        </div>
        
        <div class="bg-gradient-to-br from-emerald-50 to-white p-8 md:p-10 rounded-3xl border border-emerald-100 shadow-[0_10px_40px_rgba(16,185,129,0.04)] relative overflow-hidden group hover:shadow-[0_10px_40px_rgba(16,185,129,0.1)] transition-all duration-500 hover:-translate-y-1">
          <div class="absolute -left-10 -bottom-10 w-40 h-40 bg-emerald-100 rounded-full blur-3xl opacity-60 group-hover:bg-emerald-200 transition-colors duration-500"></div>
          <div class="w-12 h-12 bg-emerald-500 text-white rounded-xl flex items-center justify-center mb-6 shadow-lg shadow-emerald-500/30">
             <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" /></svg>
          </div>
          <h4 class="font-display font-bold text-gray-900 text-2xl mb-6 relative z-10">Kurikulum Ekstra</h4>
          <ul class="space-y-4 text-gray-600 relative z-10 font-medium">
            <li class="flex items-center p-3 bg-white rounded-xl shadow-sm border border-gray-50"><span class="flex-shrink-0 w-8 h-8 bg-emerald-100 text-emerald-600 rounded-full flex items-center justify-center mr-4">✓</span> <span>Kewirausahaan (Santri Preneur)</span></li>
            <li class="flex items-center p-3 bg-white rounded-xl shadow-sm border border-gray-50"><span class="flex-shrink-0 w-8 h-8 bg-emerald-100 text-emerald-600 rounded-full flex items-center justify-center mr-4">✓</span> <span>Magang Industri Kompetensi</span></li>
            <li class="flex items-center p-3 bg-white rounded-xl shadow-sm border border-gray-50"><span class="flex-shrink-0 w-8 h-8 bg-emerald-100 text-emerald-600 rounded-full flex items-center justify-center mr-4">✓</span> <span>Pembacaan Kitab Kuning</span></li>
          </ul>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center mb-16">
        <div class="lg:col-span-7">
           <h3 class="font-display text-3xl font-bold text-gray-900 mb-4">Visi & Misi SMK</h3>
           <p class="text-gray-600 leading-relaxed font-light mb-6">
             <strong>Visi:</strong> Mewujudkan lulusan Sekolah Menengah Kejuruan yang unggul dalam ilmu pengetahuan dan teknologi (IPTEK) berlandaskan iman dan takwa (IMTAK) serta memiliki kemandirian wirausaha.
           </p>
           <ul class="space-y-3 text-gray-700 font-medium">
             <li class="flex items-start"><span class="text-blue-500 mr-2 mt-0.5">■</span> Menyelenggarakan pendidikan kejuruan yang adaktif.</li>
             <li class="flex items-start"><span class="text-blue-500 mr-2 mt-0.5">■</span> Membangun jiwa wirausaha inovatif (Santri Preneur).</li>
             <li class="flex items-start"><span class="text-blue-500 mr-2 mt-0.5">■</span> Menerapkan nilai-nilai akhlakul karimah setiap saat.</li>
             <li class="flex items-start"><span class="text-blue-500 mr-2 mt-0.5">■</span> Menjalin MoU Industri untuk rekrutmen lulusan.</li>
           </ul>
        </div>
        <div class="lg:col-span-5 bg-gray-900 rounded-3xl h-full min-h-[300px] border-4 border-gray-100 overflow-hidden relative shadow-lg group">
           <!-- Placeholder for a coding or networking image -->
           <img src="/images/hero-bg.jpg" alt="Praktek Kejuruan SMK" class="w-full h-full object-cover filter brightness-50 contrast-125 saturate-50 group-hover:scale-105 group-hover:filter-none transition-all duration-700" />
           <div class="absolute inset-0 bg-gradient-to-t from-black via-black/40 to-transparent flex flex-col justify-end p-6 pointer-events-none">
             <div class="w-10 h-10 bg-blue-600 rounded-full flex items-center justify-center text-white mb-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
             </div>
             <p class="text-white font-bold text-lg">Lab Praktek Komputer</p>
             <p class="text-gray-300 text-sm">Fasilitas Standar Industri</p>
           </div>
        </div>
      </div>

      <div class="bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-slate-800 via-gray-900 to-black text-white p-8 md:p-14 rounded-3xl shadow-2xl relative overflow-hidden" data-aos="zoom-in">
          <div class="absolute top-0 right-0 w-96 h-96 bg-blue-500/10 rounded-full blur-3xl translate-x-1/2 -translate-y-1/2 pointer-events-none"></div>
          <div class="absolute bottom-0 left-0 w-64 h-64 bg-emerald-500/10 rounded-full blur-3xl -translate-x-1/2 translate-y-1/2 pointer-events-none"></div>
          
          <div class="text-center relative z-10 mb-10">
            <h3 class="font-display font-light text-gray-400 uppercase tracking-widest text-sm mb-2">Keluaran</h3>
            <h4 class="font-display font-bold text-transparent bg-clip-text bg-gradient-to-r from-blue-300 to-emerald-300 text-3xl md:text-4xl">Peta Jalan Prospek Karir Lulusan</h4>
          </div>
          
          <div class="flex flex-wrap justify-center gap-4 relative z-10 mb-8">
            <div class="bg-gray-800/80 backdrop-blur-md border border-gray-700 px-6 py-4 rounded-2xl flex items-center gap-3 shadow-lg hover:-translate-y-1 transition-transform">
               <div class="w-8 h-8 rounded-full bg-blue-500/20 text-blue-400 flex items-center justify-center">💻</div>
               <span class="font-semibold text-gray-200">Software Engineer</span>
            </div>
            <div class="bg-gray-800/80 backdrop-blur-md border border-gray-700 px-6 py-4 rounded-2xl flex items-center gap-3 shadow-lg hover:-translate-y-1 transition-transform">
               <div class="w-8 h-8 rounded-full bg-indigo-500/20 text-indigo-400 flex items-center justify-center">🌐</div>
               <span class="font-semibold text-gray-200">Network Administrator</span>
            </div>
            <div class="bg-gray-800/80 backdrop-blur-md border border-gray-700 px-6 py-4 rounded-2xl flex items-center gap-3 shadow-lg hover:-translate-y-1 transition-transform">
               <div class="w-8 h-8 rounded-full bg-emerald-500/20 text-emerald-400 flex items-center justify-center">📈</div>
               <span class="font-semibold text-gray-200">Technopreneur</span>
            </div>
            <div class="bg-gray-800/80 backdrop-blur-md border border-gray-700 px-6 py-4 rounded-2xl flex items-center gap-3 shadow-lg hover:-translate-y-1 transition-transform">
               <div class="w-8 h-8 rounded-full bg-purple-500/20 text-purple-400 flex items-center justify-center">📱</div>
               <span class="font-semibold text-gray-200">Digital Marketer</span>
            </div>
          </div>
          
          <p class="text-center text-gray-400 text-lg leading-relaxed max-w-2xl mx-auto relative z-10 font-light">
             Lulusan SMK Nailul Khoir tidak hanya siap diterjunkan sebagai tenaga ahli di perusahaan, tetapi sangat didorong kemandiriannya untuk membuka lapangan pekerjaan baru berbasis teknologi digital, serta dibekali kesempatan melanjutkan kuliah tanpa melupakan identitasnya sebagai santri salaf.
          </p>
       </div>

      <!-- Pendaftaran Call to Action -->
      <div class="mt-20 text-center flex flex-col items-center" data-aos="fade-up">
        <h3 class="font-display text-3xl md:text-4xl font-black text-gray-900 mb-6 tracking-tight">Wujudkan Karir Masa Depanmu Disini!</h3>
        <p class="text-gray-500 mb-8 max-w-lg mx-auto">Mulai perjalananmu menjadi ahlinya IT dengan keadaban dan spiritualitas yang kuat bersama kami.</p>
        <a href="/pendaftaran?jalur=SMK" class="bg-gradient-to-r from-blue-600 to-blue-800 text-white font-black px-12 py-5 rounded-full shadow-[0_10px_30px_rgba(37,99,235,0.3)] transition-all duration-300 hover:scale-[1.03] hover:-translate-y-1 hover:shadow-[0_15px_40px_rgba(37,99,235,0.5)] inline-flex items-center gap-3 text-lg group">
          <span>Isi Formulir Pendaftaran PPDB</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 group-hover:translate-x-2 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
        </a>
      </div>
    </div>
  </div>
</MainLayout>
