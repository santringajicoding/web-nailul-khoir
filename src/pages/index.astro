---
import MainLayout from '../layouts/MainLayout.astro';
import CardBerita from '../components/CardBerita.astro';
import MarqueeGaleri from '../components/MarqueeGaleri.astro';
import { supabase } from '../lib/supabase.js';

// Mengambil 3 berita terbaru dari tabel Supabase
const { data: beritaData, error } = await supabase
  .from('berita')
  .select('*')
  .order('tanggal_berita', { ascending: false })
  .limit(3);

const beritaList = beritaData || [];

// Mengambil data kajian
const { data: kajianData } = await supabase
  .from('kajian')
  .select('*')
  .limit(4);

const kajianList = kajianData || [];

// Mengambil URL Latar Belakang Hero Image (Bila ada yang diatur lewat Admin)
// Jika tidak ada pengaturan_web di Supabase, default fallback adalah hero-bg.jpg bawaan template
let heroBgUrl = '/images/hero-bg.jpg';
try {
  const { data: heroSetting } = await supabase
    .from('pengaturan_web')
    .select('value')
    .eq('key', 'hero_bg_url')
    .single();

  if (heroSetting && heroSetting.value) {
    heroBgUrl = heroSetting.value;
  }
} catch (e) {
  // Abaikan error jika tabel pengaturan_web belum di-set di DB
}
---

<MainLayout title="Beranda">
  <!-- Hero Section (Cinematic / Video Background) -->
  <section class="relative bg-gray-950 text-white overflow-hidden pt-32 pb-24 md:pt-48 md:pb-40 flex flex-col items-center justify-center min-h-[90vh]">
    
    <!-- Latar Belakang Animasi Ombak Gelap / Mesh Gradient -->
    <div class="absolute inset-0 z-0">
      <!-- Gambar fallback/tekstur yang di-gelapkan luar biasa -->
      <img src={heroBgUrl} alt="Latar Belakang Pesantren" class="absolute inset-0 w-full h-full object-cover opacity-30 mix-blend-luminosity filter grayscale" />
      
      <!-- Overlay warna dinamis (Cinematic Gradient Animation) -->
      <div class="absolute inset-0 cinematic-bg mix-blend-overlay opacity-80"></div>
      
      <!-- Vignette (gelap di pinggir) -->
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-transparent via-gray-950/80 to-gray-950"></div>
    </div>

    <!-- Main Content -->
    <div class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center flex flex-col items-center" data-aos="zoom-in" data-aos-duration="1500">
      <style>
        @keyframes gradientMove {
          0% { background-position: 0% 50%; }
          50% { background-position: 100% 50%; }
          100% { background-position: 0% 50%; }
        }
        .cinematic-bg {
          background: linear-gradient(-45deg, #064e3b, #14532d, #0f172a, #064e3b);
          background-size: 300% 300%;
          animation: gradientMove 15s ease infinite;
        }

        /* 1. Entrance / Reveal Animation */
        @keyframes gracefulReveal {
          0% { opacity: 0; transform: translateY(40px) scale(0.95); filter: blur(12px); }
          100% { opacity: 1; transform: translateY(0) scale(1); filter: blur(0); }
        }
        .animate-reveal {
          opacity: 0;
          animation: gracefulReveal 1.2s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
        }

        /* Delays for cascading effect */
        .delay-200 { animation-delay: 200ms; }
        .delay-400 { animation-delay: 400ms; }
        .delay-600 { animation-delay: 600ms; }
        .delay-800 { animation-delay: 800ms; }
        .delay-1000 { animation-delay: 1000ms; }
        
        /* 2. Text Shimmer Animation untuk teks emas */
        @keyframes textShimmer {
          0% { background-position: 0% center; }
          100% { background-position: -200% center; }
        }
        .text-flow {
          background-size: 200% auto;
          animation: textShimmer 4s linear infinite;
        }

        /* 3. Floating Animation untuk Paragraf */
        @keyframes floatSmooth {
          0%, 100% { transform: translateY(0); }
          50% { transform: translateY(-8px); }
        }
        .animate-float {
          animation: floatSmooth 6s ease-in-out infinite;
        }

        /* 4. Rotating Greetings */
        @keyframes textRotate3D {
          0% { opacity: 0; transform: translateY(30px) translateZ(-50px) rotateX(-40deg); filter: blur(10px); }
          5% { opacity: 1; transform: translateY(0) translateZ(0) rotateX(0); filter: blur(0); }
          28% { opacity: 1; transform: translateY(0) translateZ(0) rotateX(0); filter: blur(0); }
          33% { opacity: 0; transform: translateY(-30px) translateZ(50px) rotateX(40deg); filter: blur(10px); }
          100% { opacity: 0; transform: translateY(-30px) translateZ(50px) rotateX(40deg); filter: blur(10px); }
        }
        .greeting-animate {
          opacity: 0;
          transform-style: preserve-3d;
          animation: textRotate3D 9s infinite cubic-bezier(0.25, 1, 0.5, 1);
        }

        /* 5. Heartbeat/Glow untuk tombol utama */
        @keyframes glowPulse {
          0%, 100% { box-shadow: 0 0 20px rgba(250,204,21,0.4), inset 0 0 0 rgba(255,255,255,0); }
          50% { box-shadow: 0 0 50px rgba(250,204,21,0.8), inset 0 0 10px rgba(255,255,255,0.5); }
        }
        .btn-glow {
          animation: glowPulse 3s infinite;
        }
      </style>

      <!-- Welcome Message with Transitions -->
      <div class="animate-reveal delay-200 flex items-center justify-center gap-4 mb-6" style="perspective: 1000px;">
        <div class="h-[1px] w-8 md:w-16 border-t border-emas/50 hidden sm:block"></div>
        <div class="relative h-6 md:h-8 w-64 md:w-72 flex justify-center text-emas font-bold tracking-[0.2em] text-xs sm:text-sm md:text-base uppercase flex-shrink-0">
          <span class="absolute w-full inset-0 flex items-center justify-center text-center greeting-animate" style="animation-delay: 0s;">Selamat Datang</span>
          <span class="absolute w-full inset-0 flex items-center justify-center text-center greeting-animate" style="animation-delay: 3s;">Wilujeng Sumping</span>
          <span class="absolute w-full inset-0 flex items-center justify-center text-center greeting-animate" style="animation-delay: 6s;">Sugeng Rawuh</span>
        </div>
        <div class="h-[1px] w-8 md:w-16 border-t border-emas/50 hidden sm:block"></div>
      </div>

      <!-- Main Headline -->
      <h1 class="text-5xl md:text-7xl lg:text-8xl font-display tracking-tight text-white leading-[1.1] mb-8 z-10 w-full">
        <span class="block animate-reveal delay-400 font-light drop-shadow-lg">Pondok Pesantren</span>
        <span class="block animate-reveal delay-600 mt-2 pb-2 drop-shadow-[0_0_40px_rgba(250,204,21,0.6)]">
          <strong class="font-black text-transparent bg-clip-text bg-gradient-to-r from-yellow-300 via-white to-yellow-500 text-flow">
            Nailul Khoir
          </strong>
        </span>
      </h1>

      <!-- Slogan -->
      <div class="animate-reveal delay-800 w-full">
        <p class="animate-float text-lg md:text-2xl text-gray-100 font-medium max-w-4xl mx-auto mb-14 leading-relaxed italic drop-shadow-xl sm:text-center border-l-4 border-emas/70 pl-5 sm:border-l-0 sm:pl-0 mix-blend-screen bg-black/10 sm:bg-transparent rounded-lg p-3 sm:p-0 backdrop-blur-sm sm:backdrop-blur-none border-white/10 sm:border-transparent">
          "Terwujudnya Kader Muslim Yang Kaya Akan Ilmu Kuat Dalam Aqidah Dan Berakhlaqul Karimah"
        </p>
      </div>

      <!-- Call to Actions -->
      <div class="animate-reveal delay-1000 flex flex-col sm:flex-row gap-6 justify-center items-center w-full sm:w-auto relative z-20 group/btns">
        <a href="/pendaftaran" class="w-full sm:w-auto relative group overflow-hidden bg-gradient-to-br from-yellow-400 via-emas to-yellow-600 text-gray-900 font-extrabold px-12 py-5 rounded-full btn-glow transition-all duration-500 text-lg flex items-center justify-center">
          <span class="relative z-10 transition-transform duration-300 group-hover:-translate-y-1">Mulai Perjalanan</span>
          <div class="absolute inset-0 bg-white/30 translate-y-full group-hover:translate-y-0 transition-transform duration-300 ease-in-out"></div>
        </a>
        <a href="/tentang" class="w-full sm:w-auto text-white border border-white/30 hover:bg-white/10 hover:border-white/60 font-semibold px-12 py-5 rounded-full transition-all duration-500 flex items-center justify-center gap-3 backdrop-blur-md shadow-[0_0_20px_rgba(255,255,255,0.05)] hover:shadow-[0_0_30px_rgba(255,255,255,0.15)] group-hover/btns:opacity-100">
          <span class="group-hover:scale-105 transition-transform">Tonton Video Profil</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 group-hover:rotate-12 transition-transform" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l-3-2z" clip-rule="evenodd" /></svg>
        </a>
      </div>
    </div>
    
    <!-- Partikel Mengambang (Opsional Cinematic Effect) -->
    <div class="absolute inset-0 z-0 pointer-events-none opacity-40 mix-blend-screen">
       <div class="absolute top-[20%] left-[10%] w-2 h-2 rounded-full bg-emas shadow-[0_0_15px_rgba(250,204,21,1)] animate-pulse"></div>
       <div class="absolute top-[60%] right-[15%] w-3 h-3 rounded-full bg-white opacity-50 shadow-[0_0_15px_rgba(255,255,255,1)] animate-pulse delay-700"></div>
       <div class="absolute bottom-[30%] left-[20%] w-1.5 h-1.5 rounded-full bg-yellow-200 shadow-[0_0_10px_rgba(250,204,21,1)] animate-ping"></div>
       <div class="absolute top-[40%] right-[30%] w-1 h-1 rounded-full bg-white opacity-70 animate-pulse delay-500"></div>
    </div>
  </section>

  <!-- Galeri Berita (Marquee) -->
  <MarqueeGaleri />

  <!-- Highlight Pendidikan -->
  <section class="py-16 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12" data-aos="fade-up">
        <h2 class="text-base text-pesantren font-bold tracking-wide uppercase">Pendidikan Terpadu</h2>
        <p class="mt-2 text-3xl font-display leading-8 font-extrabold tracking-tight text-gray-900 sm:text-4xl">
          Layanan Pendidikan Kami
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Card SMPIT -->
        <div class="bg-white rounded-2xl p-8 shadow-lg hover:shadow-xl transition-shadow border-t-4 border-pesantren text-center" data-aos="fade-up" data-aos-delay="0">
          <div class="w-20 h-20 bg-white rounded-full flex items-center justify-center mx-auto mb-6 shadow-sm p-1 border border-green-200 transition-transform hover:scale-110">
            <img src="/images/logo-smp.png" alt="Logo SMP" class="w-full h-full object-contain mix-blend-multiply" />
          </div>
          <h3 class="text-2xl font-display font-bold text-gray-900 mb-4">SMPIT Nailul Khoir</h3>
          <p class="text-gray-600 mb-6 font-medium">Sekolah Menengah Pertama Islam Terpadu dengan kurikulum nasional dan kepesantrenan.</p>
          <a href="/smp" class="text-pesantren font-bold hover:underline">Pelajari Kurikulum &rarr;</a>
        </div>
        
        <!-- Card SMK -->
        <div class="bg-white rounded-2xl p-8 shadow-lg hover:shadow-xl transition-shadow border-t-4 border-emas text-center" data-aos="fade-up" data-aos-delay="100">
          <div class="w-20 h-20 bg-white rounded-full flex items-center justify-center mx-auto mb-6 shadow-sm p-1 border border-yellow-200 transition-transform hover:scale-110">
            <img src="/images/logo-smk.png" alt="Logo SMK" class="w-full h-full object-contain mix-blend-multiply" />
          </div>
          <h3 class="text-2xl font-display font-bold text-gray-900 mb-4">SMK Nailul Khoir</h3>
          <p class="text-gray-600 mb-6 font-medium">Sekolah Menengah Kejuruan berorientasi pada teknologi informasi dan kewirausahaan santri.</p>
          <a href="/smk" class="text-pesantren font-bold hover:underline">Pelajari Jurusan &rarr;</a>
        </div>

        <!-- Card Pondok -->
        <div class="bg-white rounded-2xl p-8 shadow-lg hover:shadow-xl transition-shadow border-t-4 border-pesantren text-center" data-aos="fade-up" data-aos-delay="200">
          <div class="w-16 h-16 bg-white rounded-full flex items-center justify-center mx-auto mb-6 shadow-sm p-2 border border-green-100 transition-transform hover:scale-110">
            <img src="/images/logo.png" alt="Logo Pondok Pesantren" class="w-full h-full object-contain" />
          </div>
          <h3 class="text-2xl font-display font-bold text-gray-900 mb-4">Pondok Pesantren</h3>
          <p class="text-gray-600 mb-6 font-medium">Pendidikan murni kepesantrenan, tahfidz Al-Qur'an, dan kajian kitab kuning Salafiyah.</p>
          <a href="/pondok" class="text-pesantren font-bold hover:underline">Pelajari Program &rarr;</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Berita Terbaru -->
  <section class="py-16 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex justify-between items-end mb-10">
        <div>
          <h2 class="text-base text-emas font-bold tracking-wide uppercase">Informasi & Update</h2>
          <p class="mt-2 text-3xl font-display leading-8 font-extrabold tracking-tight text-gray-900 sm:text-4xl">
            Berita Terbaru
          </p>
        </div>
        <a href="#" class="hidden sm:inline-block text-pesantren font-bold hover:border-b-2 hover:border-pesantren pb-1">
          Lihat Semua Berita &rarr;
        </a>
      </div>

      {beritaList.length > 0 ? (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
          {beritaList.map((berita, i) => (
             <div data-aos="fade-up" data-aos-delay={i * 100}>
               <CardBerita 
                 judul={berita.judul} 
                 foto_url={berita.foto_url} 
                 description={berita.description} 
                 tanggal={berita.tanggal_berita} 
               />
             </div>
          ))}
        </div>
      ) : (
        <div class="bg-gray-50 rounded-xl p-10 text-center border border-gray-100">
          <p class="text-gray-500 font-medium text-lg">Belum ada berita yang diterbitkan.</p>
          <p class="text-gray-400 mt-2">Nantikan informasi terbaru dari Yayasan Pondok Pesantren Nailul Khoir.</p>
        </div>
      )}
      
      <div class="mt-8 text-center sm:hidden">
        <a href="#" class="inline-block text-pesantren font-bold hover:underline">
          Lihat Semua Berita &rarr;
        </a>
      </div>
    </div>
  </section>

  <!-- Jadwal Kajian & Taklim -->
  <section class="py-16 bg-green-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12" data-aos="fade-up">
        <h2 class="text-base text-emas font-bold tracking-wide uppercase">Kajian Kitab Kuning</h2>
        <p class="mt-2 text-3xl font-display leading-8 font-extrabold tracking-tight text-pesantren sm:text-4xl">
          Jadwal Majelis Taklim
        </p>
      </div>

      {kajianList.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          {kajianList.map((kajian, i) => (
            <div class="bg-white rounded-2xl shadow-md overflow-hidden flex flex-col sm:flex-row hover:shadow-lg transition-shadow border-l-4 border-emas" data-aos="fade-up" data-aos-delay={i * 100}>
              {kajian.foto_url && (
                <div class="w-full sm:w-1/3 bg-gray-200 shrink-0 h-48 sm:h-auto">
                  <img src={kajian.foto_url} alt={kajian.judul} class="w-full h-full object-cover" loading="lazy" />
                </div>
              )}
              <div class="p-6 flex flex-col justify-center flex-grow">
                <h3 class="text-xl font-display font-bold text-gray-900 mb-2">{kajian.judul}</h3>
                <div class="text-gray-600 whitespace-pre-wrap flex-grow text-sm mb-4 leading-relaxed">{kajian.description}</div>
                <div class="flex items-center text-pesantren font-bold text-xs">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                  Rutinan Pesantren Terbuka
                </div>
              </div>
            </div>
          ))}
        </div>
      ) : (
        <div class="bg-white rounded-xl p-10 text-center border border-gray-100 shadow-sm">
          <p class="text-gray-500 font-medium my-2">Belum ada agenda kajian yang dijadwalkan.</p>
        </div>
      )}
    </div>
  </section>
</MainLayout>
