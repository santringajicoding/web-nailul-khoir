---
import MainLayout from '../layouts/MainLayout.astro';
import CardBerita from '../components/CardBerita.astro';
import MarqueeGaleri from '../components/MarqueeGaleri.astro';
import { supabase } from '../lib/supabase.js';

// Mengambil 3 berita terbaru dari tabel Supabase
const { data: beritaData, error } = await supabase
  .from('berita')
  .select('*')
  .order('tanggal_berita', { ascending: false })
  .limit(3);

const beritaList = beritaData || [];

// Mengambil data kajian terbaru
const { data: kajianData } = await supabase
  .from('kajian')
  .select('*')
  .limit(4);

const kajianList = kajianData || [];

// Mengambil pengaturan gambar latar hero
let heroBgUrl = '/images/hero-bg.jpg';
try {
  const { data: heroSetting } = await supabase
    .from('pengaturan_web')
    .select('value')
    .eq('key', 'hero_bg_url')
    .single();

  if (heroSetting && heroSetting.value) {
    heroBgUrl = heroSetting.value;
  }
} catch (e) {
  // Gunakan gambar fallback
}
---

<MainLayout title="Beranda Utama">
  <!-- HERO SECTION (Cinematic / Video Background) -->
  <section class="relative bg-gray-950 text-white overflow-hidden pt-28 pb-12 sm:pt-32 sm:pb-20 flex flex-col items-center justify-center min-h-[100svh] max-h-[1100px]">
    
    <!-- Latar Belakang Cerah nan Premium -->
    <div class="absolute inset-0 z-0 bg-gray-950">
      <!-- 1. Menampilkan Warna Wajar & Lebih Terang (Tanpa Grayscale) -->
      <img src={heroBgUrl} alt="Latar Belakang Pesantren" class="absolute inset-0 w-full h-full object-cover opacity-80" />
      
      <!-- 2. Overlay Gradasi Gelap Elegan (Membantu teks kontras tanpa menutupi foto utuh) -->
      <div class="absolute inset-0 bg-gradient-to-b md:bg-gradient-to-t from-gray-950/90 via-gray-950/40 to-gray-900/80"></div>
      
      <!-- 3. Sisipan Animasi Glow Halus -->
      <div class="absolute inset-0 cinematic-bg mix-blend-color-dodge opacity-20"></div>
    </div>

    <!-- Konten Hero Utama -->
    <div class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center flex flex-col items-center" data-aos="zoom-in" data-aos-duration="1500">
      
      <style>
        @keyframes gradientMove {
          0% { background-position: 0% 50%; }
          50% { background-position: 100% 50%; }
          100% { background-position: 0% 50%; }
        }
        .cinematic-bg {
          background: linear-gradient(-45deg, #022c22, #064e3b, #0f172a, #022c22);
          background-size: 300% 300%;
          animation: gradientMove 15s ease infinite;
        }

        @keyframes gracefulReveal {
          0% { opacity: 0; transform: translateY(40px) scale(0.95); filter: blur(12px); }
          100% { opacity: 1; transform: translateY(0) scale(1); filter: blur(0); }
        }
        .animate-reveal {
          opacity: 0;
          animation: gracefulReveal 1.2s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
        }

        .delay-200 { animation-delay: 200ms; }
        .delay-400 { animation-delay: 400ms; }
        .delay-600 { animation-delay: 600ms; }
        .delay-800 { animation-delay: 800ms; }
        
        @keyframes textShimmer {
          0% { background-position: 0% center; }
          100% { background-position: -200% center; }
        }
        .text-flow {
          background-size: 200% auto;
          animation: textShimmer 4s linear infinite;
        }

        @keyframes floatSmooth {
          0%, 100% { transform: translateY(0); }
          50% { transform: translateY(-8px); }
        }
        .animate-float {
          animation: floatSmooth 6s ease-in-out infinite;
        }

        @keyframes glowPulse {
          0%, 100% { box-shadow: 0 0 20px rgba(250,204,21,0.4), inset 0 0 0 rgba(255,255,255,0); }
          50% { box-shadow: 0 0 50px rgba(250,204,21,0.8), inset 0 0 10px rgba(255,255,255,0.5); }
        }
        .btn-glow {
          animation: glowPulse 3s infinite;
        }
      </style>

      <!-- Sambutan -->
      <div class="animate-reveal delay-200 flex items-center justify-center gap-4 mb-6">
        <div class="h-[2px] w-12 md:w-24 bg-gradient-to-r from-transparent to-emas hidden sm:block"></div>
        <span class="text-emas font-bold tracking-[0.3em] text-xs sm:text-sm md:text-base uppercase bg-emas/10 px-6 py-2 rounded-full border border-emas/30 backdrop-blur-md shadow-[0_0_15px_rgba(250,204,21,0.2)]">
          Selamat Datang Di
        </span>
        <div class="h-[2px] w-12 md:w-24 bg-gradient-to-l from-transparent to-emas hidden sm:block"></div>
      </div>

      <!-- Headline -->
      <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-[5.5rem] font-display tracking-tight text-white leading-[1.1] mb-5 sm:mb-8 z-10 w-full">
        <span class="block animate-reveal delay-400 font-light drop-shadow-lg opacity-90 text-[0.8em] md:text-[0.9em]">Pondok Pesantren</span>
        <span class="block animate-reveal delay-600 mt-1 sm:mt-2 pb-2 drop-shadow-[0_0_40px_rgba(250,204,21,0.6)]">
          <strong class="font-black text-transparent bg-clip-text bg-gradient-to-r from-yellow-300 via-white to-yellow-500 text-flow leading-tight">
            Nailul Khoir
          </strong>
        </span>
      </h1>

      <!-- Slogan -->
      <div class="animate-reveal delay-800 w-full px-2 sm:px-0">
        <p class="animate-float text-sm sm:text-lg md:text-xl text-green-50/90 font-medium max-w-3xl mx-auto mb-8 sm:mb-12 leading-relaxed italic drop-shadow-2xl">
          "Terwujudnya kader muslim yang kaya akan ilmu, tangguh dalam aqidah, dan mulia dengan akhlaqul karimah."
        </p>
      </div>

      <!-- Tombol Aksi -->
      <div class="animate-reveal delay-1000 flex flex-col sm:flex-row gap-4 sm:gap-6 justify-center items-center w-full sm:w-auto relative z-20">
        <a href="/pendaftaran" class="w-full sm:w-auto relative group overflow-hidden bg-gradient-to-tr from-yellow-500 via-emas to-yellow-300 text-gray-900 font-black px-8 py-4 sm:px-12 sm:py-5 rounded-full btn-glow transition-all duration-500 text-base sm:text-lg flex items-center justify-center shadow-2xl hover:scale-105 active:scale-95">
          <span class="relative z-10 flex items-center gap-2">
            Pendaftaran Baru 
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
          </span>
          <div class="absolute inset-0 bg-white/40 translate-y-full group-hover:translate-y-0 transition-transform duration-300 ease-in-out"></div>
        </a>
        <a href="/tentang" class="w-full sm:w-auto text-white border border-white/30 hover:bg-white/10 hover:border-white/60 font-bold px-8 py-4 sm:px-12 sm:py-5 rounded-full transition-all duration-500 flex items-center justify-center gap-3 backdrop-blur-md shadow-[0_0_20px_rgba(255,255,255,0.05)] hover:shadow-[0_0_30px_rgba(255,255,255,0.15)] hover:-translate-y-1">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-emas" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
          Profil Yayasan
        </a>
      </div>
    </div>
    
    <!-- Partikel Dekoratif -->
    <div class="absolute inset-0 z-0 pointer-events-none opacity-50 mix-blend-screen">
       <div class="absolute top-[20%] left-[10%] w-3 h-3 rounded-full bg-emas shadow-[0_0_20px_rgba(250,204,21,1)] animate-pulse"></div>
       <div class="absolute top-[60%] right-[15%] w-4 h-4 rounded-full bg-white opacity-40 shadow-[0_0_20px_rgba(255,255,255,1)] animate-pulse delay-700"></div>
       <div class="absolute bottom-[20%] left-[25%] w-2 h-2 rounded-full bg-yellow-200 shadow-[0_0_15px_rgba(250,204,21,1)] animate-ping"></div>
    </div>
  </section>

  <!-- HIGHLIGHT PENDIDIKAN (Glass & Gradient Cards) -->
  <section class="py-24 bg-gray-50 relative overflow-hidden">
    <!-- Dekorasi Latar -->
    <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-green-100/50 rounded-full blur-[100px] -translate-y-1/2 translate-x-1/3 pointer-events-none"></div>
    <div class="absolute bottom-0 left-0 w-[600px] h-[600px] bg-yellow-50/50 rounded-full blur-[120px] translate-y-1/3 -translate-x-1/3 pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="text-center mb-20" data-aos="fade-up">
        <span class="inline-block py-1.5 px-4 rounded-full bg-green-100 text-pesantren text-sm font-bold tracking-widest mb-4">
          PENDIDIKAN TERPADU
        </span>
        <h2 class="text-4xl sm:text-5xl font-black tracking-tight text-gray-900 mb-6">
          Pilihan Program Belajar
        </h2>
        <div class="h-1.5 w-32 bg-emas mx-auto rounded-full"></div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-10">
        <!-- Card SMPIT -->
        <a href="/smp" class="group relative bg-white rounded-3xl p-10 shadow-xl hover:shadow-2xl transition-all duration-500 border border-gray-100 hover:-translate-y-3 overflow-hidden" data-aos="fade-up" data-aos-delay="0">
          <div class="absolute top-0 left-0 w-full h-2 bg-gradient-to-r from-blue-400 to-blue-600"></div>
          <div class="absolute -right-10 -top-10 w-40 h-40 bg-blue-50 rounded-full blur-3xl group-hover:bg-blue-100 transition-colors duration-500"></div>
          <div class="w-24 h-24 bg-white rounded-2xl flex items-center justify-center mb-8 shadow-md border border-gray-100 group-hover:scale-110 transition-transform duration-500 relative z-10">
            <img src="/images/logo-smp.png" alt="Logo SMP" class="w-16 h-16 object-contain" />
          </div>
          <h3 class="text-3xl font-black text-gray-900 mb-4 tracking-tight relative z-10 group-hover:text-blue-600 transition-colors">SMPIT Ulul Albab</h3>
          <p class="text-gray-600 mb-8 font-medium leading-relaxed relative z-10">Sekolah Menengah Pertama Islam Terpadu dengan kurikulum nasional dan nilai kepesantrenan kuat.</p>
          <div class="inline-flex items-center text-blue-600 font-black relative z-10 group-hover:underline">
            Lihat Kurikulum <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ml-2 group-hover:translate-x-2 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
          </div>
        </a>
        
        <!-- Card SMK -->
        <a href="/smk" class="group relative bg-white rounded-3xl p-10 shadow-xl hover:shadow-2xl transition-all duration-500 border border-gray-100 hover:-translate-y-3 overflow-hidden" data-aos="fade-up" data-aos-delay="100">
          <div class="absolute top-0 left-0 w-full h-2 bg-gradient-to-r from-orange-400 to-orange-600"></div>
          <div class="absolute -right-10 -top-10 w-40 h-40 bg-orange-50 rounded-full blur-3xl group-hover:bg-orange-100 transition-colors duration-500"></div>
          <div class="w-24 h-24 bg-white rounded-2xl flex items-center justify-center mb-8 shadow-md border border-gray-100 group-hover:scale-110 transition-transform duration-500 relative z-10">
            <img src="/images/logo-smk.png" alt="Logo SMK" class="w-16 h-16 object-contain" />
          </div>
          <h3 class="text-3xl font-black text-gray-900 mb-4 tracking-tight relative z-10 group-hover:text-orange-600 transition-colors">SMK Kejuruan IT</h3>
          <p class="text-gray-600 mb-8 font-medium leading-relaxed relative z-10">Mencetak tenaga IT profesional yang siap menghadapi dunia industri dengan landasan akhlak mulia.</p>
          <div class="inline-flex items-center text-orange-600 font-black relative z-10 group-hover:underline">
            Lihat Jurusan <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ml-2 group-hover:translate-x-2 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
          </div>
        </a>

        <!-- Card Pondok -->
        <a href="/pondok" class="group relative bg-white rounded-3xl p-10 shadow-xl hover:shadow-2xl transition-all duration-500 border border-gray-100 hover:-translate-y-3 overflow-hidden" data-aos="fade-up" data-aos-delay="200">
          <div class="absolute top-0 left-0 w-full h-2 bg-gradient-to-r from-green-600 to-pesantren"></div>
          <div class="absolute -right-10 -top-10 w-40 h-40 bg-green-50 rounded-full blur-3xl group-hover:bg-green-100 transition-colors duration-500"></div>
          <div class="w-24 h-24 bg-gradient-to-br from-green-50 to-white rounded-2xl flex items-center justify-center mb-8 shadow-md border border-green-100 group-hover:scale-110 transition-transform duration-500 relative z-10">
            <img src="/images/logo.png" alt="Logo Pondok Pesantren" class="w-16 h-16 object-contain" />
          </div>
          <h3 class="text-3xl font-black text-gray-900 mb-4 tracking-tight relative z-10 group-hover:text-pesantren transition-colors">Pondok Pesantren</h3>
          <p class="text-gray-600 mb-8 font-medium leading-relaxed relative z-10">Pendidikan salaf murni berfokus kepada takhassus tahfidz Al-Qur'an dan kajian kitab kuning komprehensif.</p>
          <div class="inline-flex items-center text-pesantren font-black relative z-10 group-hover:underline">
            Lihat Program <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ml-2 group-hover:translate-x-2 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- SEPARATOR GALERI MARQUEE -->
  <MarqueeGaleri />

  <!-- BERITA TERBARU (Dinamis dari Supabase) -->
  <section class="py-24 bg-white relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col sm:flex-row justify-between items-end mb-16" data-aos="fade-up">
        <div>
          <span class="inline-block py-1 px-3 rounded-full bg-yellow-100 text-emas text-sm font-bold tracking-widest mb-4 border border-yellow-200">
            INFORMASI PUBLIK
          </span>
          <h2 class="text-4xl sm:text-5xl font-black tracking-tight text-gray-900">
            Kabar Terbaru
          </h2>
        </div>
        <a href="/berita" class="hidden sm:inline-flex items-center gap-2 text-pesantren font-bold hover:bg-green-50 px-5 py-2.5 rounded-full transition-colors border border-transparent hover:border-green-200">
          Lebih Banyak Berita <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M12.293 5.293a1 1 0 011.414 0l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-2.293-2.293a1 1 0 010-1.414z" clip-rule="evenodd" /></svg>
        </a>
      </div>

      {beritaList.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {beritaList.map((berita, i) => (
             <div class="h-full flex hover:-translate-y-2 transition-transform duration-500" data-aos="fade-up" data-aos-delay={i * 150}>
               <CardBerita 
                 id={berita.id}
                 judul={berita.judul} 
                 foto_url={berita.foto_url} 
                 description={berita.description} 
                 tanggal={berita.tanggal_berita} 
               />
             </div>
          ))}
        </div>
      ) : (
        <div class="bg-gray-50 rounded-3xl p-16 text-center border-2 border-dashed border-gray-200" data-aos="fade-in">
          <div class="w-20 h-20 bg-white rounded-full flex items-center justify-center mx-auto mb-6 shadow-sm">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-gray-300" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" /></svg>
          </div>
          <p class="text-gray-900 font-bold text-2xl mb-2">Belum Ada Publikasi Baru</p>
          <p class="text-gray-500 max-w-md mx-auto">Nantikan liputan, artikel, dan informasi kegiatan terbaru dari pesantren kami.</p>
        </div>
      )}
      
      <div class="mt-10 text-center sm:hidden">
        <a href="/berita" class="inline-flex items-center gap-2 text-pesantren font-bold hover:bg-green-50 px-6 py-3 rounded-full transition-colors border border-green-100 bg-white shadow-sm">
          Lebih Banyak Berita <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M12.293 5.293a1 1 0 011.414 0l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-2.293-2.293a1 1 0 010-1.414z" clip-rule="evenodd" /></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- JADWAL KAJIAN (Dinamis dari Supabase) -->
  <section class="py-24 bg-gradient-to-b from-gray-900 to-gray-950 text-white relative overflow-hidden">
    <!-- Dekorasi Latar -->
    <div class="absolute -top-40 -right-40 w-96 h-96 bg-emas/10 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-40 -left-40 w-96 h-96 bg-pesantren/20 rounded-full blur-3xl pointer-events-none"></div>
    
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="text-center mb-16" data-aos="fade-in">
        <h2 class="text-base text-emas font-bold tracking-widest uppercase mb-4">Majelis Taklim Umum</h2>
        <p class="text-4xl sm:text-5xl font-black tracking-tight text-white">
          Jadwal Kajian Pesantren
        </p>
        <div class="h-1 w-24 bg-gradient-to-r from-transparent via-emas to-transparent mx-auto mt-6"></div>
      </div>

      {kajianList.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-12">
          {kajianList.map((kajian, i) => (
            <div class="bg-white/5 backdrop-blur-md rounded-3xl p-3 border border-white/10 overflow-hidden flex flex-col sm:flex-row shadow-2xl hover:bg-white/10 transition-colors duration-500 group" data-aos="fade-up" data-aos-delay={i * 150}>
              <div class="w-full sm:w-2/5 h-64 sm:h-auto rounded-2xl overflow-hidden shadow-inner relative shrink-0">
                {kajian.foto_url ? (
                  <img src={kajian.foto_url} alt={kajian.judul} class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700" loading="lazy" />
                ) : (
                  <div class="w-full h-full bg-gradient-to-br from-green-900 to-gray-800 flex items-center justify-center">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16 text-white/20" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" /></svg>
                  </div>
                )}
                <!-- Overlay Label -->
                <div class="absolute top-3 left-3 bg-emas/90 backdrop-blur text-gray-900 text-xs font-black uppercase px-3 py-1 rounded-full shadow-lg">Rutinan</div>
              </div>
              
              <div class="p-6 sm:p-8 flex flex-col justify-center flex-grow">
                <h3 class="text-2xl font-black text-yellow-50 mb-4 tracking-tight group-hover:text-emas transition-colors">{kajian.judul}</h3>
                <div class="text-gray-300 whitespace-pre-wrap flex-grow font-medium leading-relaxed mb-6">{kajian.description}</div>
                <div class="flex items-center text-green-400 font-bold text-sm bg-green-400/10 w-max px-4 py-2 rounded-full border border-green-400/20">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
                  Terbuka Untuk Umum
                </div>
              </div>
            </div>
          ))}
        </div>
      ) : (
        <!-- Default State Jika Belum Ada Kajian -->
        <div class="bg-white/5 backdrop-blur-sm rounded-3xl p-16 text-center border border-white/10 max-w-2xl mx-auto shadow-2xl">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-20 w-20 text-white/20 mx-auto mb-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
          <p class="text-white font-black text-2xl mb-2">Belum Ada Agenda Terekam</p>
          <p class="text-gray-400 font-medium">Jadwal majelis taklim dan pengajian rutin akan segera diperbarui di sini oleh dewan asatidz kami.</p>
        </div>
      )}
    </div>
  </section>
  
</MainLayout>
