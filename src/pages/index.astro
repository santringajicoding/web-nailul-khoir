---
import MainLayout from '../layouts/MainLayout.astro';
import CardBerita from '../components/CardBerita.astro';
import MarqueeGaleri from '../components/MarqueeGaleri.astro';
import TestimonialSlider from '../components/TestimonialSlider.astro';
import { supabase } from '../lib/supabase.js';

// Mengambil 3 berita terbaru dari tabel Supabase
const { data: beritaData, error } = await supabase
  .from('berita')
  .select('*')
  .order('tanggal_berita', { ascending: false })
  .limit(3);

const beritaList = beritaData || [];

// Mengambil data kajian terbaru
const { data: kajianData } = await supabase
  .from('kajian')
  .select('*')
  .limit(4);

const kajianList = kajianData || [];

// Mengambil pengaturan gambar latar hero
let heroBgUrl = '/images/hero-bg.jpg';
try {
  const { data: heroSetting } = await supabase
    .from('pengaturan_web')
    .select('value')
    .eq('key', 'hero_bg_url')
    .single();

  if (heroSetting && heroSetting.value) {
    heroBgUrl = heroSetting.value;
  }
} catch (e) {
  // Gunakan gambar fallback
}
---

<MainLayout title="Beranda Utama">
  <!-- HERO SECTION (Cinematic Glassmorphism & Islamic Accent) -->
  <section class="relative text-white overflow-hidden pt-36 pb-20 sm:pt-44 sm:pb-32 flex flex-col items-center justify-center min-h-[100svh] max-h-[1100px] bg-[#031c14]">
    
    <!-- Latar Belakang Cerah nan Premium -->
    <div class="absolute inset-0 z-0">
      <!-- 1. Menampilkan Warna Wajar & Lebih Terang (Tanpa Grayscale) -->
      <img src={heroBgUrl} alt="Latar Belakang Pesantren" class="absolute inset-0 w-full h-full object-cover opacity-60" />
      
      <!-- 2. Overlay Gradasi Gelap Elegan (Membantu teks kontras tanpa menutupi foto utuh) -->
      <div class="absolute inset-0 bg-gradient-to-b from-[#031c14]/90 via-[#031c14]/50 to-[#fbfbf9]"></div>
      
      <!-- 3. Sisipan Animasi Glow Halus -->
      <div class="absolute inset-0 cinematic-bg mix-blend-color-dodge opacity-20"></div>
      
      <!-- 4. Islamic Geometric Pattern Overlay -->
      <div class="absolute inset-0 islamic-pattern opacity-60"></div>
      
      <!-- 5. Decorative Glowing Circles -->
      <div class="absolute -top-40 -left-40 w-96 h-96 bg-[#dfb15b] rounded-full blur-[140px] opacity-20 pointer-events-none"></div>
      <div class="absolute bottom-10 right-10 w-[500px] h-[500px] bg-green-500 rounded-full blur-[160px] opacity-10 pointer-events-none"></div>
    </div>

    <!-- Konten Hero Utama -->
    <div class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center flex flex-col items-center" data-aos="zoom-in" data-aos-duration="1500">
      
      <style>
        @keyframes gradientMove {
          0% { background-position: 0% 50%; }
          50% { background-position: 100% 50%; }
          100% { background-position: 0% 50%; }
        }
        .cinematic-bg {
          background: linear-gradient(-45deg, #043427, #064e3b, #0c1815, #043427);
          background-size: 300% 300%;
          animation: gradientMove 15s ease infinite;
        }

        .islamic-pattern {
          background-image: url("data:image/svg+xml,%3Csvg width='40' height='40' viewBox='0 0 40 40' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='%23dfb15b' fill-opacity='0.03' fill-rule='evenodd'%3E%3Cpath d='M20 0l4.5 11 11-4.5-4.5 11 11 4.5-11 4.5 4.5 11-11-4.5-4.5 11-4.5-11-11 4.5 4.5-11-11-4.5 11-4.5-4.5-11 11 4.5z'/%3E%3C/g%3E%3C/svg%3E");
        }

        @keyframes gracefulReveal {
          0% { opacity: 0; transform: translateY(40px) scale(0.95); filter: blur(12px); }
          100% { opacity: 1; transform: translateY(0) scale(1); filter: blur(0); }
        }
        .animate-reveal {
          opacity: 0;
          animation: gracefulReveal 1.2s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
        }

        .delay-200 { animation-delay: 200ms; }
        .delay-400 { animation-delay: 400ms; }
        .delay-600 { animation-delay: 600ms; }
        .delay-800 { animation-delay: 800ms; }
        
        @keyframes textShimmer {
          0% { background-position: 0% center; }
          100% { background-position: -200% center; }
        }
        .text-flow {
          background-size: 200% auto;
          animation: textShimmer 4s linear infinite;
        }

        @keyframes floatSmooth {
          0%, 100% { transform: translateY(0); }
          50% { transform: translateY(-8px); }
        }
        .animate-float {
          animation: floatSmooth 6s ease-in-out infinite;
        }

        @keyframes shine {
          0% { background-position: -200% center; }
          100% { background-position: 200% center; }
        }
        .animate-shine {
          background-size: 200% auto;
          animation: shine 6s linear infinite;
        }

        @keyframes pulseGlow {
          0%, 100% { filter: drop-shadow(0 0 20px rgba(223,177,91,0.3)); transform: scale(1); }
          50% { filter: drop-shadow(0 0 40px rgba(223,177,91,0.6)); transform: scale(1.02); }
        }
        .animate-pulse-glow {
          display: inline-block;
          animation: pulseGlow 4s ease-in-out infinite;
        }

        @keyframes expandLetters {
          0%, 100% { letter-spacing: 0.15em; opacity: 0.7; }
          50% { letter-spacing: 0.25em; opacity: 1; }
        }
        .animate-expand {
          display: inline-block;
          animation: expandLetters 5s ease-in-out infinite;
        }
      </style>

      <!-- Sambutan Animasi Multi-Bahasa Premium -->
      <div class="animate-reveal delay-200 flex items-center justify-center gap-3 sm:gap-5 mb-8">
        <div class="hidden sm:flex items-center gap-1.5 opacity-70">
          <div class="h-[1px] w-6 md:w-16 bg-gradient-to-r from-transparent to-[#dfb15b]"></div>
          <div class="h-[4px] w-2 md:w-3 rounded-full bg-[#dfb15b]"></div>
        </div>
        
        <div class="relative overflow-hidden inline-flex items-center justify-center bg-white/5 backdrop-blur-xl px-8 py-3 sm:py-3.5 rounded-full border border-white/10 shadow-[0_0_40px_rgba(223,177,91,0.15)] w-[280px] sm:w-[340px] md:w-[400px] h-12 sm:h-14 group">
          <div class="absolute inset-0 bg-gradient-to-r from-transparent via-[#dfb15b]/10 to-transparent -translate-x-full group-hover:translate-x-full transition-transform duration-1000 ease-in-out"></div>
          
          <div id="welcome-text" class="absolute flex items-center justify-center gap-2 sm:gap-3 transition-all duration-[800ms] ease-[cubic-bezier(0.87,0,0.13,1)] transform translate-y-0 opacity-100 blur-none scale-100 w-full text-[#dfb15b] font-bold tracking-[0.15em] sm:tracking-[0.25em] text-xs sm:text-sm md:text-base uppercase drop-shadow-[0_0_10px_rgba(223,177,91,0.3)]">
            <span>Selamat Datang Di</span>
          </div>
        </div>

        <div class="hidden sm:flex items-center gap-1.5 opacity-70">
          <div class="h-[4px] w-2 md:w-3 rounded-full bg-[#dfb15b]"></div>
          <div class="h-[1px] w-6 md:w-16 bg-gradient-to-l from-transparent to-[#dfb15b]"></div>
        </div>
      </div>

      <!-- Headline Premium -->
      <h1 class="text-4xl sm:text-6xl md:text-7xl lg:text-[6.5rem] font-display tracking-tighter text-white leading-none mb-6 relative group cursor-default">
        <!-- Baris 1: Pondok Pesantren -->
        <span class="block text-[0.4em] md:text-[0.45em] font-medium tracking-[0.2em] uppercase text-[#dfb15b] mb-2 animate-reveal opacity-0 transition-all duration-700 group-hover:tracking-[0.3em] group-hover:text-yellow-400" style="animation-delay: 400ms;">
          Pondok Pesantren
        </span>
        
        <!-- Baris 2: Nailul Khoir (Utama) -->
        <div class="relative inline-block animate-reveal opacity-0 transition-all duration-700 group-hover:scale-[1.02]" style="animation-delay: 700ms;">
          <strong class="block font-black text-transparent bg-clip-text bg-gradient-to-r from-yellow-100 via-white to-[#dfb15b] pb-4 filter drop-shadow-[0_10px_10px_rgba(0,0,0,0.5)] leading-[0.9] transition-all duration-700 group-hover:drop-shadow-[0_0_30px_rgba(223,177,91,0.4)]">
            Nailul Khoir
          </strong>
          
          <!-- Efek Glow Belakang Teks (Glow Halus) -->
          <div class="absolute -inset-4 bg-[#dfb15b]/10 blur-[60px] rounded-full opacity-0 group-hover:opacity-100 transition-opacity duration-1000 pointer-events-none -z-10"></div>
        </div>

        <!-- Dekorasi Garis Bawah Premium -->
        <div class="h-1 w-32 md:w-48 bg-gradient-to-r from-transparent via-[#dfb15b] to-transparent mx-auto mt-4 animate-reveal opacity-0" style="animation-delay: 1.2s;"></div>
      </h1>

      <!-- Slogan -->
      <div class="animate-reveal delay-800 w-full px-2 sm:px-0">
        <p class="animate-float text-sm sm:text-lg md:text-xl text-green-100/90 font-medium max-w-3xl mx-auto mb-8 sm:mb-12 leading-relaxed italic drop-shadow-md">
          "Terwujudnya kader muslim yang kaya akan ilmu, tangguh dalam aqidah, dan mulia dengan akhlaqul karimah."
        </p>
      </div>

      <!-- Tombol Aksi -->
      <div class="animate-reveal delay-1000 flex flex-col sm:flex-row gap-4 sm:gap-6 justify-center items-center w-full sm:w-auto relative z-20">
        <a href="/pendaftaran" class="w-full sm:w-auto relative group overflow-hidden bg-gradient-to-tr from-yellow-500 via-[#dfb15b] to-yellow-300 text-[#031c14] font-black px-8 py-3.5 sm:px-12 sm:py-5 rounded-full btn-glow transition-all duration-500 text-base sm:text-lg flex items-center justify-center shadow-[0_15px_40px_rgba(223,177,91,0.35)] hover:shadow-[0_20px_50px_rgba(223,177,91,0.5)] hover:scale-105 active:scale-95">
          <span class="relative z-10 flex items-center gap-2">
            Pendaftaran Baru 
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 group-hover:translate-x-1.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
          </span>
          <div class="absolute inset-0 bg-white/40 translate-y-full group-hover:translate-y-0 transition-transform duration-300 ease-in-out"></div>
        </a>
        <a href="/tentang" class="w-full sm:w-auto text-white border border-white/20 hover:bg-white/10 hover:border-white/50 font-bold px-8 py-3.5 sm:px-12 sm:py-5 rounded-full transition-all duration-500 flex items-center justify-center gap-3 backdrop-blur-md shadow-[0_0_20px_rgba(255,255,255,0.05)] hover:shadow-[0_0_30px_rgba(255,255,255,0.15)] hover:-translate-y-1">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-[#dfb15b]" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
          Profil Yayasan
        </a>
      </div>
    </div>
    
    <!-- Partikel Dekoratif -->
    <div class="absolute inset-0 z-0 pointer-events-none opacity-40 mix-blend-screen">
       <div class="absolute top-[25%] left-[10%] w-3 h-3 rounded-full bg-[#dfb15b] shadow-[0_0_20px_rgba(223,177,91,1)] animate-pulse"></div>
       <div class="absolute top-[65%] right-[15%] w-4 h-4 rounded-full bg-white opacity-40 shadow-[0_0_20px_rgba(255,255,255,1)] animate-pulse delay-700"></div>
       <div class="absolute bottom-[25%] left-[25%] w-2 h-2 rounded-full bg-yellow-200 shadow-[0_0_15px_rgba(223,177,91,1)] animate-ping"></div>
    </div>
  </section>

  <!-- HIGHLIGHT PENDIDIKAN (Modern Ivory & Glassmorphism Cards) -->
  <section class="py-24 bg-[#fbfbf9] relative overflow-hidden">
    <!-- Dekorasi Latar -->
    <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-green-50/50 rounded-full blur-[100px] -translate-y-1/2 translate-x-1/3 pointer-events-none"></div>
    <div class="absolute bottom-0 left-0 w-[600px] h-[600px] bg-[#dfb15b]/5 rounded-full blur-[120px] translate-y-1/3 -translate-x-1/3 pointer-events-none"></div>
    
    <!-- Repeating Star Overlay (Subtle) -->
    <div class="absolute inset-0 islamic-pattern opacity-30 pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="text-center mb-20" data-aos="fade-up">
        <span class="inline-block py-1.5 px-4 rounded-full bg-green-50 border border-green-200/50 text-[#064e3b] text-sm font-bold tracking-widest mb-4">
          PENDIDIKAN TERPADU
        </span>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-display font-black tracking-tight text-gray-900 mb-6 px-4">
          Pilihan Program Belajar Formal & Informal
        </h2>
        <div class="h-1.5 w-32 bg-[#dfb15b] mx-auto rounded-full"></div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-10">
        <!-- Card Pondok -->
        <a href="/pondok" class="group relative bg-white/60 backdrop-blur-md rounded-3xl p-6 sm:p-10 shadow-xl hover:shadow-[0_20px_50px_rgba(6,78,59,0.15)] transition-all duration-500 border border-gray-200/50 hover:border-[#064e3b]/30 hover:-translate-y-3 overflow-hidden text-center" data-aos="fade-up" data-aos-delay="0">
          <div class="absolute top-0 left-0 w-full h-2.5 bg-gradient-to-r from-green-700 to-[#064e3b]"></div>
          <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-40 h-40 bg-green-50/50 rounded-full blur-3xl group-hover:bg-green-50 transition-colors duration-500 pointer-events-none"></div>
          <div class="w-24 h-24 bg-gradient-to-br from-green-50 to-white rounded-3xl flex items-center justify-center mx-auto mb-8 shadow-md border border-green-100 group-hover:scale-110 transition-transform duration-500 relative z-10">
            <img src="/images/logo.png" alt="Logo Pondok Pesantren" class="w-16 h-16 object-contain" loading="lazy" decoding="async" />
          </div>
          <h3 class="text-3xl font-display font-black text-gray-900 mb-4 tracking-tight relative z-10 group-hover:text-[#064e3b] transition-colors">Pondok Pesantren Salafiyah</h3>
          <p class="text-gray-600 mb-8 font-medium leading-relaxed relative z-10 text-sm">Pendidikan salaf murni berfokus kepada takhassus tahfidz Al-Qur'an dan kajian kitab kuning komprehensif.</p>
          <div class="inline-flex items-center text-[#064e3b] font-black relative z-10 group-hover:underline justify-center text-sm">
            Lihat Program <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-2 group-hover:translate-x-2 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
          </div>
        </a>

        <!-- Card SMPIT -->
        <a href="/smp" class="group relative bg-white/60 backdrop-blur-md rounded-3xl p-6 sm:p-10 shadow-xl hover:shadow-[0_20px_50px_rgba(59,130,246,0.15)] transition-all duration-500 border border-gray-200/50 hover:border-blue-500/30 hover:-translate-y-3 overflow-hidden text-center" data-aos="fade-up" data-aos-delay="100">
          <div class="absolute top-0 left-0 w-full h-2.5 bg-gradient-to-r from-blue-500 to-blue-700"></div>
          <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-40 h-40 bg-blue-50/50 rounded-full blur-3xl group-hover:bg-blue-50 transition-colors duration-500 pointer-events-none"></div>
          <div class="w-24 h-24 bg-white rounded-3xl flex items-center justify-center mx-auto mb-8 shadow-md border border-blue-100 group-hover:scale-110 transition-transform duration-500 relative z-10">
            <img src="/images/logo-smp.png" alt="Logo SMP" class="w-16 h-16 object-contain" loading="lazy" decoding="async" />
          </div>
          <h3 class="text-3xl font-display font-black text-gray-900 mb-4 tracking-tight relative z-10 group-hover:text-blue-600 transition-colors">SMP IT Nailul Khoir</h3>
          <p class="text-gray-600 mb-8 font-medium leading-relaxed relative z-10 text-sm">Sekolah Menengah Pertama Islam Terpadu dengan kurikulum nasional and nilai kepesantrenan kuat.</p>
          <div class="inline-flex items-center text-blue-600 font-black relative z-10 group-hover:underline justify-center text-sm">
            Lihat Kurikulum <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-2 group-hover:translate-x-2 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
          </div>
        </a>
        
        <!-- Card SMK -->
        <a href="/smk" class="group relative bg-white/60 backdrop-blur-md rounded-3xl p-6 sm:p-10 shadow-xl hover:shadow-[0_20px_50px_rgba(245,158,11,0.15)] transition-all duration-500 border border-gray-200/50 hover:border-orange-500/30 hover:-translate-y-3 overflow-hidden text-center" data-aos="fade-up" data-aos-delay="200">
          <div class="absolute top-0 left-0 w-full h-2.5 bg-gradient-to-r from-orange-500 to-orange-700"></div>
          <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-40 h-40 bg-orange-50/50 rounded-full blur-3xl group-hover:bg-orange-50 transition-colors duration-500 pointer-events-none"></div>
          <div class="w-24 h-24 bg-white rounded-3xl flex items-center justify-center mx-auto mb-8 shadow-md border border-orange-100 group-hover:scale-110 transition-transform duration-500 relative z-10">
            <img src="/images/logo-smk.png" alt="Logo SMK" class="w-16 h-16 object-contain" loading="lazy" decoding="async" />
          </div>
          <h3 class="text-3xl font-display font-black text-gray-900 mb-4 tracking-tight relative z-10 group-hover:text-orange-600 transition-colors">SMK Nailul Khoir</h3>
          <p class="text-gray-600 mb-8 font-medium leading-relaxed relative z-10 text-sm">Mencetak tenaga IT profesional yang siap menghadapi dunia industri dengan landasan akhlak mulia.</p>
          <div class="inline-flex items-center text-orange-600 font-black relative z-10 group-hover:underline justify-center text-sm">
            Lihat Jurusan <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-2 group-hover:translate-x-2 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- SEPARATOR GALERI MARQUEE -->
  <MarqueeGaleri />

  <!-- BERITA TERBARU (Dinamis dari Supabase) -->
  <section class="py-24 bg-white relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col sm:flex-row justify-between items-center sm:items-end mb-16 text-center sm:text-left" data-aos="fade-up">
        <div class="w-full sm:w-auto">
          <span class="inline-block py-1.5 px-4 rounded-full bg-yellow-50 border border-yellow-200 text-[#dfb15b] text-sm font-bold tracking-wide mb-4">
            INFORMASI PUBLIK
          </span>
          <h2 class="text-4xl sm:text-5xl font-display font-black tracking-tight text-gray-900">
            Kabar Terbaru
          </h2>
        </div>
        <a href="/berita" class="hidden sm:inline-flex items-center gap-2 text-[#064e3b] font-bold hover:bg-green-50 px-5 py-2.5 rounded-full transition-colors border border-transparent hover:border-green-200">
          Lebih Banyak Berita <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M12.293 5.293a1 1 0 011.414 0l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-2.293-2.293a1 1 0 010-1.414z" clip-rule="evenodd" /></svg>
        </a>
      </div>

      {beritaList.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {beritaList.map((berita, i) => (
             <div class="h-full flex hover:-translate-y-2 transition-transform duration-500" data-aos="fade-up" data-aos-delay={i * 150}>
               <CardBerita 
                 id={berita.id}
                 judul={berita.judul} 
                 foto_url={berita.foto_url} 
                 description={berita.description} 
                 tanggal={berita.tanggal_berita} 
               />
             </div>
          ))}
        </div>
      ) : (
        <div class="bg-gray-50 rounded-3xl p-16 text-center border-2 border-dashed border-gray-200" data-aos="fade-in">
          <div class="w-20 h-20 bg-white rounded-full flex items-center justify-center mx-auto mb-6 shadow-sm">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-gray-300" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" /></svg>
          </div>
          <p class="text-gray-900 font-bold text-2xl mb-2">Belum Ada Publikasi Baru</p>
          <p class="text-gray-500 max-w-md mx-auto text-sm">Nantikan liputan, artikel, dan informasi kegiatan terbaru dari pesantren kami.</p>
        </div>
      )}
      
      <div class="mt-10 text-center sm:hidden">
        <a href="/berita" class="inline-flex items-center gap-2 text-[#064e3b] font-bold hover:bg-green-50 px-6 py-3 rounded-full transition-colors border border-green-100 bg-white shadow-sm">
          Lebih Banyak Berita <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M12.293 5.293a1 1 0 011.414 0l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-2.293-2.293a1 1 0 010-1.414z" clip-rule="evenodd" /></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- TESTIMONI (Social Proof) -->
  <TestimonialSlider />

  <!-- JADWAL KAJIAN (Dinamis dari Supabase - Islamic Luxury Background) -->
  <section class="py-24 bg-gradient-to-b from-[#052c21] to-[#02130e] text-white relative overflow-hidden">
    <!-- Dekorasi Latar -->
    <div class="absolute -top-40 -right-40 w-96 h-96 bg-[#dfb15b]/10 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-40 -left-40 w-96 h-96 bg-[#064e3b]/30 rounded-full blur-3xl pointer-events-none"></div>
    
    <!-- Islamic Geometric Pattern Overlay -->
    <div class="absolute inset-0 islamic-pattern opacity-60"></div>
    
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="text-center mb-16" data-aos="fade-in">
        <h2 class="text-base text-[#dfb15b] font-bold tracking-widest uppercase mb-4">Majelis Taklim Umum</h2>
        <p class="text-4xl sm:text-5xl font-display font-black tracking-tight text-white">
          Jadwal Kajian Pesantren
        </p>
        <div class="h-1 w-24 bg-gradient-to-r from-transparent via-[#dfb15b] to-transparent mx-auto mt-6"></div>
      </div>

      {kajianList.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-12">
          {kajianList.map((kajian, i) => (
            <div class="bg-white/5 backdrop-blur-md rounded-3xl p-4 border border-white/10 overflow-hidden flex flex-col sm:flex-row shadow-[0_20px_50px_rgba(0,0,0,0.5)] hover:bg-white/10 hover:border-[#dfb15b]/30 transition-all duration-500 group" data-aos="fade-up" data-aos-delay={i * 150}>
              <div class="w-full sm:w-2/5 h-48 sm:h-auto rounded-2xl overflow-hidden shadow-inner relative shrink-0">
                {kajian.foto_url ? (
                  <img src={kajian.foto_url} alt={kajian.judul} class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700" loading="lazy" />
                ) : (
                  <div class="w-full h-full bg-gradient-to-br from-[#064e3b] to-[#02130e] flex items-center justify-center">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16 text-white/20" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" /></svg>
                  </div>
                )}
                <!-- Overlay Label -->
                <div class="absolute top-3 left-3 bg-[#dfb15b]/90 backdrop-blur text-[#031c14] text-xs font-black uppercase px-3 py-1.5 rounded-full shadow-lg">Rutinan</div>
              </div>
              
              <div class="p-6 sm:p-8 flex flex-col justify-center flex-grow">
                <h3 class="text-2xl font-display font-black text-yellow-50 mb-3 tracking-tight group-hover:text-[#dfb15b] transition-colors">{kajian.judul}</h3>
                <div class="text-gray-300 flex-grow font-medium leading-relaxed mb-6 prose prose-sm prose-invert max-w-none text-sm" set:html={kajian.description}></div>
                <div class="flex items-center text-[#dfb15b] font-bold text-xs bg-[#dfb15b]/10 w-max px-4 py-2 rounded-full border border-[#dfb15b]/20">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4.5 w-4.5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
                  Terbuka Untuk Umum
                </div>
              </div>
            </div>
          ))}
        </div>
      ) : (
        <!-- Default State Jika Belum Ada Kajian -->
        <div class="bg-white/5 backdrop-blur-sm rounded-3xl p-16 text-center border border-white/10 max-w-2xl mx-auto shadow-2xl">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-20 w-20 text-white/20 mx-auto mb-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
          <p class="text-white font-black text-2xl mb-2">Belum Ada Agenda Terekam</p>
          <p class="text-gray-400 font-medium text-sm">Jadwal majelis taklim dan pengajian rutin akan segera diperbarui di sini oleh dewan asatidz kami.</p>
        </div>
      )}
      
      <div class="mt-12 text-center" data-aos="fade-up">
        <a href="/kajian" class="inline-flex items-center gap-2 text-gray-900 font-bold hover:bg-yellow-400 px-8 py-3.5 rounded-full transition-colors bg-[#dfb15b] shadow-lg shadow-[#dfb15b]/20 hover:shadow-yellow-400/40">
          Lihat Semua Jadwal Kajian <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M12.293 5.293a1 1 0 011.414 0l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-2.293-2.293a1 1 0 010-1.414z" clip-rule="evenodd" /></svg>
        </a>
      </div>
    </div>
  </section>

  <script>
    document.addEventListener("DOMContentLoaded", () => {
      // Data Teks Multi-Bahasa Modern
      const languages = ["Selamat Datang Di", "Wilujeng Sumping Di", "Sugeng Rawuh Ing"];
      let currentIndex = 0;
      
      const welcomeContainer = document.getElementById("welcome-text");
      const welcomeTextSpan = welcomeContainer ? welcomeContainer.querySelector("span") : null;

      if (welcomeContainer && welcomeTextSpan) {
        setInterval(() => {
          // 1. Animasi Menghilang Lembut (Slide Up, Fade Out, Blur)
          welcomeContainer.classList.remove("translate-y-0", "opacity-100", "blur-none", "scale-100");
          welcomeContainer.classList.add("-translate-y-6", "opacity-0", "blur-md", "scale-95");
          
          setTimeout(() => {
            // 2. Ubah Teks saat container tidak terlihat
            currentIndex = (currentIndex + 1) % languages.length;
            welcomeTextSpan.textContent = languages[currentIndex];
            
            // 3. Reset posisi ke bawah tanah SEKETIKA tanpa animasi
            welcomeContainer.style.transition = 'none';
            welcomeContainer.classList.remove("-translate-y-6");
            welcomeContainer.classList.add("translate-y-6");
            
            // Force Reflow DOM (Penting agar browser menyadari pindah posisi)
            void welcomeContainer.offsetWidth;
            
            // 4. Animasi Muncul Lembut (Slide Up ke pusat, Fade In, Unblur)
            welcomeContainer.style.transition = '';
            welcomeContainer.classList.remove("translate-y-6", "opacity-0", "blur-md", "scale-95");
            welcomeContainer.classList.add("translate-y-0", "opacity-100", "blur-none", "scale-100");
          }, 800); // sinkron dengan durasi CSS transisi
        }, 3500); // 3.5 detik per rotasi
      }
    });
  </script>
</MainLayout>
