---
import MainLayout from '../layouts/MainLayout.astro';
import CardBerita from '../components/CardBerita.astro';
import { supabase } from '../lib/supabase.js';

// Mengambil 3 berita terbaru dari tabel Supabase
const { data: beritaData, error } = await supabase
  .from('berita')
  .select('*')
  .order('tanggal_berita', { ascending: false })
  .limit(3);

const beritaList = beritaData || [];

// Mengambil data kajian
const { data: kajianData } = await supabase
  .from('kajian')
  .select('*')
  .limit(4);

const kajianList = kajianData || [];

// Mengambil URL Latar Belakang Hero Image (Bila ada yang diatur lewat Admin)
// Jika tidak ada pengaturan_web di Supabase, default fallback adalah hero-bg.jpg bawaan template
let heroBgUrl = '/images/hero-bg.jpg';
try {
  const { data: heroSetting } = await supabase
    .from('pengaturan_web')
    .select('value')
    .eq('key', 'hero_bg_url')
    .single();

  if (heroSetting && heroSetting.value) {
    heroBgUrl = heroSetting.value;
  }
} catch (e) {
  // Abaikan error jika tabel pengaturan_web belum di-set di DB
}
---

<MainLayout title="Beranda">
  <!-- Hero Section -->
  <section class="relative bg-pesantren text-white overflow-hidden">
    <!-- Background Image yang di-render secara dinamis dari Database atau Default Template -->
    <img src={heroBgUrl} alt="Pondok Pesantren Background" class="absolute inset-0 w-full h-full object-cover z-0" />
    
    <!-- Overlay gradien untuk menggelapkan gambar agar teks tetap terbaca -->
    <div class="absolute inset-0 bg-gradient-to-r from-green-900/90 to-pesantren/90 z-0 mix-blend-multiply"></div>
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24 md:py-32 flex flex-col items-center text-center">
      <style>
        @keyframes fadeInUp {
          from { opacity: 0; transform: translateY(30px) scale(0.95); }
          to { opacity: 1; transform: translateY(0) scale(1); }
        }
        @keyframes fadeInSlow {
          from { opacity: 0; filter: blur(4px); }
          to { opacity: 1; filter: blur(0); }
        }
        .animate-title {
          animation: fadeInUp 1.2s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
        }
        .animate-subtitle {
          animation: fadeInSlow 1.5s ease-out 0.6s forwards;
          opacity: 0;
        }
      </style>

      <h1 class="animate-title text-4xl md:text-6xl font-extrabold tracking-tight mb-6 text-emas drop-shadow-2xl">
        Yayasan Pondok Pesantren<br />
        <span class="text-white relative inline-block">Nailul Khoir Majalengka
          <!-- Garis bawah berkilau -->
          <span class="absolute -bottom-2 md:-bottom-4 left-0 w-full h-1 md:h-1.5 bg-gradient-to-r from-transparent via-emas to-transparent opacity-80 backdrop-blur-sm rounded-full"></span>
        </span>
      </h1>
      <p class="animate-subtitle mt-6 md:mt-10 text-xl md:text-2xl max-w-4xl text-green-50 font-medium mb-10 leading-relaxed drop-shadow-md italic">
        "Terwujudnya Kader Muslim Yang Kaya Akan Ilmu Kuat Dalam Aqidah dan Berakhlaqul Karimah"
      </p>
      <div class="flex flex-col sm:flex-row gap-4">
        <a href="/pendaftaran" class="bg-emas text-pesantren hover:bg-yellow-400 font-bold px-8 py-4 rounded-full shadow-xl transition-all hover:scale-105">
          Daftar Sekarang
        </a>
        <a href="/tentang" class="bg-transparent border-2 border-white hover:bg-white hover:text-pesantren font-bold px-8 py-4 rounded-full shadow-lg transition-all">
          Kenali Kami Lebih Dekat
        </a>
      </div>
    </div>
    
    <!-- Hiasan gelombang bawah -->
    <div class="absolute bottom-0 w-full overflow-hidden leading-none">
      <svg class="relative block w-full h-12 md:h-24" data-name="Layer 1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 120" preserveAspectRatio="none">
        <path d="M321.39,56.44c58-10.79,114.16-30.13,172-41.86,82.39-16.72,168.19-17.73,250.45-.39C823.78,31,906.67,72,985.66,92.83c70.05,18.48,146.53,26.09,214.34,3V120H0V95.8C59.71,118.08,130.83,119.28,189.7,100.2,235.8,85.12,278.49,70.52,321.39,56.44Z" fill="#f9fafb"></path>
      </svg>
    </div>
  </section>

  <!-- Highlight Pendidikan -->
  <section class="py-16 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-base text-pesantren font-bold tracking-wide uppercase">Pendidikan Terpadu</h2>
        <p class="mt-2 text-3xl leading-8 font-extrabold tracking-tight text-gray-900 sm:text-4xl">
          Layanan Pendidikan Kami
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Card SMPIT -->
        <div class="bg-white rounded-2xl p-8 shadow-lg hover:shadow-xl transition-shadow border-t-4 border-pesantren text-center">
          <div class="w-20 h-20 bg-white rounded-full flex items-center justify-center mx-auto mb-6 shadow-sm p-1 border border-green-200 transition-transform hover:scale-110">
            <img src="/images/logo-smp.png" alt="Logo SMP" class="w-full h-full object-contain mix-blend-multiply" />
          </div>
          <h3 class="text-2xl font-bold text-gray-900 mb-4">SMPIT Nailul Khoir</h3>
          <p class="text-gray-600 mb-6">Sekolah Menengah Pertama Islam Terpadu dengan kurikulum nasional dan kepesantrenan.</p>
          <a href="/smp" class="text-pesantren font-bold hover:underline">Pelajari Kurikulum &rarr;</a>
        </div>
        
        <!-- Card SMK -->
        <div class="bg-white rounded-2xl p-8 shadow-lg hover:shadow-xl transition-shadow border-t-4 border-emas text-center">
          <div class="w-20 h-20 bg-white rounded-full flex items-center justify-center mx-auto mb-6 shadow-sm p-1 border border-yellow-200 transition-transform hover:scale-110">
            <img src="/images/logo-smk.png" alt="Logo SMK" class="w-full h-full object-contain mix-blend-multiply" />
          </div>
          <h3 class="text-2xl font-bold text-gray-900 mb-4">SMK Nailul Khoir</h3>
          <p class="text-gray-600 mb-6">Sekolah Menengah Kejuruan berorientasi pada teknologi informasi dan kewirausahaan santri.</p>
          <a href="/smk" class="text-pesantren font-bold hover:underline">Pelajari Jurusan &rarr;</a>
        </div>

        <!-- Card Pondok -->
        <div class="bg-white rounded-2xl p-8 shadow-lg hover:shadow-xl transition-shadow border-t-4 border-pesantren text-center">
          <div class="w-16 h-16 bg-white rounded-full flex items-center justify-center mx-auto mb-6 shadow-sm p-2 border border-green-100 transition-transform hover:scale-110">
            <img src="/images/logo.png" alt="Logo Pondok Pesantren" class="w-full h-full object-contain" />
          </div>
          <h3 class="text-2xl font-bold text-gray-900 mb-4">Pondok Pesantren</h3>
          <p class="text-gray-600 mb-6">Pendidikan murni kepesantrenan, tahfidz Al-Qur'an, dan kajian kitab kuning Salafiyah.</p>
          <a href="/pondok" class="text-pesantren font-bold hover:underline">Pelajari Program &rarr;</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Berita Terbaru -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex justify-between items-end mb-10">
        <div>
          <h2 class="text-base text-emas font-bold tracking-wide uppercase">Informasi & Update</h2>
          <p class="mt-2 text-3xl leading-8 font-extrabold tracking-tight text-gray-900 sm:text-4xl">
            Berita Terbaru
          </p>
        </div>
        <a href="#" class="hidden sm:inline-block text-pesantren font-bold hover:border-b-2 hover:border-pesantren pb-1">
          Lihat Semua Berita &rarr;
        </a>
      </div>

      {beritaList.length > 0 ? (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
          {beritaList.map((berita) => (
             <CardBerita 
               judul={berita.judul} 
               foto_url={berita.foto_url} 
               description={berita.description} 
               tanggal={berita.tanggal_berita} 
             />
          ))}
        </div>
      ) : (
        <div class="bg-gray-50 rounded-xl p-10 text-center border border-gray-100">
          <p class="text-gray-500 font-medium text-lg">Belum ada berita yang diterbitkan.</p>
          <p class="text-gray-400 mt-2">Nantikan informasi terbaru dari Yayasan Pondok Pesantren Nailul Khoir.</p>
        </div>
      )}
      
      <div class="mt-8 text-center sm:hidden">
        <a href="#" class="inline-block text-pesantren font-bold hover:underline">
          Lihat Semua Berita &rarr;
        </a>
      </div>
    </div>
  </section>

  <!-- Jadwal Kajian & Taklim -->
  <section class="py-16 bg-green-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-base text-emas font-bold tracking-wide uppercase">Kajian Kitab Kuning</h2>
        <p class="mt-2 text-3xl leading-8 font-extrabold tracking-tight text-pesantren sm:text-4xl">
          Jadwal Majelis Taklim
        </p>
      </div>

      {kajianList.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          {kajianList.map((kajian) => (
            <div class="bg-white rounded-2xl shadow-md overflow-hidden flex flex-col sm:flex-row hover:shadow-lg transition-shadow border-l-4 border-emas">
              {kajian.foto_url && (
                <div class="w-full sm:w-1/3 bg-gray-200 shrink-0 h-48 sm:h-auto">
                  <img src={kajian.foto_url} alt={kajian.judul} class="w-full h-full object-cover" loading="lazy" />
                </div>
              )}
              <div class="p-6 flex flex-col justify-center flex-grow">
                <h3 class="text-xl font-bold text-gray-900 mb-2">{kajian.judul}</h3>
                <div class="text-gray-600 whitespace-pre-wrap flex-grow text-sm mb-4 leading-relaxed">{kajian.description}</div>
                <div class="flex items-center text-pesantren font-bold text-xs">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                  Rutinan Pesantren Terbuka
                </div>
              </div>
            </div>
          ))}
        </div>
      ) : (
        <div class="bg-white rounded-xl p-10 text-center border border-gray-100 shadow-sm">
          <p class="text-gray-500 font-medium my-2">Belum ada agenda kajian yang dijadwalkan.</p>
        </div>
      )}
    </div>
  </section>
</MainLayout>
