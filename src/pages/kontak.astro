---
import MainLayout from '../layouts/MainLayout.astro';
---
<MainLayout title="Kontak Kami - Yayasan PP Nailul Khoir">
  <!-- Premium Hero Section -->
  <div class="relative bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-green-800 via-pesantren to-[#052e1f] py-24 overflow-hidden">
    <div class="absolute inset-0 bg-[url('https://www.transparenttextures.com/patterns/cubes.png')] opacity-10 mix-blend-overlay"></div>
    <div class="absolute inset-0 bg-gradient-to-b from-transparent to-[#f8fafc]"></div>
    
    <div class="max-w-4xl mx-auto px-4 mt-8 relative z-10 text-center" data-aos="zoom-in" data-aos-duration="1000">
      <div class="w-24 h-24 bg-white/10 backdrop-blur-md rounded-full flex items-center justify-center mx-auto mb-6 shadow-xl p-2 border border-emas/50 hover:rotate-12 transition-transform duration-500">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-emas drop-shadow-md" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
      </div>
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-display font-black mb-6 text-transparent bg-clip-text bg-gradient-to-r from-yellow-300 via-emas to-yellow-500 drop-shadow-md tracking-tight">Hubungi Kami</h1>
      <p class="text-xl md:text-2xl text-green-50 font-light max-w-2xl mx-auto drop-shadow-md leading-relaxed">Pintu komunikasi kami senantiasa terbuka lebar untuk berdiskusi seputar layanan pendidikan dan pendaftaran.</p>
    </div>
  </div>

  <!-- Content Section -->
  <div class="max-w-6xl mx-auto px-4 py-16 -mt-10 md:-mt-16 relative z-20">
    <div class="bg-white rounded-[2rem] shadow-[0_20px_60px_rgba(0,0,0,0.06)] border border-gray-100 overflow-hidden flex flex-col md:flex-row-reverse" data-aos="fade-up">
      
      <!-- Formulir Pesan (Kanan) -->
      <div class="md:w-3/5 p-8 md:p-12 lg:p-16 relative">
        <div class="mb-10 text-center md:text-left">
           <h2 class="text-xs font-bold text-emas uppercase tracking-widest mb-2">Pusat Bantuan</h2>
           <h3 class="text-3xl font-display font-bold text-gray-900 border-b-2 border-green-500/10 pb-4 inline-block">Kirim Pesan Langsung</h3>
        </div>

        <!-- Alert Box -->
        <div id="alertBox" class="hidden mb-6 p-5 rounded-2xl font-medium flex items-start gap-3 border shadow-sm transition-all duration-300">
           <div id="alertIcon" class="mt-0.5"></div>
           <div id="alertMessage" class="flex-1 text-sm"></div>
        </div>

        <form id="formPesan" class="space-y-6">
          <div class="space-y-1">
            <label for="nama_pengirim" class="block text-sm font-bold text-gray-700">Nama Lengkap <span class="text-red-500">*</span></label>
            <div class="relative group">
              <div class="absolute inset-y-0 left-0 flex items-center pl-4 pointer-events-none text-gray-400 group-focus-within:text-pesantren transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" /></svg>
              </div>
              <input type="text" id="nama_pengirim" class="block w-full pl-11 pr-4 py-3.5 bg-gray-50 border border-gray-200 rounded-xl focus:bg-white focus:ring-4 focus:ring-green-500/10 focus:border-pesantren outline-none transition-all duration-300 text-gray-700 placeholder-gray-400" placeholder="Ex. Fulan bin Fulan" required>
            </div>
          </div>
          
          <div class="space-y-1">
            <label for="kontak_pengirim" class="block text-sm font-bold text-gray-700">Email atau No. WhatsApp <span class="text-red-500">*</span></label>
            <div class="relative group">
              <div class="absolute inset-y-0 left-0 flex items-center pl-4 pointer-events-none text-gray-400 group-focus-within:text-pesantren transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
              </div>
              <input type="text" id="kontak_pengirim" class="block w-full pl-11 pr-4 py-3.5 bg-gray-50 border border-gray-200 rounded-xl focus:bg-white focus:ring-4 focus:ring-green-500/10 focus:border-pesantren outline-none transition-all duration-300 text-gray-700 placeholder-gray-400" placeholder="Ex. fulan@email.com / 0812..." required>
            </div>
          </div>
          
          <div class="space-y-1">
            <label for="isi_pesan" class="block text-sm font-bold text-gray-700">Isi Pesan/Pertanyaan <span class="text-red-500">*</span></label>
            <div class="relative group">
              <div class="absolute top-4 left-0 flex items-start pl-4 pointer-events-none text-gray-400 group-focus-within:text-pesantren transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" /></svg>
              </div>
              <textarea id="isi_pesan" rows="5" class="block w-full pl-11 pr-4 py-4 bg-gray-50 border border-gray-200 rounded-xl focus:bg-white focus:ring-4 focus:ring-green-500/10 focus:border-pesantren outline-none transition-all duration-300 text-gray-700 placeholder-gray-400 resize-none leading-relaxed" placeholder="Tuliskan keluhan, saran, atau pertanyaan Anda seputar PPDB di sini..." required></textarea>
            </div>
          </div>

          <!-- Honeypot Anti-Spam (Tersembunyi) -->
          <div class="hidden" aria-hidden="true">
            <input type="text" id="bot_check" tabindex="-1" autocomplete="off">
          </div>
          
          <div class="pt-4 border-t border-gray-100">
            <button type="submit" id="btnSubmitPesan" class="w-full bg-gradient-to-r from-pesantren to-green-700 text-white font-bold py-4 px-8 rounded-xl shadow-[0_10px_20px_rgba(4,51,34,0.15)] hover:shadow-[0_15px_30px_rgba(4,51,34,0.25)] transition-all duration-300 hover:-translate-y-1 flex justify-center items-center gap-3 overflow-hidden relative group">
              <span class="absolute inset-0 bg-gradient-to-r from-transparent via-white/20 to-transparent -translate-x-full group-hover:animate-[shimmer_1s_infinite]"></span>
              <svg id="btnIconPesan" xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 relative z-10 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" /></svg>
              <span id="btnText" class="text-lg relative z-10 tracking-wide uppercase">Kirim Pesan Sekarang</span>
              
              <svg id="btnSpinnerPesan" class="animate-spin h-6 w-6 text-white hidden relative z-10" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
              </svg>
            </button>
          </div>
        </form>
      </div>

      <!-- Info Kontak (Kiri) -->
      <div class="md:w-2/5 bg-gradient-to-br from-[#0c2e1f] to-pesantren p-8 md:p-12 text-white relative overflow-hidden flex flex-col justify-between">
        <div class="absolute -top-32 -left-32 w-96 h-96 bg-green-500/20 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute bottom-10 -right-10 w-64 h-64 bg-emas/10 rounded-full blur-3xl pointer-events-none"></div>
        
        <div class="relative z-10">
          <h2 class="text-3xl font-display font-bold text-emas mb-8 drop-shadow-sm">Informasi Kontak</h2>
          
          <div class="space-y-8 mt-4">
            <!-- Alamat -->
            <div class="flex items-start">
              <div class="bg-white/10 backdrop-blur-sm p-3 rounded-full text-emas mr-4 shrink-0 border border-white/20">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
              </div>
              <div>
                <h3 class="font-bold text-gray-100 text-lg">Alamat Kesekretariatan</h3>
                <p class="text-green-50/70 mt-1 leading-relaxed text-sm">
                  Blok Desa, RT 01/RW 01, Desa Panyindangan,<br>
                  Kecamatan Banjaran, Kabupaten Majalengka,<br>
                  Jawa Barat, 45468
                </p>
              </div>
            </div>

            <!-- Telepon -->
            <div class="flex items-start">
              <div class="bg-white/10 backdrop-blur-sm p-3 rounded-full text-emas mr-4 shrink-0 border border-white/20">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
              </div>
              <div>
                <h3 class="font-bold text-gray-100 text-lg">Konsultasi / WA PPDB</h3>
                <p class="mt-1 leading-relaxed"><a href="https://wa.me/6288218336152" target="_blank" class="text-green-50/70 text-sm hover:text-emas hover:underline transition-colors block mb-1">+62 882-1833-6152 (Mang Aan)</a></p>
                <p class="leading-relaxed"><a href="https://wa.me/6285794405083" target="_blank" class="text-green-50/70 text-sm hover:text-emas hover:underline transition-colors block">+62 857-9440-5083 (Panitia PPDB)</a></p>
              </div>
            </div>

            <!-- Email -->
            <div class="flex items-start mb-8">
              <div class="bg-white/10 backdrop-blur-sm p-3 rounded-full text-emas mr-4 shrink-0 border border-white/20">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
              </div>
              <div>
                <h3 class="font-bold text-gray-100 text-lg">Alamat Email</h3>
                <p class="mt-1 leading-relaxed"><a href="mailto:pesantrennailulkhoir@gmail.com" class="text-green-50/70 text-sm hover:text-emas hover:underline transition-colors">pesantrennailulkhoir@gmail.com</a></p>
              </div>
            </div>
          </div>

          <!-- Maps Embed Keren -->
          <div class="mt-auto pt-8 rounded-2xl overflow-hidden shadow-[0_10px_20px_rgba(0,0,0,0.3)] border-2 border-white/10">
            <!-- Peta Asli Majalengka via Iframe -->
            <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d15843.415053744315!2d108.31295245!3d-6.9080760499999995!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x2e6f3d9d6e8b4e7b%3A0x6bbaafe5bae9937b!2sBanjaran%2C%20Kec.%20Banjaran%2C%20Kabupaten%20Majalengka%2C%20Jawa%20Barat!5e0!3m2!1sid!2sid!4v1650000000000!5m2!1sid!2sid" width="100%" height="220" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade" class="opacity-90 hover:opacity-100 transition-opacity"></iframe>
          </div>
        </div>
      </div>
    </div>
  </div>
</MainLayout>

<script>
  import { supabase } from '../lib/supabase.js';

  document.addEventListener('DOMContentLoaded', () => {
    const formPesan = document.getElementById('formPesan') as HTMLFormElement;
    
    if (formPesan) {
      formPesan.addEventListener('submit', async (e) => {
        e.preventDefault();

        // Control Elements
        const btnSubmit = document.getElementById('btnSubmitPesan') as HTMLButtonElement;
        const btnText = document.getElementById('btnText');
        const btnIcon = document.getElementById('btnIconPesan');
        const btnSpinner = document.getElementById('btnSpinnerPesan');
        
        const alertBox = document.getElementById('alertBox');
        const alertIcon = document.getElementById('alertIcon');
        const alertMsg = document.getElementById('alertMessage');

        // Text Inputs
        const namaInput = document.getElementById('nama_pengirim') as HTMLInputElement;
        const kontakInput = document.getElementById('kontak_pengirim') as HTMLInputElement;
        const pesanInput = document.getElementById('isi_pesan') as HTMLTextAreaElement;
        const botCheckInput = document.getElementById('bot_check') as HTMLInputElement;

        // Data Cleanup
        const nama = namaInput.value.trim();
        const kontak = kontakInput.value.trim();
        const pesan = pesanInput.value.trim();

        // Pengecekan Honeypot Anti-Spam
        if (botCheckInput && botCheckInput.value !== '') {
           console.warn('Bot block activated.');
           return; 
        }

        if (!nama || !kontak || !pesan) {
           return;
        }

        // Tampilan Loading UI
        if (btnText) btnText.innerHTML = 'Menyimpan...';
        if (btnIcon) btnIcon.classList.add('hidden');
        if (btnSpinner) btnSpinner.classList.remove('hidden');
        btnSubmit.disabled = true;
        btnSubmit.classList.add('opacity-70', 'cursor-not-allowed', 'scale-[0.98]');
        if (alertBox) { alertBox.classList.add('hidden'); alertBox.className = alertBox.className.replace(/bg-\w+-50 border-\w+-200 text-\w+-800/g, ''); }

        // Operasi POST / API Call Supabase
        const { error } = await supabase
          .from('pesan_masuk')
          .insert([
            {
              nama: nama,
              kontak: kontak,
              pesan: pesan,
              status_baca: false
            }
          ]);

        // Pulihkan UI Button
        if (btnText) btnText.innerHTML = 'Kirim Pesan Sekarang';
        if (btnIcon) btnIcon.classList.remove('hidden');
        if (btnSpinner) btnSpinner.classList.add('hidden');
        btnSubmit.disabled = false;
        btnSubmit.classList.remove('opacity-70', 'cursor-not-allowed', 'scale-[0.98]');

        // Respon Logika Alert
        if (error) {
          console.error('Error insert message:', error);
          if (alertBox && alertIcon && alertMsg) {
             alertBox.classList.remove('hidden');
             alertBox.classList.add('bg-red-50', 'border-red-200', 'text-red-800');
             alertIcon.innerHTML = `<svg class="w-5 h-5 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>`;
             alertMsg.innerHTML = `<strong>Koneksi Terputus!</strong><br>Gagal mengirim pesan (${error.message})`;
          }
        } else {
          formPesan.reset(); // Kosongkan formulir
          if (alertBox && alertIcon && alertMsg) {
             alertBox.classList.remove('hidden');
             alertBox.classList.add('bg-green-50', 'border-green-200', 'text-green-800');
             alertIcon.innerHTML = `<svg class="w-5 h-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>`;
             alertMsg.innerHTML = `<strong>Pesan Terkirim!</strong><br>Terima kasih <strong>${nama}</strong>. Kami akan merespon ke WhatsApp/Email Anda segera.`;
          }
          
          // Sembunyikan alert otomatis setelah 7 detik
          setTimeout(() => {
            if (alertBox) alertBox.classList.add('hidden');
          }, 7000);
        }
      });
    }
  });
</script>
