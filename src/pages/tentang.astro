---
import MainLayout from '../layouts/MainLayout.astro';
import { supabase } from '../lib/supabase.js';

// Ambil data Profil (Tentang Kami) - CMS Opsional
const { data: tentangData } = await supabase.from('tentang_kami').select('*').order('created_at', { ascending: true });
const profilList = tentangData || [];

// Ambil data Syaikhuna (Asatidz) - Wajib dinamis dari Admin
const { data: syaikhunaData } = await supabase.from('syaikhuna').select('*');
const asatidzList = syaikhunaData || [];

// Ambil Visi & Misi dari pengaturan_web
const { data: configData } = await supabase.from('pengaturan_web').select('*').in('key', ['visi_yayasan', 'misi_yayasan']);
const visi = configData?.find(c => c.key === 'visi_yayasan')?.value || "Mencetak insan kamil yang beriman, bertakwa, berakhlakul karimah, berilmu amaliah, dan beramal ilmiah berlandaskan aqidah Ahlussunnah Wal Jama'ah.";
const misiRaw = configData?.find(c => c.key === 'misi_yayasan')?.value || "Menyelenggarakan pendidikan pesantren salaf dan formal.\nMembina karakter santri dengan adab islami.\nMembekali keterampilan teknologi.";
const misiList = misiRaw.split('\n').filter(m => m.trim() !== '');
---

<MainLayout title="Profil & Tentang Kami">
  
  <!-- HERO SECTION: Premium Dark Emerald to Gold -->
  <div class="relative overflow-hidden bg-gradient-to-b from-green-950 via-pesantren to-green-900 pt-32 pb-24 sm:pt-40 sm:pb-32">
    <!-- Ornamen Abstrak (Glow/Blur) -->
    <div class="absolute -top-24 -left-24 w-[500px] h-[500px] bg-emas/10 rounded-full blur-[100px] mix-blend-overlay pointer-events-none"></div>
    <div class="absolute bottom-0 right-0 w-[400px] h-[400px] bg-green-500/20 rounded-tl-full blur-[80px] pointer-events-none"></div>
    <!-- Pattern Halus -->
    <div class="absolute inset-0 opacity-[0.03] bg-[url('data:image/svg+xml,%3Csvg width=\'60\' height=\'60\' viewBox=\'0 0 60 60\' xmlns=\'http://www.w3.org/2000/svg\'%3E%3Cg fill=\'none\' fill-rule=\'evenodd\'%3E%3Cg fill=\'#ffffff\' fill-opacity=\'1\'%3E%3Cpath d=\'M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z\'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E')] pointer-events-none"></div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center text-white z-10">
      <span class="inline-block py-1.5 px-4 rounded-full bg-emas/20 border border-emas/50 text-emas text-sm font-bold tracking-widest mb-6 shadow-lg shadow-emas/10" data-aos="fade-down">
        PROFIL YAYASAN
      </span>
      <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-black mb-6 tracking-tight drop-shadow-2xl" data-aos="zoom-in" data-aos-delay="100">
        Mengenal Lebih Dekat<br class="hidden sm:block" />
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-emas via-yellow-200 to-emas">Nailul Khoir Majalengka</span>
      </h1>
      <p class="mt-6 max-w-3xl mx-auto text-lg sm:text-2xl text-green-50/90 font-medium leading-relaxed" data-aos="fade-up" data-aos-delay="200">
        Pusat pendidikan Islam yang memadukan luhurnya tradisi salaf dengan kurikulum modern demi mencetak generasi Qur'ani yang unggul, mandiri, dan berakhlakul karimah.
      </p>
    </div>
  </div>

  <!-- BAGIAN VISI & MISI (Static Premium Cards) -->
  <section class="py-20 relative -mt-12 md:-mt-16 z-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-12">
        <!-- Visi Card -->
        <div class="bg-white/90 backdrop-blur-xl p-8 md:p-10 rounded-3xl shadow-2xl border border-white/50 hover:-translate-y-2 transition-transform duration-500 group relative overflow-hidden" data-aos="fade-up" data-aos-delay="100">
          <div class="absolute top-0 left-0 w-2 h-full bg-emas"></div>
          <div class="absolute -right-10 -top-10 text-gray-50 opacity-50 group-hover:scale-110 group-hover:rotate-12 transition-transform duration-700 pointer-events-none">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-48 w-48" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2L2 22h20L12 2z"/></svg>
          </div>
          <div class="relative z-10">
            <div class="w-16 h-16 bg-green-50 rounded-2xl flex items-center justify-center mb-6 shadow-inner border border-green-100 group-hover:bg-emas transition-colors duration-300">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-pesantren group-hover:text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" /></svg>
            </div>
            <h2 class="text-3xl font-black text-gray-900 mb-4 tracking-tight">Visi Yayasan</h2>
            <p class="text-lg text-gray-600 leading-relaxed font-medium">
              "{visi}"
            </p>
          </div>
        </div>

        <!-- Misi Card -->
        <div class="bg-white/90 backdrop-blur-xl p-8 md:p-10 rounded-3xl shadow-2xl border border-white/50 hover:-translate-y-2 transition-transform duration-500 group relative overflow-hidden" data-aos="fade-up" data-aos-delay="200">
          <div class="absolute top-0 left-0 w-2 h-full bg-pesantren"></div>
          <div class="absolute -right-10 -top-10 text-gray-50 opacity-50 group-hover:scale-110 group-hover:rotate-12 transition-transform duration-700 pointer-events-none">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-48 w-48" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2L2 22h20L12 2z"/></svg>
          </div>
          <div class="relative z-10">
            <div class="w-16 h-16 bg-yellow-50 rounded-2xl flex items-center justify-center mb-6 shadow-inner border border-yellow-100 group-hover:bg-pesantren transition-colors duration-300">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-emas group-hover:text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" /></svg>
            </div>
            <h2 class="text-3xl font-black text-gray-900 mb-4 tracking-tight">Misi Yayasan</h2>
            <ul class="text-lg text-gray-600 leading-relaxed font-medium space-y-3">
              {misiList.map((item, idx) => (
                <li class="flex items-start">
                  <span class="text-emas mr-3 font-bold">{idx + 1}.</span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SEJARAH SINGKAT (Dinamis dari Supabase atau Fallback Default) -->
  <section class="py-16 bg-white overflow-hidden relative border-t border-gray-100">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      {profilList.length > 0 ? (
        <div class="space-y-24">
          {profilList.map((item, index) => (
            <div class={`flex flex-col ${index % 2 === 1 ? 'lg:flex-row-reverse' : 'lg:flex-row'} gap-12 lg:gap-16 items-center`} data-aos="fade-up">
              {item.foto_url && (
                <div class="w-full lg:w-1/2 shrink-0 relative group">
                  <div class="absolute inset-0 bg-gradient-to-tr from-emas to-pesantren rounded-3xl transform rotate-3 scale-105 opacity-20 group-hover:rotate-6 transition-transform duration-500"></div>
                  <img src={item.foto_url} alt={item.judul} class="w-full h-auto rounded-3xl shadow-2xl object-cover relative z-10" loading="lazy" />
                </div>
              )}
              <div class={`w-full ${item.foto_url ? 'lg:w-1/2' : 'w-full'} prose prose-lg prose-green max-w-none`}>
                <h2 class="text-3xl sm:text-4xl font-black text-gray-900 tracking-tight mb-8">
                  {item.judul}
                  <div class="h-1.5 w-24 bg-emas mt-3 rounded-full"></div>
                </h2>
                <div class="text-gray-600 leading-loose text-lg" set:html={item.description}></div>
              </div>
            </div>
          ))}
        </div>
      ) : (
        <!-- Default Fallback jika Admin belum isi CMS 'tentang_kami' -->
        <div class="flex flex-col lg:flex-row gap-12 lg:gap-16 items-center" data-aos="fade-up">
          <div class="w-full lg:w-1/2 shrink-0 relative group">
            <div class="absolute inset-0 bg-gradient-to-tr from-emas to-pesantren rounded-3xl transform rotate-3 scale-105 opacity-20 group-hover:rotate-6 transition-transform duration-500"></div>
            <img src="/images/hero-bg.jpg" alt="Pondok Pesantren" class="w-full h-auto min-h-[400px] rounded-3xl shadow-2xl object-cover relative z-10" loading="lazy" />
          </div>
          <div class="w-full lg:w-1/2">
            <h2 class="text-3xl sm:text-4xl font-black text-gray-900 tracking-tight mb-8">
              Sejarah Historis Pesantren
              <div class="h-1.5 w-24 bg-emas mt-4 rounded-full"></div>
            </h2>
            <div class="text-gray-600 leading-loose text-lg space-y-4">
              <p>
                Berangkat dari keprihatinan mendalam akan merosotnya nilai-nilai moral dan spiritual di era modern, Yayasan Pondok Pesantren Nailul Khoir didirikan sebagai oase pendidikan Islam di tengah masyarakat.
              </p>
              <p>
                Awal mula perintisan berawal dari pengajian kitab kuning sederhana di surau kecil. Seiring berjalannya waktu dan tingginya animo masyarakat yang menitipkan putra-putrinya, surau tersebut berkembang pesat menjadi kompleks pendidikan terpadu.
              </p>
              <p>
                Kini, Nailul Khoir tidak hanya melestarikan tradisi mengaji kitab salaf layaknya pesantren tradisional, melainkan juga menaungi lembaga pendidikan formal (SMP IT & SMK) yang berfokus pada penguasaan teknologi. Menjadikan santri kami sebagai manusia paripurna: hatinya lekat dengan masjid, pikirannya menembus kemajuan dunia.
              </p>
            </div>
          </div>
        </div>
      )}
    </div>
  </section>

  <!-- DEWAN ASATIDZ / PENGASUH (CMS Dinamis) -->
  <section class="py-24 bg-gradient-to-b from-gray-50 to-white relative overflow-hidden border-t border-gray-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="text-center mb-16 max-w-3xl mx-auto" data-aos="fade-up">
        <span class="inline-block py-1.5 px-4 rounded-full bg-green-100 text-pesantren text-sm font-bold tracking-widest mb-4">
          GURU & PEMBIMBING KAMI
        </span>
        <h2 class="text-4xl sm:text-5xl font-black text-gray-900 tracking-tight mb-6">
          Dewan Asatidz & Syaikhuna
        </h2>
        <p class="text-xl text-gray-600">
          Ulama dan tenaga pendidik berdedikasi tinggi yang tanpa kenal lelah membimbing akhlak dan keilmuan para santri.
        </p>
        <div class="h-1.5 w-32 bg-emas mx-auto mt-8 rounded-full"></div>
      </div>

      {asatidzList.length > 0 ? (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-10">
          {asatidzList.map((guru, index) => (
            <div class="bg-white rounded-3xl shadow-xl hover:shadow-2xl transition-all duration-300 overflow-hidden border border-gray-100 group transform hover:-translate-y-2" data-aos="fade-up" data-aos-delay={(index % 4) * 100}>
              <div class="h-72 w-full bg-gray-200 relative overflow-hidden">
                {guru.foto_url ? (
                   <img src={guru.foto_url} alt={guru.nama} class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700" loading="lazy" />
                ) : (
                   <div class="absolute inset-0 bg-gradient-to-br from-green-50 to-gray-200 flex items-center justify-center text-pesantren">
                     <svg xmlns="http://www.w3.org/2000/svg" class="h-24 w-24 opacity-30 drop-shadow-sm" fill="currentColor" viewBox="0 0 24 24"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>
                   </div>
                )}
                <!-- Overlay Gradient untuk Teks -->
                <div class="absolute bottom-0 left-0 w-full h-1/2 bg-gradient-to-t from-black/80 via-black/30 to-transparent"></div>
                <div class="absolute bottom-0 left-0 p-6 w-full text-left">
                  <h3 class="font-black text-2xl text-white drop-shadow-md tracking-tight leading-tight">{guru.nama}</h3>
                </div>
              </div>
              <div class="p-6 relative bg-white">
                <p class="text-sm font-bold text-emas bg-yellow-50 rounded-lg px-3 py-2 inline-block mb-4 border border-yellow-100 shadow-inner break-words w-full text-center">
                  {guru.description}
                </p>
                <div class="flex justify-center gap-3 mt-2">
                  <div class="w-8 h-1 bg-gray-100 rounded-full"></div>
                  <div class="w-8 h-1 bg-emas rounded-full"></div>
                  <div class="w-8 h-1 bg-gray-100 rounded-full"></div>
                </div>
              </div>
            </div>
          ))}
        </div>
      ) : (
        <!-- Default State jika Admin belum input Syaikhuna -->
        <div class="text-center py-20 bg-white rounded-3xl shadow-sm border-2 border-dashed border-gray-200 max-w-2xl mx-auto">
          <svg class="w-20 h-20 text-gray-300 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
          <h3 class="text-xl font-bold text-gray-700 mb-2">Data Pengajar Sedang Diperbarui</h3>
          <p class="text-gray-500">Profil Dewan Asatidz akan segera ditampilkan.</p>
        </div>
      )}
    </div>
  </section>

</MainLayout>
