---
import MainLayout from '../../layouts/MainLayout.astro';
import { supabase } from '../../lib/supabase.js';

// Mengambil batch pertama kajian (Pre-rendered SSG)
const PAGE_SIZE = 8;
let { data: kajianData, error } = await supabase
  .from('kajian')
  .select('*')
  .order('created_at', { ascending: false })
  .limit(PAGE_SIZE);

// Fallback jika kolom created_at belum ditambahkan di Supabase (untuk menghindari halaman kosong)
if (error) {
  const { data: fallbackData } = await supabase
    .from('kajian')
    .select('*')
    .limit(PAGE_SIZE);
  kajianData = fallbackData;
}

const kajianList = kajianData || [];
---

<MainLayout title="Jadwal Kajian Kitab & Majelis Taklim">
  <!-- Hero Section -->
  <div class="bg-gradient-to-b from-gray-900 to-gray-950 py-20 text-white text-center mt-16 md:mt-0 relative overflow-hidden">
    <!-- Dekorasi Background -->
    <div class="absolute inset-0 z-0 opacity-20">
      <div class="absolute -top-10 -left-10 w-64 h-64 bg-emas rounded-full blur-3xl"></div>
      <div class="absolute bottom-0 right-0 w-96 h-96 bg-pesantren rounded-full blur-3xl"></div>
    </div>
    
    <div class="relative z-10 max-w-4xl mx-auto px-4" data-aos="zoom-in">
      <span class="inline-block py-1.5 px-4 rounded-full bg-white/10 border border-white/20 text-emas text-sm font-bold tracking-widest mb-4 backdrop-blur-md">
        MAJELIS TAKLIM
      </span>
      <h1 class="text-4xl md:text-5xl lg:text-7xl font-display font-black mb-6 text-white tracking-tight drop-shadow-2xl">
        Kajian <span class="text-emas drop-shadow-lg">Kitab</span>
      </h1>
      <p class="text-xl md:text-2xl text-gray-300 font-medium max-w-2xl mx-auto leading-relaxed">
        Ikuti majelis ilmu rutin dan pelajari berbagai disiplin ilmu agama bersama dewan asatidz Yayasan Pondok Pesantren Nailul Khoir.
      </p>
    </div>
  </div>

  <section class="py-16 bg-gray-950 min-h-screen text-white relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      
      {kajianList.length > 0 ? (
        <div id="kajianGrid" class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12">
          {kajianList.map((kajian, i) => (
            <div class="bg-white/5 backdrop-blur-md rounded-3xl p-3 border border-white/10 overflow-hidden flex flex-col sm:flex-row shadow-2xl hover:border-emas/50 hover:bg-white/10 transition-all duration-500 group" data-aos="fade-up" data-delay={(i % PAGE_SIZE) * 100}>
              <div class="w-full sm:w-2/5 h-64 sm:h-auto rounded-2xl overflow-hidden shadow-inner relative shrink-0">
                {kajian.foto_url ? (
                  <img src={kajian.foto_url} alt={kajian.judul} class="w-full h-full object-cover group-hover:scale-110 group-hover:-rotate-1 transition-transform duration-700" loading="lazy" />
                ) : (
                  <div class="w-full h-full bg-gradient-to-br from-green-900 to-gray-800 flex items-center justify-center">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16 text-white/20" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" /></svg>
                  </div>
                )}
                <!-- Overlay Label -->
                <div class="absolute top-3 left-3 bg-emas/90 backdrop-blur text-gray-900 text-xs font-black uppercase px-3 py-1 rounded-full shadow-lg">Majelis Ilmu</div>
              </div>
              
              <div class="p-6 sm:p-8 flex flex-col justify-center flex-grow">
                <h3 class="text-2xl font-black text-yellow-50 mb-4 tracking-tight group-hover:text-emas transition-colors line-clamp-2">{kajian.judul}</h3>
                <div class="text-gray-300 flex-grow font-medium leading-relaxed mb-6 prose prose-sm prose-invert max-w-none line-clamp-3" set:html={kajian.description}></div>
                <div class="flex items-center text-green-400 font-bold text-sm bg-green-400/10 w-max px-4 py-2 rounded-full border border-green-400/20 group-hover:bg-green-400/20 transition-colors">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
                  Terbuka Umum
                </div>
              </div>
            </div>
          ))}
        </div>
        
        <!-- Load More Container -->
        <div class="mt-16 text-center" id="loadMoreContainer">
          {kajianList.length === PAGE_SIZE && (
            <button id="btnLoadMoreKajian" class="inline-flex items-center justify-center px-10 py-4 text-sm md:text-base font-bold text-gray-900 bg-emas border-2 border-emas rounded-full hover:bg-yellow-400 transition-all duration-300 shadow-lg shadow-emas/20 hover:shadow-emas/40 hover:-translate-y-1 group">
              <span id="loadMoreText">Tampilkan Jadwal Lainnya</span>
              <svg id="loadMoreIcon" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ml-2 group-hover:animate-bounce text-gray-900" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
              <!-- Spinner (Hidden by default) -->
              <svg id="loadMoreSpinner" class="animate-spin h-5 w-5 ml-2 hidden text-gray-900" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
            </button>
          )}
        </div>
      ) : (
        <div class="bg-white/5 backdrop-blur-md rounded-3xl p-16 text-center border border-white/10 shadow-sm max-w-2xl mx-auto" data-aos="fade-in">
          <div class="w-20 h-20 bg-white/10 rounded-full flex items-center justify-center mx-auto mb-6 shadow-inner border border-white/5">
             <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" /></svg>
          </div>
          <p class="text-white font-bold text-2xl mb-2">Belum Terdapat Agenda Majelis</p>
          <p class="text-gray-400">Jadwal kajian rutin dan agenda pengajian akan segera diunggah oleh pihak Yayasan secara berkala.</p>
        </div>
      )}
    </div>
  </section>

  <script>
    import { supabase } from '../../lib/supabase.js';

    document.addEventListener("DOMContentLoaded", () => {
      const btnLoadMore = document.getElementById('btnLoadMoreKajian') as HTMLButtonElement;
      const grid = document.getElementById('kajianGrid');
      
      let pageNumber = 1;
      const PAGE_SIZE = 8; // Pastikan match dengan prop SSR!

      if (!btnLoadMore || !grid) return;

      btnLoadMore.addEventListener('click', async () => {
        const textSpan = document.getElementById('loadMoreText');
        const iconSpan = document.getElementById('loadMoreIcon');
        const spinnerSpan = document.getElementById('loadMoreSpinner');

        // Loading State
        if (textSpan) textSpan.textContent = "Mengambil jadwal...";
        if (iconSpan) iconSpan.classList.add('hidden');
        if (spinnerSpan) spinnerSpan.classList.remove('hidden');
        btnLoadMore.disabled = true;

        const rangeStart = pageNumber * PAGE_SIZE;
        const rangeEnd = rangeStart + PAGE_SIZE - 1;

        // Fetch berita selanjutnya
        let { data, error } = await supabase
          .from('kajian')
          .select('*')
          .order('created_at', { ascending: false })
          .range(rangeStart, rangeEnd);

        // Fallback jika created_at kolom tidak ada (client-side)
        if (error) {
           const { data: fallbackData, error: fallbackError } = await supabase
            .from('kajian')
            .select('*')
            .range(rangeStart, rangeEnd);
           data = fallbackData;
           error = fallbackError;
        }

        if (error) {
          alert('Gagal mengambil kajian: ' + error.message);
        } else if (data && data.length > 0) {
          const stripHtml = (html: string) => {
             let doc = new DOMParser().parseFromString(html, 'text/html');
             return doc.body.textContent || "";
          };

          const delayMultiplier = 150;

          data.forEach((kajian, index) => {
            const rawDescription = kajian.description || '';
            let imageTag = '';
            
            if (kajian.foto_url) {
              imageTag = `<img src="${kajian.foto_url}" alt="${kajian.judul}" class="w-full h-full object-cover group-hover:scale-110 group-hover:-rotate-1 transition-transform duration-700" loading="lazy" />`;
            } else {
              imageTag = `
                <div class="w-full h-full bg-gradient-to-br from-green-900 to-gray-800 flex items-center justify-center">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16 text-white/20" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" /></svg>
                </div>
              `;
            }

            const cardHtml = `
              <div class="bg-white/5 backdrop-blur-md rounded-3xl p-3 border border-white/10 overflow-hidden flex flex-col sm:flex-row shadow-2xl hover:border-emas/50 hover:bg-white/10 transition-all duration-500 group opacity-0 transform translate-y-8" style="animation: gracefulReveal 0.6s forwards ${index * delayMultiplier}ms">
                <div class="w-full sm:w-2/5 h-64 sm:h-auto rounded-2xl overflow-hidden shadow-inner relative shrink-0">
                  ${imageTag}
                  <div class="absolute top-3 left-3 bg-emas/90 backdrop-blur text-gray-900 text-xs font-black uppercase px-3 py-1 rounded-full shadow-lg">Majelis Ilmu</div>
                </div>
                
                <div class="p-6 sm:p-8 flex flex-col justify-center flex-grow">
                  <h3 class="text-2xl font-black text-yellow-50 mb-4 tracking-tight group-hover:text-emas transition-colors line-clamp-2">${kajian.judul}</h3>
                  <div class="text-gray-300 flex-grow font-medium leading-relaxed mb-6 prose prose-sm prose-invert max-w-none line-clamp-3">${rawDescription}</div>
                  <div class="flex items-center text-green-400 font-bold text-sm bg-green-400/10 w-max px-4 py-2 rounded-full border border-green-400/20 group-hover:bg-green-400/20 transition-colors">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
                    Terbuka Umum
                  </div>
                </div>
              </div>
            `;
            grid.insertAdjacentHTML('beforeend', cardHtml);
          });
          pageNumber++;
          
          if (data.length < PAGE_SIZE) {
            btnLoadMore.style.display = 'none'; // Habis
          }
        } else {
          btnLoadMore.style.display = 'none'; // Tidak ada sisa
        }

        // Return state
        if (textSpan) textSpan.textContent = "Tampilkan Jadwal Lainnya";
        if (iconSpan) iconSpan.classList.remove('hidden');
        if (spinnerSpan) spinnerSpan.classList.add('hidden');
        btnLoadMore.disabled = false;
      });
    });
  </script>

  <style>
    @keyframes gracefulReveal {
      0% { opacity: 0; transform: translateY(2rem) scale(0.95); }
      100% { opacity: 1; transform: translateY(0) scale(1); }
    }
  </style>
</MainLayout>
