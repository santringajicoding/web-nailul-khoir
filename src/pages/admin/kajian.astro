---
import AdminLayout from '../../layouts/AdminLayout.astro';
---
<AdminLayout title="Manajemen Kajian">
  <div class="mb-8 flex flex-col md:flex-row md:items-center justify-between gap-4">
    <div>
      <h2 class="text-3xl font-extrabold text-gray-900 tracking-tight">Data Kajian & Pengajian</h2>
      <p class="text-gray-600 mt-2 text-lg">Kelola informasi jadwal dan materi kajian pesantren.</p>
    </div>
    <button id="btnToggleForm" class="bg-pesantren hover:bg-green-800 text-white px-5 py-3 rounded-xl font-bold font-medium shadow-md transition-all flex items-center gap-2">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
         <path fill-rule="evenodd" d="M10 5a1 1 0 011 1v3h3a1 1 0 110 2h-3v3a1 1 0 11-2 0v-3H6a1 1 0 110-2h3V6a1 1 0 011-1z" clip-rule="evenodd" />
      </svg>
      Tambah Kajian
    </button>
  </div>

  <div id="formContainer" class="hidden bg-white p-6 rounded-2xl shadow-xl border border-gray-100 mb-8 relative">
    <button id="btnCloseForm" class="absolute top-4 right-4 text-gray-400 hover:text-red-500 transition-colors">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
    <h3 id="formTitle" class="text-xl font-bold text-gray-800 mb-6 border-b pb-3">Input Info Kajian Baru</h3>
    
    <div id="alertFormName" class="hidden mb-4 p-3 rounded text-sm font-medium"></div>

    <form id="formKajian" class="space-y-4">
      <input type="hidden" id="edit_id" name="edit_id" value="" />
      <input type="hidden" id="old_foto_url" name="old_foto_url" value="" />

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="col-span-1 md:col-span-2">
          <label class="block text-sm font-bold text-gray-700 mb-1">Judul / Nama Kitab <span class="text-red-500">*</span></label>
          <input type="text" id="judul" name="judul" required class="w-full px-4 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-pesantren outline-none" placeholder="Contoh: Kajian Kitab Tafsir Jalalain">
        </div>
        
        <div class="col-span-1 md:col-span-2">
          <label class="block text-sm font-bold text-gray-700 mb-1" id="labelFoto">Unggah Poster/Banner (Opsional)</label>
          <input type="file" id="foto_file" name="foto_file" accept="image/*" class="w-full px-3 py-2 text-sm text-gray-700 rounded-lg border border-gray-300 focus:ring-2 focus:ring-pesantren outline-none file:mr-4 file:py-1 file:px-3 file:rounded-md file:border-0 file:text-sm file:font-semibold file:bg-green-50 file:text-green-700 hover:file:bg-green-100 cursor-pointer">
        </div>

        <div class="col-span-1 md:col-span-2">
          <label class="block text-sm font-bold text-gray-700 mb-1">Keterangan / Jadwal Rutin <span class="text-red-500">*</span></label>
          <textarea id="description" name="description" required class="hidden"></textarea>
          <div class="bg-white rounded-lg border border-gray-300 overflow-hidden">
             <div id="quill-editor" class="h-48 sm:h-64 w-full bg-gray-50 text-gray-800 text-base border-0"></div>
          </div>
        </div>
      </div>

      <div class="pt-4 flex justify-end gap-3">
        <button type="button" id="btnCancelEdit" class="hidden bg-gray-100 hover:bg-gray-200 text-gray-700 font-bold py-2 px-6 rounded-lg shadow-sm transition-colors">Batal Edit</button>
        <button type="submit" id="btnSubmitData" class="bg-pesantren hover:bg-green-800 text-white font-bold py-2 px-6 rounded-lg shadow transition-colors flex items-center">
          <span id="btnSubmitText">Simpan Kajian</span>
        </button>
      </div>
    </form>
  </div>

  <div class="bg-white rounded-2xl shadow-xl overflow-hidden border border-gray-100">
    <div class="p-4 sm:p-6 border-b border-gray-100 bg-gray-50 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
      <div class="font-bold text-gray-700">Daftar Kajian Aktif</div>
      <button id="btnRefreshData" class="w-full sm:w-auto bg-white text-pesantren border border-pesantren hover:bg-green-50 px-5 py-2.5 rounded-xl text-sm font-bold shadow-sm transition-colors flex items-center justify-center gap-2">
        Segarkan Data
      </button>
    </div>

    <div class="auto-cols-auto grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 p-6" id="dataGrid">
      <div class="col-span-full py-12 text-center text-gray-500">Memuat Data...</div>
    </div>
  </div>

  <script>
    import { supabase } from '../../lib/supabase.js';

    let allKajianData: any[] = [];
    let quill: any = null;

    function init() {
      if ((window as any).Quill) {
        quill = new (window as any).Quill('#quill-editor', {
          theme: 'snow',
          placeholder: 'Tuliskan detail kajian kaya (Rich Text) disini...',
          modules: { toolbar: [ [{ 'header': [1, 2, 3, false] }], ['bold', 'italic', 'underline', 'strike'], [{ 'list': 'ordered'}, { 'list': 'bullet' }], [{ 'align': [] }], ['link', 'clean'] ] }
        });
        quill.on('text-change', () => {
          const descInput = document.getElementById('description') as HTMLTextAreaElement;
          const html = quill.root.innerHTML;
          descInput.value = html === '<p><br></p>' ? '' : html;
        });
      }
      loadData();
    }

    const formContainer = document.getElementById('formContainer');
    const formKajian = document.getElementById('formKajian') as HTMLFormElement;
    const btnCancelEdit = document.getElementById('btnCancelEdit');

    const resetFormToCreate = () => {
       formKajian?.reset();
       (document.getElementById('edit_id') as HTMLInputElement).value = '';
       (document.getElementById('old_foto_url') as HTMLInputElement).value = '';
       (document.getElementById('formTitle') as HTMLElement).textContent = 'Input Info Kajian Baru';
       (document.getElementById('btnSubmitText') as HTMLElement).textContent = 'Simpan Kajian';
       (document.getElementById('labelFoto') as HTMLElement).textContent = 'Unggah Poster/Banner (Opsional)';
       if(quill) quill.setContents([]);
       btnCancelEdit?.classList.add('hidden');
    };

    document.getElementById('btnToggleForm')?.addEventListener('click', () => { 
      resetFormToCreate();
      formContainer?.classList.remove('hidden'); 
      formContainer?.scrollIntoView({ behavior: 'smooth' }); 
    });
    
    document.getElementById('btnCloseForm')?.addEventListener('click', () => { 
      formContainer?.classList.add('hidden'); 
      resetFormToCreate();
    });

    btnCancelEdit?.addEventListener('click', () => {
      resetFormToCreate();
      formContainer?.classList.add('hidden');
    });

    async function loadData() {
      const grid = document.getElementById('dataGrid');
      if (!grid) return;

      const { data, error } = await supabase.from('kajian').select('*');

      if (error) return grid.innerHTML = `<div class="col-span-full text-center text-red-500 p-4">Error: ${error.message}</div>`;
      
      allKajianData = data || [];
      
      if (!data || data.length === 0) return grid.innerHTML = `<div class="col-span-full text-center text-gray-500 p-8 border-2 border-dashed rounded-xl">Belum ada data kajian.</div>`;

      grid.innerHTML = data.map(item => `
        <div class="bg-white border text-left border-gray-200 rounded-xl shadow-sm hover:shadow-md transition-shadow overflow-hidden flex flex-col group relative">
          <div class="h-40 bg-gray-100 w-full overflow-hidden">
            ${item.foto_url ? `<img src="${item.foto_url}" class="w-full h-full object-cover group-hover:scale-105 transition-transform" />` : `<div class="w-full h-full flex items-center justify-center text-gray-400 bg-green-50"><span class="text-xs font-bold uppercase tracking-widest text-green-800">Tanpa Foto</span></div>`}
          </div>
          <div class="p-5 flex-grow flex flex-col">
            <h4 class="font-bold text-gray-900 text-lg mb-2 line-clamp-2">${item.judul}</h4>
            <p class="text-gray-500 text-sm mb-4 flex-grow line-clamp-3">${item.description ? item.description.replace(/<[^>]*>?/gm, '') : ''}</p>
            <div class="pt-4 border-t border-gray-100 flex justify-end gap-2">
              <button data-action="edit-data" data-id="${item.id}" class="text-blue-600 hover:bg-blue-50 px-3 py-1.5 rounded text-sm font-bold transition-colors">Edit</button>
              <button data-action="hapus-data" data-id="${item.id}" data-nama="${item.judul}" class="text-red-500 hover:bg-red-50 px-3 py-1.5 rounded text-sm font-bold transition-colors">Hapus</button>
            </div>
          </div>
        </div>
      `).join('');
    }

    if (formKajian) {
      formKajian.addEventListener('submit', async (e) => {
        e.preventDefault();
        const btn = document.getElementById('btnSubmitData') as HTMLButtonElement;
        const btnText = document.getElementById('btnSubmitText');
        const alertMsg = document.getElementById('alertFormName');
        const fileInput = document.getElementById('foto_file') as HTMLInputElement;
        
        btn.disabled = true;
        if(btnText) btnText.textContent = 'Memproses...';

        const formData = new FormData(formKajian);
        const editId = formData.get('edit_id')?.toString();
        const oldFotoUrl = formData.get('old_foto_url')?.toString();
        let uploadedFotoUrl: string | null = null;

        if (fileInput && fileInput.files && fileInput.files.length > 0) {
          const file = fileInput.files[0];
          const fileName = `${Date.now()}-${file.name.replace(/[^a-zA-Z0-9.]/g, '')}`;
          const { data: uploadData, error: uploadError } = await supabase.storage.from('berita_images').upload(fileName, file);
          
          if (uploadError) {
             if (alertMsg) { 
               alertMsg.textContent = 'Gagal unggah gambar: ' + uploadError.message; 
               alertMsg.className = 'block mb-4 p-3 rounded font-bold bg-red-100 text-red-800'; 
               alertMsg.classList.remove('hidden');
             }
             btn.disabled = false; 
             if(btnText) btnText.textContent = editId ? 'Simpan Perubahan' : 'Simpan Kajian'; 
             return;
          }
          const { data: publicUrlData } = supabase.storage.from('berita_images').getPublicUrl(fileName);
          uploadedFotoUrl = publicUrlData.publicUrl;
        } else if (oldFotoUrl) {
          uploadedFotoUrl = oldFotoUrl;
        }

        const dbPayload: any = {
          judul: formData.get('judul'),
          foto_url: uploadedFotoUrl,
          description: formData.get('description')
        };

        let dbError;
        if (editId) {
          const { error } = await supabase.from('kajian').update(dbPayload).eq('id', editId);
          dbError = error;
        } else {
          const { error } = await supabase.from('kajian').insert([dbPayload]);
          dbError = error;
        }

        if (dbError) {
          if (alertMsg) { 
            alertMsg.textContent = 'Gagal menyimpan: ' + dbError.message; 
            alertMsg.className = 'block mb-4 p-3 rounded font-bold bg-red-100 text-red-800'; 
            alertMsg.classList.remove('hidden');
          }
        } else {
          resetFormToCreate();
          if (alertMsg) { 
            alertMsg.textContent = editId ? 'Data berhasil diperbarui!' : 'Berhasil disimpan!'; 
            alertMsg.className = 'block mb-4 p-3 rounded font-bold bg-green-100 text-green-800'; 
            alertMsg.classList.remove('hidden');
          }
          setTimeout(() => { formContainer?.classList.add('hidden'); alertMsg!.className = 'hidden'; }, 1500);
          loadData();
        }
        btn.disabled = false;
        if(btnText) btnText.textContent = 'Simpan Kajian';
      });
    }

    const gridData = document.getElementById('dataGrid');
    if (gridData) {
      gridData.addEventListener('click', async (e) => {
        const target = (e.target as Element).closest('button');
        if (!target) return;
        
        const action = target.getAttribute('data-action');
        const id = target.getAttribute('data-id');

        if (action === 'hapus-data') {
          if(confirm(`Hapus kajian "${target.getAttribute('data-nama')}"?`)) {
            const { error } = await supabase.from('kajian').delete().eq('id', id);
            if (error) alert('Gagal hapus: ' + error.message); else loadData();
          }
        } 
        else if (action === 'edit-data') {
          const itemToEdit = allKajianData.find(item => item.id === id);
          if (itemToEdit) {
            (document.getElementById('edit_id') as HTMLInputElement).value = itemToEdit.id;
            (document.getElementById('judul') as HTMLInputElement).value = itemToEdit.judul;
            (document.getElementById('description') as HTMLTextAreaElement).value = itemToEdit.description || '';
            (document.getElementById('old_foto_url') as HTMLInputElement).value = itemToEdit.foto_url || '';
            if(quill) quill.clipboard.dangerouslyPasteHTML(itemToEdit.description || '');
            
            (document.getElementById('formTitle') as HTMLElement).textContent = 'Edit Kajian';
            (document.getElementById('btnSubmitText') as HTMLElement).textContent = 'Simpan Perubahan';
            (document.getElementById('labelFoto') as HTMLElement).textContent = 'Timpa Poster (Kosongkan jika tidak mengubah)';
            
            btnCancelEdit?.classList.remove('hidden');
            formContainer?.classList.remove('hidden');
            formContainer?.scrollIntoView({ behavior: 'smooth' });
          }
        }
      });
    }

    document.addEventListener('DOMContentLoaded', () => {
      init();
      document.getElementById('btnRefreshData')?.addEventListener('click', loadData);
    });
  </script>
</AdminLayout>
