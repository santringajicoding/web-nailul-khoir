---
import AdminLayout from '../../layouts/AdminLayout.astro';
---
<AdminLayout title="Manajemen Galeri Foto">
  
  <div class="mb-8 flex flex-col md:flex-row md:items-center justify-between gap-4">
    <div>
      <h2 class="text-3xl font-extrabold text-gray-900 tracking-tight">Galeri Kegiatan</h2>
      <p class="text-gray-600 mt-2 text-lg">Kelola foto-foto dokumentasi dan momen istimewa di pesantren.</p>
    </div>
    <button id="btnToggleForm" class="bg-pesantren hover:bg-green-800 text-white px-5 py-3 rounded-xl font-bold font-medium shadow-md transition-all flex items-center gap-2">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M4 3a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V5a2 2 0 00-2-2H4zm12 12H4l4-8 3 6 2-4 3 6z" clip-rule="evenodd" />
      </svg>
      Upload Foto Baru
    </button>
  </div>

  <!-- Modal / Form Tambah Galeri (Hidden by default) -->
  <div id="formContainer" class="hidden bg-white p-6 rounded-2xl shadow-xl border border-gray-100 mb-8 relative">
    <button id="btnCloseForm" class="absolute top-4 right-4 text-gray-400 hover:text-red-500 transition-colors">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
    <h3 id="formTitle" class="text-xl font-bold text-gray-800 mb-6 border-b pb-3 text-left">Unggah Foto Galeri</h3>
    
    <div id="alertFormName" class="hidden mb-4 p-3 rounded text-sm font-medium text-left"></div>

    <form id="formGaleri" class="space-y-4 text-left">
      <input type="hidden" id="edit_id" name="edit_id" value="" />
      <input type="hidden" id="old_foto_url" name="old_foto_url" value="" />
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="col-span-1">
          <label class="block text-sm font-bold text-gray-700 mb-1">Judul / Nama Momen <span class="text-red-500">*</span></label>
          <input type="text" id="judul" name="judul" required class="w-full px-4 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-pesantren outline-none" placeholder="Ex: Wisuda Santri / Kajian Rutin">
        </div>
        
        <div class="col-span-1">
          <label class="block text-sm font-bold text-gray-700 mb-1" id="labelFoto">Pilih File Foto <span class="text-red-500">*</span></label>
          <input type="file" id="foto_file" name="foto_file" accept="image/*" class="w-full px-3 py-1.5 text-sm text-gray-700 rounded-lg border border-gray-300 focus:ring-2 focus:ring-pesantren outline-none file:mr-4 file:py-1.5 file:px-3 file:rounded-md file:border-0 file:text-sm file:font-semibold file:bg-green-50 file:text-green-700 hover:file:bg-green-100 cursor-pointer">
        </div>

        <div class="col-span-1 md:col-span-2">
          <label class="block text-sm font-bold text-gray-700 mb-1">Deskripsi Singkat (Opsional)</label>
          <textarea id="deskripsi" name="deskripsi" rows="3" class="w-full px-4 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-pesantren outline-none resize-none" placeholder="Ceritakan sedikit tentang foto ini..."></textarea>
        </div>
      </div>

      <div class="pt-4 flex justify-end gap-3">
        <button type="button" id="btnCancelEdit" class="hidden bg-gray-100 hover:bg-gray-200 text-gray-700 font-bold py-2 px-6 rounded-lg shadow-sm transition-colors">Batal Edit</button>
        <button type="submit" id="btnSubmitGaleri" class="bg-pesantren hover:bg-green-800 text-white font-bold py-2.5 px-8 rounded-lg shadow shadow-pesantren/20 transition-all flex items-center gap-2">
           <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" /></svg>
          <span id="btnSubmitText">Simpan Foto</span>
        </button>
      </div>
    </form>
  </div>

  <!-- Display Data Galeri -->
  <div class="bg-white rounded-2xl shadow-xl overflow-hidden border border-gray-100">
    <div class="p-4 sm:p-6 border-b border-gray-100 bg-gray-50 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
      <div class="font-bold text-gray-700">Album Foto Yayasan</div>
      <button id="btnRefreshGaleri" class="bg-white text-pesantren border border-pesantren/30 hover:bg-green-50 px-4 py-2 rounded-xl text-sm font-bold transition-all flex items-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" /></svg>
        Segarkan
      </button>
    </div>

    <div id="galeriGrid" class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 p-4 min-h-[400px]">
       <!-- Skeleton Loader -->
       <div class="col-span-full py-20 text-center text-gray-500">
         <svg class="animate-spin h-10 w-10 text-pesantren mx-auto mb-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
         Menghubungkan ke Album...
       </div>
    </div>
  </div>

  <script>
    import { supabase } from '../../lib/supabase.js';

    let allGaleriData: any[] = [];

    // Load Data
    const loadGaleri = async () => {
      const grid = document.getElementById('galeriGrid');
      if(!grid) return;

      const { data, error } = await supabase.from('galeri').select('*').order('created_at', { ascending: false });

      if (error) {
        grid.innerHTML = `<div class="col-span-full text-center text-red-500 font-bold p-8">Gagal memuat galeri: ${error.message}</div>`;
        return;
      }

      allGaleriData = data || [];

      if (!data || data.length === 0) {
        grid.innerHTML = `<div class="col-span-full text-center text-gray-500 p-20 border-2 border-dashed border-gray-200 rounded-3xl m-4">Belum ada foto di album ini.</div>`;
        return;
      }

      grid.innerHTML = data.map(item => `
        <div class="group relative aspect-square bg-gray-100 rounded-2xl overflow-hidden border border-gray-100 shadow-sm hover:shadow-xl transition-all duration-500">
          <img src="${item.foto_url}" alt="${item.judul}" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" />
          <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity flex flex-col justify-end p-4">
            <h4 class="text-white font-bold text-sm leading-tight mb-1 truncate">${item.judul}</h4>
            <p class="text-xs text-gray-300 line-clamp-2 mb-3">${item.deskripsi || ''}</p>
            <div class="flex gap-2">
               <button data-action="edit-galeri" data-id="${item.id}" class="flex-1 py-1.5 rounded-lg bg-white/20 hover:bg-white text-white hover:text-pesantren text-[10px] font-black uppercase transition-all border border-white/20">Edit</button>
               <button data-action="hapus-galeri" data-id="${item.id}" data-judul="${item.judul}" class="flex-1 py-1.5 rounded-lg bg-red-500 hover:bg-red-600 text-white text-[10px] font-black uppercase transition-all shadow-lg">Hapus</button>
            </div>
          </div>
        </div>
      `).join('');
    };

    // Toggle Form
    const formContainer = document.getElementById('formContainer');
    const formGaleri = document.getElementById('formGaleri') as HTMLFormElement;
    const btnToggle = document.getElementById('btnToggleForm');
    const btnClose = document.getElementById('btnCloseForm');
    const btnCancelEdit = document.getElementById('btnCancelEdit');

    const resetForm = () => {
      formGaleri?.reset();
      (document.getElementById('edit_id') as HTMLInputElement).value = '';
      (document.getElementById('old_foto_url') as HTMLInputElement).value = '';
      (document.getElementById('formTitle') as HTMLElement).textContent = 'Unggah Foto Galeri';
      (document.getElementById('btnSubmitText') as HTMLElement).textContent = 'Simpan Foto';
      (document.getElementById('foto_file') as HTMLInputElement).required = true;
      btnCancelEdit?.classList.add('hidden');
    };

    if(btnToggle && formContainer && btnClose) {
      btnToggle.addEventListener('click', () => {
        resetForm();
        formContainer.classList.remove('hidden');
        formContainer.scrollIntoView({ behavior: 'smooth' });
      });
      btnClose.addEventListener('click', () => {
        formContainer.classList.add('hidden');
        resetForm();
      });
      btnCancelEdit?.addEventListener('click', () => {
         formContainer.classList.add('hidden');
         resetForm();
      });
    }

    // Submit Action
    if (formGaleri) {
      formGaleri.addEventListener('submit', async (e) => {
        e.preventDefault();
        
        const btn = document.getElementById('btnSubmitGaleri') as HTMLButtonElement;
        const btnText = document.getElementById('btnSubmitText');
        const alertMsg = document.getElementById('alertFormName');
        const fileInput = document.getElementById('foto_file') as HTMLInputElement;

        const editId = (document.getElementById('edit_id') as HTMLInputElement).value;
        const oldFotoUrl = (document.getElementById('old_foto_url') as HTMLInputElement).value;

        btn.disabled = true;
        if(btnText) btnText.textContent = 'Menyimpan...';

        let finalFotoUrl = oldFotoUrl;

        // Upload Foto ke Supabase Storage
        if(fileInput.files && fileInput.files.length > 0) {
          const file = fileInput.files[0];
          const fileExt = file.name.split('.').pop();
          const fileName = `galeri-${Date.now()}.${fileExt}`;

          if(btnText) btnText.textContent = 'Mengunggah...';

          const { data: uploadData, error: uploadError } = await supabase.storage
            .from('berita_images')
            .upload(fileName, file);

          if (uploadError) {
             alert('Error upload: Pastikan bucket "berita_images" sudah dibuat! ' + uploadError.message);
             btn.disabled = false;
             if(btnText) btnText.textContent = 'Simpan Foto';
             return;
          }

          const { data: publicData } = supabase.storage.from('berita_images').getPublicUrl(fileName);
          finalFotoUrl = publicData.publicUrl;
        }

        const payload: any = {
           judul: (document.getElementById('judul') as HTMLInputElement).value,
           deskripsi: (document.getElementById('deskripsi') as HTMLTextAreaElement).value,
           foto_url: finalFotoUrl
        };

        let dbError;
        if (editId) {
          const { error } = await supabase.from('galeri').update(payload).eq('id', editId);
          dbError = error;
        } else {
          const { error } = await supabase.from('galeri').insert([payload]);
          dbError = error;
        }

        if (dbError) {
           if(alertMsg) {
             alertMsg.textContent = 'Error: ' + dbError.message;
             alertMsg.className = 'block mb-4 p-3 rounded text-sm font-bold bg-red-100 text-red-800';
             alertMsg.classList.remove('hidden');
           }
        } else {
           if(alertMsg) {
             alertMsg.textContent = 'Berhasil disimpan!';
             alertMsg.className = 'block mb-4 p-3 rounded text-sm font-bold bg-green-100 text-green-800';
             alertMsg.classList.remove('hidden');
           }
           setTimeout(() => { 
             formContainer?.classList.add('hidden'); 
             if(alertMsg) alertMsg.classList.add('hidden');
           }, 1500);
           loadGaleri();
        }

        btn.disabled = false;
        if(btnText) btnText.textContent = 'Simpan Foto';
      });
    }

    // Grid Actions
    const galeriGrid = document.getElementById('galeriGrid');
    if (galeriGrid) {
      galeriGrid.addEventListener('click', async (e) => {
        const target = (e.target as Element).closest('button');
        if (!target) return;

        const action = target.getAttribute('data-action');
        const id = target.getAttribute('data-id');

        if (action === 'hapus-galeri') {
           const judul = target.getAttribute('data-judul');
           if(confirm(`Hapus foto: "${judul}"?`)) {
             const { error } = await supabase.from('galeri').delete().eq('id', id);
             if (error) alert(error.message);
             else loadGaleri();
           }
        } else if (action === 'edit-galeri') {
           const item = allGaleriData.find(i => i.id === id);
           if (item) {
              (document.getElementById('edit_id') as HTMLInputElement).value = item.id;
              (document.getElementById('judul') as HTMLInputElement).value = item.judul;
              (document.getElementById('deskripsi') as HTMLTextAreaElement).value = item.deskripsi || '';
              (document.getElementById('old_foto_url') as HTMLInputElement).value = item.foto_url;
              
              (document.getElementById('formTitle') as HTMLElement).textContent = 'Edit Data Foto';
              (document.getElementById('btnSubmitText') as HTMLElement).textContent = 'Simpan Perubahan';
              (document.getElementById('foto_file') as HTMLInputElement).required = false;
              (document.getElementById('labelFoto') as HTMLElement).textContent = 'Timpa Foto (Biarkan kosong jika tidak berubah)';
              
              btnCancelEdit?.classList.remove('hidden');
              formContainer?.classList.remove('hidden');
              formContainer?.scrollIntoView({ behavior: 'smooth' });
           }
        }
      });
    }

    document.addEventListener('DOMContentLoaded', () => {
      loadGaleri();
      document.getElementById('btnRefreshGaleri')?.addEventListener('click', loadGaleri);
    });
  </script>
</AdminLayout>
