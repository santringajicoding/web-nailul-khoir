---
import AdminLayout from '../../layouts/AdminLayout.astro';
---
<AdminLayout title="Dashboard Analytics">
  
  <div class="mb-10">
    <h2 class="text-4xl font-display font-black text-gray-900 tracking-tight">Ringkasan Analisis</h2>
    <p class="text-gray-500 mt-2 text-lg font-light">Pantau pertumbuhan santri dan performa publikasi website secara langsung.</p>
  </div>

  <!-- Statistik Utama (Grid Cards) -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-6 gap-6 mb-10">
    
    <!-- Pendaftar Keseluruhan -->
    <div class="bg-white rounded-[2rem] shadow-[0_15px_40px_rgba(0,0,0,0.03)] p-6 border border-gray-100 flex flex-col justify-between hover:shadow-xl transition-all duration-500 group relative overflow-hidden">
        <div class="absolute top-0 right-0 w-20 h-20 bg-gray-50 rounded-full -mr-8 -mt-8 group-hover:bg-gray-100 transition-colors"></div>
        <div class="bg-gray-100 w-12 h-12 rounded-2xl flex items-center justify-center text-gray-600 mb-4 group-hover:scale-110 transition-transform">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" /></svg>
        </div>
        <div>
            <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Total Pendaftar</p>
            <span class="text-3xl font-display font-black text-gray-900" id="statTotalPendaftar">0</span>
        </div>
    </div>

    <!-- Pendaftar SMP -->
    <div class="bg-white rounded-[2rem] shadow-[0_15px_40px_rgba(0,0,0,0.03)] p-6 border border-gray-100 flex flex-col justify-between hover:shadow-xl transition-all duration-500 group relative overflow-hidden">
        <div class="absolute top-0 right-0 w-20 h-20 bg-blue-50 rounded-full -mr-8 -mt-8 group-hover:bg-blue-100 transition-colors"></div>
        <div class="bg-blue-100 w-12 h-12 rounded-2xl flex items-center justify-center text-blue-600 mb-4 group-hover:scale-110 transition-transform">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 14l9-5-9-5-9 5 9 5z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z" /></svg>
        </div>
        <div>
            <p class="text-[10px] font-bold text-blue-400 uppercase tracking-widest mb-1">SMPIT</p>
            <span class="text-3xl font-display font-black text-gray-900" id="statSMP">0</span>
        </div>
    </div>

    <!-- Pendaftar SMK -->
    <div class="bg-white rounded-[2rem] shadow-[0_15px_40px_rgba(0,0,0,0.03)] p-6 border border-gray-100 flex flex-col justify-between hover:shadow-xl transition-all duration-500 group relative overflow-hidden">
        <div class="absolute top-0 right-0 w-20 h-20 bg-orange-50 rounded-full -mr-8 -mt-8 group-hover:bg-orange-100 transition-colors"></div>
        <div class="bg-orange-100 w-12 h-12 rounded-2xl flex items-center justify-center text-orange-600 mb-4 group-hover:scale-110 transition-transform">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
        </div>
        <div>
            <p class="text-[10px] font-bold text-orange-400 uppercase tracking-widest mb-1">SMK IT</p>
            <span class="text-3xl font-display font-black text-gray-900" id="statSMK">0</span>
        </div>
    </div>

    <!-- Pendaftar Pondok -->
    <div class="bg-white rounded-[2rem] shadow-[0_15px_40px_rgba(0,0,0,0.03)] p-6 border border-gray-100 flex flex-col justify-between hover:shadow-xl transition-all duration-500 group relative overflow-hidden">
        <div class="absolute top-0 right-0 w-20 h-20 bg-green-50 rounded-full -mr-8 -mt-8 group-hover:bg-green-100 transition-colors"></div>
        <div class="bg-green-100 w-12 h-12 rounded-2xl flex items-center justify-center text-green-700 mb-4 group-hover:scale-110 transition-transform">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" /></svg>
        </div>
        <div>
            <p class="text-[10px] font-bold text-green-500 uppercase tracking-widest mb-1">Pondok</p>
            <span class="text-3xl font-display font-black text-gray-900" id="statPondok">0</span>
        </div>
    </div>

    <!-- Total Donasi -->
    <div class="bg-white rounded-[2rem] shadow-[0_15px_40px_rgba(0,0,0,0.03)] p-6 border border-gray-100 flex flex-col justify-between hover:shadow-xl transition-all duration-500 group relative overflow-hidden">
        <div class="absolute top-0 right-0 w-20 h-20 bg-emas/5 rounded-full -mr-8 -mt-8 group-hover:bg-emas/10 transition-colors"></div>
        <div class="bg-emas/10 w-12 h-12 rounded-2xl flex items-center justify-center text-emas mb-4 group-hover:scale-110 transition-transform">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
        </div>
        <div>
            <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Donasi</p>
            <span class="text-xl font-display font-black text-gray-900" id="statDonasi">Rp 0</span>
        </div>
    </div>

    <!-- Pesan Belum Dibaca -->
    <div class="bg-white rounded-[2rem] shadow-[0_15px_40px_rgba(0,0,0,0.03)] p-6 border border-gray-100 flex flex-col justify-between hover:shadow-xl transition-all duration-500 group relative overflow-hidden">
        <div id="unreadIndicator" class="absolute top-4 right-4 w-2 h-2 bg-red-500 rounded-full animate-ping hidden"></div>
        <div class="bg-red-50 w-12 h-12 rounded-2xl flex items-center justify-center text-red-500 mb-4 group-hover:scale-110 transition-transform">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
        </div>
        <div>
            <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Pesan Inbox</p>
            <span class="text-3xl font-display font-black text-gray-900" id="statPesan">0</span>
        </div>
    </div>

  </div>

  <!-- Charts & Activity Split -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-10">
    
    <!-- Grafik Pertumbuhan Pendaftar (8 Col) -->
    <div class="lg:col-span-8 bg-white rounded-[2rem] shadow-xl border border-gray-100 overflow-hidden">
      <div class="p-8 border-b border-gray-50 flex justify-between items-center">
        <div>
          <h3 class="text-xl font-bold text-gray-800">Tren Pendaftaran</h3>
          <p class="text-sm text-gray-400">Grafik 30 hari terakhir</p>
        </div>
        <select id="chartTimeline" class="text-xs font-bold bg-gray-50 border-none rounded-lg px-3 py-2 outline-none cursor-pointer">
          <option value="30">30 Hari</option>
          <option value="7">7 Hari</option>
        </select>
      </div>
      <div class="p-8 h-80 w-full">
        <canvas id="registrationChart"></canvas>
      </div>
    </div>

    <!-- Pendaftar Terbaru (4 Col) -->
    <div class="lg:col-span-4 bg-white rounded-[2rem] shadow-xl border border-gray-100 overflow-hidden flex flex-col">
       <div class="p-8 border-b border-gray-50 bg-gray-50/30">
          <h3 class="text-xl font-bold text-gray-800">Aktivitas Baru</h3>
          <p class="text-sm text-gray-400">Pendaftar santri terakhir</p>
       </div>
       <div id="recentList" class="p-4 flex-1 overflow-y-auto max-h-[360px] space-y-3">
          <!-- Item list will be injected here -->
          <div class="animate-pulse flex flex-col gap-4 p-4">
             <div class="h-4 bg-gray-200 rounded w-3/4"></div>
             <div class="h-3 bg-gray-100 rounded w-1/2"></div>
          </div>
       </div>
       <a href="/admin/ppdb" class="p-4 text-center text-sm font-bold text-pesantren hover:bg-green-50 transition-colors border-t border-gray-50">
          Lihat Semua Data
       </a>
    </div>

    <!-- Demografi Program (4 Col) -->
    <div class="lg:col-span-4 bg-white rounded-[2rem] shadow-xl border border-gray-100 p-8 flex flex-col">
        <h3 class="text-xl font-bold text-gray-800 mb-2">Program Studi</h3>
        <p class="text-sm text-gray-400 mb-6">Persentase Pilihan Santri</p>
        <div class="flex-1 min-h-[250px] relative">
            <canvas id="programChart"></canvas>
        </div>
    </div>

    <!-- Ringkasan Konten (8 Col) - Mini Stats Section -->
    <div class="lg:col-span-8 grid grid-cols-1 sm:grid-cols-2 gap-6">
        <div class="bg-gradient-to-br from-gray-900 to-gray-800 rounded-[2rem] p-8 text-white flex items-center justify-between border border-gray-700">
            <div>
               <p class="text-gray-400 text-sm mb-1">Berita Publik</p>
               <h4 class="text-4xl font-display font-black" id="miniBerita">0</h4>
            </div>
            <a href="/admin/berita" class="w-12 h-12 bg-white/10 hover:bg-white/20 rounded-xl flex items-center justify-center transition-all">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" /></svg>
            </a>
        </div>
        <div class="bg-gradient-to-br from-indigo-900 to-indigo-800 rounded-[2rem] p-8 text-white flex items-center justify-between border border-indigo-700">
            <div>
               <p class="text-indigo-300 text-sm mb-1">Total Testimoni</p>
               <h4 class="text-4xl font-display font-black" id="miniTesti">0</h4>
            </div>
             <div class="w-12 h-12 bg-white/10 rounded-xl flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" /></svg>
             </div>
        </div>
    </div>

  </div>

  <style>
    /* Custom Scrollbar for Recent List */
    #recentList::-webkit-scrollbar { width: 4px; }
    #recentList::-webkit-scrollbar-track { background: transparent; }
    #recentList::-webkit-scrollbar-thumb { background: #e5e7eb; border-radius: 10px; }
  </style>

  <script is:inline src="https://cdn.jsdelivr.net/npm/chart.js"></script>

  <script>
    import { supabase } from '../../lib/supabase.js';
    declare const Chart: any;

    let myLineChart: any = null;
    let myPieChart: any = null;

    // Fungsi utama load data
    const loadDashboard = async () => {
        try {
            // 1. Fetch Parallel Data
            const [
                { data: pendaftar },
                { count: beritaCount },
                { count: unreadPesan },
                { count: testiCount },
                { data: donasiData }
            ] = await Promise.all([
                supabase.from('pendaftaran').select('*').order('created_at', { ascending: false }),
                supabase.from('berita').select('*', { count: 'exact', head: true }),
                supabase.from('pesan_masuk').select('*', { count: 'exact', head: true }).eq('status_baca', false),
                supabase.from('testimoni').select('*', { count: 'exact', head: true }),
                supabase.from('donasi').select('*')
            ]);

            // 2. Kalkulasi Statistik
            const totalPendaftar = pendaftar?.length || 0;
            const smpitCount = pendaftar?.filter(p => p.jalur === 'SMPIT').length || 0;
            const smkCount = pendaftar?.filter(p => p.jalur === 'SMK').length || 0;
            const pondokCount = pendaftar?.filter(p => p.jalur === 'Pondok Pesantren').length || 0;
            const unreadInbox = unreadPesan || 0;
            
            // Total Donasi Terverifikasi
            const verifDonasiArr = donasiData?.filter(d => d.status === 'Terverifikasi') || [];
            const sumDonasi = verifDonasiArr.reduce((acc, curr) => acc + Number(curr.jumlah), 0);

            // 3. Update DOM Elements
            const updateText = (id: string, val: string) => {
                const el = document.getElementById(id);
                if (el) el.textContent = val;
            };

            updateText('statTotalPendaftar', totalPendaftar.toString());
            updateText('statSMP', smpitCount.toString());
            updateText('statSMK', smkCount.toString());
            updateText('statPondok', pondokCount.toString());
            updateText('statPesan', unreadInbox.toString());
            updateText('miniBerita', (beritaCount || 0).toString());
            updateText('miniTesti', (testiCount || 0).toString());
            
            // Format IDR Rupiah
            updateText('statDonasi', new Intl.NumberFormat('id-ID', { 
                style: 'currency', 
                currency: 'IDR', 
                maximumFractionDigits: 0 
            }).format(sumDonasi));

            // Indicator Pesan & Donasi (Badge Merah)
            const msgPing = document.getElementById('unreadIndicator');
            if (unreadInbox > 0) msgPing?.classList.remove('hidden'); else msgPing?.classList.add('hidden');

            // 4. Update Akvititas Terbaru (PPDB)
            const recentBox = document.getElementById('recentList');
            if (recentBox && pendaftar) {
                if (pendaftar.length === 0) {
                    recentBox.innerHTML = `<div class="p-8 text-center text-gray-400 text-sm italic">Belum ada aktivitas pendaftaran.</div>`;
                } else {
                    recentBox.innerHTML = pendaftar.slice(0, 7).map(p => `
                        <div class="flex items-center gap-4 p-4 rounded-2xl hover:bg-green-50/50 transition-colors border border-transparent hover:border-green-100 group">
                            <div class="w-10 h-10 rounded-full bg-pesantren/10 text-pesantren flex items-center justify-center font-black text-sm group-hover:bg-pesantren group-hover:text-white transition-colors">
                            ${p.nama_santri.charAt(0)}
                            </div>
                            <div class="flex-1">
                                <h5 class="text-sm font-bold text-gray-800">${p.nama_santri}</h5>
                                <div class="flex items-center gap-2">
                                    <p class="text-[10px] text-gray-400 font-bold uppercase tracking-tight">${p.jalur}</p>
                                    <span class="w-1 h-1 bg-gray-300 rounded-full"></span>
                                    <span class="text-[10px] ${p.status === 'Tertunda' ? 'text-amber-600' : 'text-green-600'} font-black uppercase">${p.status}</span>
                                </div>
                            </div>
                            <span class="text-[10px] text-gray-400 font-bold">${new Date(p.created_at).toLocaleDateString('id-ID', {day:'2-digit', month:'short'})}</span>
                        </div>
                    `).join('');
                }
            }

            // 5. Update Charts
            if (typeof Chart !== 'undefined') {
                renderCharts(pendaftar || []);
            }

        } catch (err) {
            console.error('Dash Error:', err);
        }
    };

    const renderCharts = (data: any[]) => {
        // --- LINE CHART: TREND PENDAFTARAN ---
        const ctxL = document.getElementById('registrationChart') as HTMLCanvasElement;
        if (!ctxL) return;

        const timeline = 30; // 30 hari terakhir
        const dailyStats = [...Array(timeline)].map((_, i) => {
            const d = new Date();
            d.setDate(d.getDate() - (timeline - 1 - i));
            return { 
                dateStr: d.toISOString().split('T')[0], 
                label: d.toLocaleDateString('id-ID', { day: 'numeric', month: 'short' }), 
                count: 0 
            };
        });

        data.forEach(p => {
            const pDate = new Date(p.created_at).toISOString().split('T')[0];
            const found = dailyStats.find(s => s.dateStr === pDate);
            if (found) found.count++;
        });

        if (myLineChart) myLineChart.destroy();
        myLineChart = new Chart(ctxL, {
            type: 'line',
            data: {
                labels: dailyStats.map(s => s.label),
                datasets: [{
                    label: 'Pendaftaran',
                    data: dailyStats.map(s => s.count),
                    borderColor: '#15803d',
                    backgroundColor: 'rgba(21, 128, 61, 0.05)',
                    fill: true,
                    tension: 0.4,
                    borderWidth: 3,
                    pointRadius: 4,
                    pointBackgroundColor: '#fff',
                    pointBorderColor: '#15803d',
                    pointBorderWidth: 2,
                    pointHoverRadius: 6
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false }, tooltip: { mode: 'index', intersect: false } },
                scales: {
                    y: { beginAtZero: true, ticks: { stepSize: 1, color: '#9ca3af', font: { size: 10 } }, grid: { color: '#f3f4f6' } },
                    x: { ticks: { color: '#9ca3af', font: { size: 10 } }, grid: { display: false } }
                }
            }
        });

        // --- DONUT CHART: PROGRAM STUDI ---
        const ctxP = document.getElementById('programChart') as HTMLCanvasElement;
        if (!ctxP) return;

        const jalurCounts = {
            'SMPIT': data.filter(p => p.jalur === 'SMPIT').length,
            'SMK': data.filter(p => p.jalur === 'SMK').length,
            'Pondok': data.filter(p => p.jalur === 'Pondok Pesantren').length
        };

        if (myPieChart) myPieChart.destroy();
        myPieChart = new Chart(ctxP, {
            type: 'doughnut',
            data: {
                labels: ['SMPIT', 'SMK IT', 'Pondok'],
                datasets: [{
                    data: [jalurCounts.SMPIT, jalurCounts.SMK, jalurCounts.Pondok],
                    backgroundColor: ['#3b82f6', '#f59e0b', '#15803d'],
                    borderWidth: 8,
                    borderColor: '#ffffff',
                    hoverOffset: 15
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                cutout: '75%',
                plugins: {
                    legend: { position: 'bottom', labels: { usePointStyle: true, padding: 30, font: { size: 12, weight: 'bold' } } }
                }
            }
        });
    };

    // --- REALTIME SUBSCRIPTION (Supabase Magic) ---
    const subscribeRealtime = () => {
        const tables = ['pendaftaran', 'pesan_masuk', 'donasi', 'berita', 'testimoni'];
        
        tables.forEach(table => {
            supabase
                .channel(`public:${table}`)
                .on('postgres_changes', { event: '*', schema: 'public', table: table }, () => {
                    console.log(`Change detected in ${table}, refreshing dashboard...`);
                    loadDashboard();
                })
                .subscribe();
        });
    };

    // --- INITIALIZE ---
    document.addEventListener('DOMContentLoaded', async () => {
        await loadDashboard();
        subscribeRealtime();
    });
  </script>
</AdminLayout>
