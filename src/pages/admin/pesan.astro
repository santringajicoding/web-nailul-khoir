---
import AdminLayout from '../../layouts/AdminLayout.astro';
---
<AdminLayout title="Kotak Masuk Pesan">
  
  <div class="mb-8 flex justify-between items-end">
    <div>
      <h2 class="text-3xl font-extrabold text-gray-900 tracking-tight">Kotak Masuk</h2>
      <p class="text-gray-600 mt-2 text-lg">Kelola pesan dan pertanyaan dari publik.</p>
    </div>
    <span class="bg-emas text-pesantren px-3 py-1 rounded-full text-xs font-bold" id="unreadBadge">0 Belum Dibaca</span>
  </div>

  <div class="bg-white rounded-2xl shadow-xl overflow-hidden border border-gray-100">
    <div class="p-4 sm:p-6 border-b border-gray-100 bg-gray-50 flex justify-between items-center">
      <div class="font-bold text-gray-700 block">Daftar Pertanyaan</div>
      <button id="btnRefreshMsg" class="bg-gray-800 hover:bg-gray-900 text-white px-4 py-2 rounded-lg text-sm font-bold shadow-sm transition-all flex items-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" /></svg>
        Segarkan
      </button>
    </div>

    <div class="overflow-x-auto min-h-[400px]">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-white">
          <tr>
            <th scope="col" class="px-6 py-4 text-left text-xs font-black text-gray-500 uppercase tracking-widest bg-gray-50">Waktu</th>
            <th scope="col" class="px-6 py-4 text-left text-xs font-black text-gray-500 uppercase tracking-widest bg-gray-50">Pengirim</th>
            <th scope="col" class="px-6 py-4 text-left text-xs font-black text-gray-500 uppercase tracking-widest bg-gray-50">Isi Pesan</th>
            <th scope="col" class="px-6 py-4 text-center text-xs font-black text-gray-500 uppercase tracking-widest bg-gray-50">Aksi</th>
          </tr>
        </thead>
        <tbody id="pesanTableBody" class="bg-white divide-y divide-gray-100">
          <tr>
            <td colspan="4" class="px-6 py-12 text-center text-gray-500">
              <div class="flex flex-col items-center justify-center">
                <svg class="animate-spin h-8 w-8 text-pesantren mb-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
                <p class="font-medium">Memuat pesan masuk...</p>
              </div>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <script>
    import { supabase } from '../../lib/supabase.js';

    // Format tanggal
    function formatDate(dateStr: string) {
      const date = new Date(dateStr);
      return date.toLocaleDateString('id-ID', { year: 'numeric', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) + ' WIB';
    }

    const loadPesan = async () => {
      // 1. Cek sesi
      const { data: { session } } = await supabase.auth.getSession();
      if (!session) {
        window.location.replace('/admin/login');
        return;
      }

      const tbody = document.getElementById('pesanTableBody');
      const unreadBadge = document.getElementById('unreadBadge');
      if (!tbody) return;

      tbody.innerHTML = `<tr><td colspan="4" class="text-center py-10 text-gray-500">Menyinkronkan...</td></tr>`;

      // 2. Tarik pesan
      const { data, error } = await supabase
        .from('pesan_masuk')
        .select('*')
        .order('created_at', { ascending: false });

      if (error) {
        tbody.innerHTML = `<tr><td colspan="4" class="py-10 text-center font-bold text-red-600 bg-red-50">Gagal memuat pesan: ${error.message}</td></tr>`;
        return;
      }

      if (!data || data.length === 0) {
        tbody.innerHTML = `<tr><td colspan="4" class="py-16 text-center text-gray-500 text-lg font-medium">Kotak masuk masih kosong.</td></tr>`;
        if (unreadBadge) unreadBadge.textContent = '0 Belum Dibaca';
        return;
      }

      // Hitung belum dibaca
      const unreadCount = data.filter(p => !p.status_baca).length;
      if (unreadBadge) unreadBadge.textContent = `${unreadCount} Belum Dibaca`;

      // 3. Render Baris Pesan
      tbody.innerHTML = data.map(item => `
        <tr class="transition-colors duration-200 ${item.status_baca ? 'bg-white hover:bg-gray-50' : 'bg-blue-50/50 border-l-4 border-l-blue-500 hover:bg-blue-50'}">
          <td class="px-6 py-5 whitespace-nowrap text-sm ${item.status_baca ? 'text-gray-500' : 'text-blue-800 font-bold'}">
            ${formatDate(item.created_at)}
          </td>
          <td class="px-6 py-5">
            <div class="text-base font-bold ${item.status_baca ? 'text-gray-900' : 'text-blue-900'} mb-1">${item.nama}</div>
            <div class="text-sm text-gray-600 flex items-center">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
              ${item.kontak}
            </div>
          </td>
          <td class="px-6 py-5">
            <p class="text-sm ${item.status_baca ? 'text-gray-700' : 'text-gray-900 font-medium'} line-clamp-3 w-full max-w-xl pr-4">
              ${item.pesan.replace(/</g, "&lt;").replace(/>/g, "&gt;")}
            </p>
          </td>
          <td class="px-6 py-5 whitespace-nowrap text-center text-sm">
            <div class="flex flex-col items-center justify-center space-y-2">
              ${!item.status_baca ? 
                `<button data-action="baca" data-id="${item.id}" class="w-full text-white bg-blue-600 hover:bg-blue-700 px-3 py-1.5 rounded-md text-xs font-bold shadow-sm transition-colors">Tandai Dibaca</button>` 
                : 
                `<span class="text-xs font-bold text-gray-400 bg-gray-100 px-3 py-1.5 rounded-md w-full block">Telah Dibaca</span>`
              }
              <button data-action="hapus" data-id="${item.id}" class="w-full text-red-600 hover:text-white bg-red-50 hover:bg-red-600 border border-red-200 hover:border-transparent px-3 py-1.5 rounded-md text-xs font-bold transition-colors">
                Hapus
              </button>
            </div>
          </td>
        </tr>
      `).join('');
    };

    // Fungsi Aksi
    const updateStatusBaca = async (id: string) => {
      const { error } = await supabase.from('pesan_masuk').update({ status_baca: true }).eq('id', id);
      if (!error) loadPesan();
    };

    const deletePesan = async (id: string) => {
      if(confirm('Hapus pesan ini secara permanen?')) {
        const { error } = await supabase.from('pesan_masuk').delete().eq('id', id);
        if (!error) loadPesan();
      }
    };

    document.addEventListener('DOMContentLoaded', () => {
      loadPesan();
      
      const btnRefreshMsg = document.getElementById('btnRefreshMsg');
      if (btnRefreshMsg) btnRefreshMsg.addEventListener('click', loadPesan);

      const tbody = document.getElementById('pesanTableBody');
      if (tbody) {
        tbody.addEventListener('click', (e) => {
          const target = (e.target as Element).closest('button');
          if (!target) return;

          const action = target.getAttribute('data-action');
          const id = target.getAttribute('data-id');

          if (!id) return;
          if (action === 'baca') updateStatusBaca(id);
          if (action === 'hapus') deletePesan(id);
        });
      }
    });
  </script>
</AdminLayout>
