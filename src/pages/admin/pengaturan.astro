---
import AdminLayout from '../../layouts/AdminLayout.astro';
---
<AdminLayout title="Desain & Beranda">
  <div class="mb-8">
    <h2 class="text-3xl font-extrabold text-gray-900 tracking-tight">Pengaturan Desain & Beranda</h2>
    <p class="text-gray-600 mt-2 text-lg">Ubah foto latar belakang halaman utama (Hero Section) dan pengaturan publik lainnya.</p>
  </div>

  <div class="bg-white p-6 md:p-8 rounded-2xl border border-gray-100 shadow-xl mb-8">
    <h3 class="text-xl font-bold text-gray-800 mb-6 border-b pb-3">Foto Latar Belakang (Hero Image)</h3>
    
    <div id="alertFormName" class="hidden mb-4 p-4 rounded-xl text-sm font-bold border"></div>

    <form id="formHeroBg" class="space-y-6">
      <div>
        <label class="block text-sm font-bold text-gray-700 mb-3">Tampilan Latar Belakang Saat Ini</label>
        <div class="w-full h-48 md:h-64 bg-gray-100 rounded-xl overflow-hidden shadow-inner border-2 border-dashed border-gray-300 relative flex items-center justify-center">
          <img id="currentHeroImg" src="/images/hero-bg.jpg" alt="Current Hero Background" class="absolute inset-0 w-full h-full object-cover z-0 opacity-50" onerror="this.style.display='none'; document.getElementById('noImgText').style.display='block';" />
          <div id="noImgText" class="z-10 text-gray-500 font-medium hidden">Belum ada foto yang diunggah (Masih menggunakan foto bawaan template)</div>
          <div class="absolute inset-0 bg-gradient-to-r from-green-900/50 to-pesantren/50 mix-blend-multiply z-10 pointer-events-none"></div>
        </div>
      </div>

      <div>
        <label class="block text-sm font-bold text-gray-700 mb-2">Unggah Foto Baru Resolusi Tinggi (Direkomendasikan Lanskap)</label>
        <input type="file" id="hero_file" name="hero_file" accept="image/*" required class="w-full px-4 py-3 text-sm text-gray-700 rounded-xl border border-gray-300 focus:ring-2 focus:ring-pesantren outline-none file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-semibold file:bg-green-50 file:text-green-700 hover:file:bg-green-100 cursor-pointer shadow-sm">
        <p class="text-xs text-gray-500 mt-2">Format yang didukung: JPG, PNG. Ukuran maksimal: 5MB.</p>
      </div>

      <div class="pt-4 border-t border-gray-100 flex justify-end">
        <button type="submit" id="btnSubmitData" class="bg-pesantren hover:bg-green-800 text-white font-bold py-3 px-8 rounded-xl shadow-md hover:shadow-lg transition-transform hover:-translate-y-0.5 flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" />
          </svg>
          <span id="btnSubmitText">Terapkan Latar Belakang Baru</span>
        </button>
      </div>
    </form>
  </div>

  <!-- Alert Persyaratan Database dihapus karena tabel sudah berhasil terhubung. -->

  <script>
    import { supabase } from '../../lib/supabase.js';

    async function init() {
      const { data: { session } } = await supabase.auth.getSession();
      if (!session) return window.location.replace('/admin/login');
      loadCurrentSettings();
    }

    async function loadCurrentSettings() {
      // Mengambil URL foto latar belakang dari Supabase (jika ada)
      try {
        const { data, error } = await supabase
          .from('pengaturan_web')
          .select('value')
          .eq('key', 'hero_bg_url')
          .single();
          
        if (data && data.value) {
          const imgEl = document.getElementById('currentHeroImg') as HTMLImageElement;
          if (imgEl) {
            imgEl.src = data.value;
            imgEl.style.display = 'block';
            const noneText = document.getElementById('noImgText');
            if (noneText) noneText.style.display = 'none';
          }
        }
      } catch (err) {
        // Abaikan jika tabel belum ada atau kosong
        console.log("Belum ada pengaturan custom, menggunakan template default.");
      }
    }

    const form = document.getElementById('formHeroBg') as HTMLFormElement;
    if (form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const btn = document.getElementById('btnSubmitData') as HTMLButtonElement;
        const btnText = document.getElementById('btnSubmitText');
        const alertMsg = document.getElementById('alertFormName');
        const fileInput = document.getElementById('hero_file') as HTMLInputElement;
        
        btn.disabled = true;
        if(btnText) btnText.textContent = 'Mengunggah Foto...';

        try {
          if (!fileInput.files || fileInput.files.length === 0) {
            throw new Error("Pilih foto terlebih dahulu.");
          }

          const file = fileInput.files[0];
          const fileExt = file.name.split('.').pop();
          // Gunakan nama konstan agar selalu menimpa/bisa diidentifikasi, atau pakai timestamp (dipilih timestamp untuk cache busting cache peramban)
          const fileName = `hero-bg-${Date.now()}.${fileExt}`;
          
          // 1. Unggah ke Storage (Menggunakan bucket yang sudah ada: berita_images)
          const { data: uploadData, error: uploadError } = await supabase.storage
            .from('berita_images')
            .upload(`system/${fileName}`, file, { cacheControl: '3600', upsert: true });

          if (uploadError) throw new Error('Gagal unggah foto ke Storage: ' + uploadError.message);
          
          // 2. Dapatkan URL Akses Publik
          const { data: publicUrlData } = supabase.storage.from('berita_images').getPublicUrl(`system/${fileName}`);
          const publicUrl = publicUrlData.publicUrl;

          if(btnText) btnText.textContent = 'Menyimpan Pengaturan...';

          // 3. Simpan setting ke Database (Upsert/Insert)
          // Memeriksa apakah tabel `pengaturan_web` memiliki entry 'hero_bg_url'
          const { data: checkData } = await supabase.from('pengaturan_web').select('id').eq('key', 'hero_bg_url').single();

          let dbError;
          if (checkData) {
            // Update jika key sudah ada
            const { error: err1 } = await supabase.from('pengaturan_web').update({ value: publicUrl }).eq('key', 'hero_bg_url');
            dbError = err1;
          } else {
            // Insert baru
            const { error: err2 } = await supabase.from('pengaturan_web').insert([{ key: 'hero_bg_url', value: publicUrl }]);
            dbError = err2;
          }

          if (dbError) throw new Error('Gagal mencatat tautan foto ke dalam Database: Pastikan telah membuat tabel "pengaturan_web". (' + dbError.message + ')');

          // Berhasil!
          if (alertMsg) { 
            alertMsg.textContent = '✅ Latar Belakang berhasil diperbarui! Perubahan sudah diterapkan di Beranda.'; 
            alertMsg.className = 'block mb-4 p-4 rounded-xl font-bold bg-green-100 text-green-800 border border-green-300'; 
          }
          
          form.reset();
          loadCurrentSettings();

        } catch (error: any) {
          if (alertMsg) { 
            alertMsg.textContent = '⚠️ ' + error.message; 
            alertMsg.className = 'block mb-4 p-4 rounded-xl font-bold bg-red-100 text-red-800 border border-red-300'; 
          }
        } finally {
          btn.disabled = false;
          if(btnText) btnText.textContent = 'Terapkan Latar Belakang Baru';
        }
      });
    }

    document.addEventListener('DOMContentLoaded', init);
  </script>
</AdminLayout>
