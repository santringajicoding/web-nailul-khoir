---
import AdminLayout from '../../layouts/AdminLayout.astro';
---
<AdminLayout title="Desain & Kontak">
  <div class="mb-8">
    <h2 class="text-3xl font-extrabold text-gray-900 tracking-tight">Pengaturan Website</h2>
    <p class="text-gray-600 mt-2 text-lg">Kelola desain beranda dan informasi kontak pesantren secara terpusat.</p>
  </div>

  <div id="alertGlobal" class="hidden mb-6 p-4 rounded-xl text-sm font-bold border shadow-md"></div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
    <!-- SEKSI 1: DESAIN HERO -->
    <div class="bg-white p-6 md:p-8 rounded-2xl border border-gray-100 shadow-xl overflow-hidden">
      <h3 class="text-xl font-bold text-gray-800 mb-6 border-b pb-3 flex items-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-pesantren" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
        Foto Latar Belakang (Hero)
      </h3>
      
      <form id="formHeroBg" class="space-y-6">
        <div>
          <label class="block text-sm font-bold text-gray-700 mb-3">Tampilan Latar Belakang Saat Ini</label>
          <div class="w-full h-48 bg-gray-100 rounded-xl overflow-hidden shadow-inner border-2 border-dashed border-gray-300 relative flex items-center justify-center">
            <img id="currentHeroImg" src="/images/hero-bg.jpg" alt="Current Hero Background" class="absolute inset-0 w-full h-full object-cover z-0 opacity-50" onerror="this.style.display='none'; document.getElementById('noImgText').style.display='block';" />
            <div id="noImgText" class="z-10 text-gray-500 font-medium hidden">Gagal memuat atau belum ada foto custom.</div>
            <div class="absolute inset-0 bg-gradient-to-r from-green-900/40 to-pesantren/40 mix-blend-multiply z-10 pointer-events-none"></div>
          </div>
        </div>

        <div>
          <label class="block text-sm font-bold text-gray-700 mb-2">Unggah Foto Baru (Lanskap)</label>
          <input type="file" id="hero_file" name="hero_file" accept="image/*" class="w-full px-4 py-3 text-sm text-gray-700 rounded-xl border border-gray-300 focus:ring-2 focus:ring-pesantren outline-none file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-semibold file:bg-green-50 file:text-green-700 cursor-pointer shadow-sm">
        </div>

        <button type="submit" id="btnHero" class="w-full bg-pesantren hover:bg-green-800 text-white font-bold py-3.5 rounded-xl shadow-md transition-all flex items-center justify-center gap-2">
            <span id="btnHeroText">Update Hero Background</span>
        </button>
      </form>
    </div>

    <!-- SEKSI 2: INFORMASI KONTAK -->
    <div class="bg-white p-6 md:p-8 rounded-2xl border border-gray-100 shadow-xl overflow-hidden">
      <h3 class="text-xl font-bold text-gray-800 mb-6 border-b pb-3 flex items-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-pesantren" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
        Informasi Kontak & Footer
      </h3>
      
      <form id="formKontak" class="space-y-4">
        <div>
          <label class="block text-sm font-bold text-gray-700 mb-1">Nomor WhatsApp (Contoh: 628xxx)</label>
          <input type="text" id="contact_wa" placeholder="Format: 628123456789" class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:ring-2 focus:ring-pesantren outline-none transition-all">
        </div>

        <div>
          <label class="block text-sm font-bold text-gray-700 mb-1">Email Pesantren</label>
          <input type="email" id="contact_email" placeholder="Contoh: info@nailulkhoir.com" class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:ring-2 focus:ring-pesantren outline-none transition-all">
        </div>

        <div>
           <label class="block text-sm font-bold text-gray-700 mb-1">Alamat Lengkap</label>
           <textarea id="contact_address" rows="3" class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:ring-2 focus:ring-pesantren outline-none transition-all resize-none"></textarea>
        </div>

        <button type="submit" id="btnKontak" class="w-full bg-pesantren hover:bg-green-800 text-white font-bold py-3.5 rounded-xl shadow-md transition-all flex items-center justify-center gap-2">
            Simpan Perubahan Kontak
        </button>
      </form>
    </div>

    <!-- SEKSI 3: BROSUR PPDB -->
    <div class="bg-white p-6 md:p-8 rounded-2xl border border-gray-100 shadow-xl overflow-hidden lg:col-span-2">
      <h3 class="text-xl font-bold text-gray-800 mb-6 border-b pb-3 flex items-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-pesantren" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
        Brosur Pendaftaran PPDB (PDF)
      </h3>
      
      <form id="formBrosur" class="space-y-6">
        <div>
          <label class="block text-sm font-bold text-gray-700 mb-3">Link Brosur PDF Saat Ini</label>
          <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
             <input type="text" id="current_brosur_url" readonly class="flex-grow px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl text-sm outline-none text-gray-500" placeholder="Belum ada brosur terunggah.">
             <a href="" id="btnDownloadCurrent" target="_blank" class="hidden px-5 py-3 bg-green-50 text-pesantren font-bold rounded-xl border border-green-200 text-sm hover:bg-pesantren hover:text-white transition-all text-center">Lihat File</a>
          </div>
        </div>

        <div>
          <label class="block text-sm font-bold text-gray-700 mb-2">Unggah File Brosur Baru (Format PDF)</label>
          <input type="file" id="brosur_file" name="brosur_file" accept=".pdf,application/pdf" class="w-full px-4 py-3 text-sm text-gray-700 rounded-xl border border-gray-300 focus:ring-2 focus:ring-pesantren outline-none file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-semibold file:bg-green-50 file:text-green-700 cursor-pointer shadow-sm">
        </div>

        <button type="submit" id="btnBrosur" class="bg-pesantren hover:bg-green-800 text-white font-bold py-3.5 px-8 rounded-xl shadow-md transition-all flex items-center justify-center gap-2">
            <span id="btnBrosurText">Unggah & Perbarui Brosur</span>
        </button>
      </form>
    </div>
  </div>

  <script>
    import { supabase } from '../../lib/supabase.js';

    function init() {
      loadSettings();
    }

    async function loadSettings() {
      try {
        const { data, error } = await supabase.from('pengaturan_web').select('*');
        if (data) {
          data.forEach(item => {
            if (item.key === 'hero_bg_url') {
              const img = document.getElementById('currentHeroImg') as HTMLImageElement;
              if (img) img.src = item.value;
            }
            if (item.key === 'brosur_pdf_url') {
              const urlInput = document.getElementById('current_brosur_url') as HTMLInputElement;
              const downloadLink = document.getElementById('btnDownloadCurrent') as HTMLAnchorElement;
              if (urlInput) urlInput.value = item.value;
              if (downloadLink) {
                 downloadLink.href = item.value;
                 downloadLink.classList.remove('hidden');
              }
            }
            const input = document.getElementById(item.key) as (HTMLInputElement | HTMLTextAreaElement);
            if (input) input.value = item.value;
          });
        }
      } catch (err) {
        console.error("Gagal memuat pengaturan:", err);
      }
    }

    const setAlert = (msg: string, type: 'success' | 'error') => {
      const alert = document.getElementById('alertGlobal');
      if (alert) {
        alert.textContent = (type === 'success' ? '✅ ' : '⚠️ ') + msg;
        alert.className = `block mb-6 p-4 rounded-xl font-bold border ${type === 'success' ? 'bg-green-50 text-green-800 border-green-200' : 'bg-red-50 text-red-800 border-red-200'}`;
        setTimeout(() => alert.classList.add('hidden'), 5000);
      }
    };

    // FORM HERO BG
    const formHero = document.getElementById('formHeroBg');
    formHero?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = document.getElementById('btnHero') as HTMLButtonElement;
      const fileInput = document.getElementById('hero_file') as HTMLInputElement;
      
      if (!fileInput.files || fileInput.files.length === 0) return setAlert("Pilih foto terlebih dahulu.", "error");

      btn.disabled = true;
      btn.textContent = 'Mengunggah...';

      try {
        const file = fileInput.files[0];
        const fileName = `hero-bg-${Date.now()}.${file.name.split('.').pop()}`;
        
        const { error: uploadError } = await supabase.storage
          .from('berita_images')
          .upload(`system/${fileName}`, file, { cacheControl: '3600', upsert: true });

        if (uploadError) throw uploadError;
        
        const { data: { publicUrl } } = supabase.storage.from('berita_images').getPublicUrl(`system/${fileName}`);

        const { error: dbError } = await supabase.from('pengaturan_web').upsert({ key: 'hero_bg_url', value: publicUrl }, { onConflict: 'key' });
        if (dbError) throw dbError;

        setAlert("Foto Latar Belakang berhasil diperbarui!", "success");
        loadSettings();
      } catch (err: any) {
        setAlert(err.message, "error");
      } finally {
        btn.disabled = false;
        btn.textContent = 'Update Hero Background';
      }
    });

    // FORM KONTAK
    const formKontak = document.getElementById('formKontak');
    formKontak?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = document.getElementById('btnKontak') as HTMLButtonElement;
      btn.disabled = true;
      btn.textContent = 'Menyimpan...';

      const keys = ['contact_wa', 'contact_email', 'contact_address'];
      const payloads = keys.map(k => ({
        key: k,
        value: (document.getElementById(k) as HTMLInputElement).value
      }));

      try {
        const { error } = await supabase.from('pengaturan_web').upsert(payloads, { onConflict: 'key' });
        if (error) throw error;
        setAlert("Informasi Kontak berhasil disimpan!", "success");
      } catch (err: any) {
        setAlert(err.message, "error");
      } finally {
        btn.disabled = false;
        btn.textContent = 'Simpan Perubahan Kontak';
      }
    });

    // FORM BROSUR PPDB
    const formBrosur = document.getElementById('formBrosur');
    formBrosur?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = document.getElementById('btnBrosur') as HTMLButtonElement;
      const btnText = document.getElementById('btnBrosurText');
      const fileInput = document.getElementById('brosur_file') as HTMLInputElement;

      if (!fileInput.files || fileInput.files.length === 0) return setAlert("Pilih file PDF terlebih dahulu.", "error");

      btn.disabled = true;
      if (btnText) btnText.textContent = 'Mengunggah...';

      try {
        const file = fileInput.files[0];
        const fileName = `brosur-ppdb-${Date.now()}.pdf`;

        const { error: uploadError } = await supabase.storage
          .from('berita_images')
          .upload(`system/${fileName}`, file, { cacheControl: '3600', upsert: true });

        if (uploadError) throw uploadError;

        const { data: { publicUrl } } = supabase.storage.from('berita_images').getPublicUrl(`system/${fileName}`);

        const { error: dbError } = await supabase.from('pengaturan_web').upsert({ key: 'brosur_pdf_url', value: publicUrl }, { onConflict: 'key' });
        if (dbError) throw dbError;

        setAlert("Brosur PDF berhasil diperbarui!", "success");
        loadSettings();
      } catch (err: any) {
        setAlert(err.message, "error");
      } finally {
        btn.disabled = false;
        if (btnText) btnText.textContent = 'Unggah & Perbarui Brosur';
      }
    });

    document.addEventListener('DOMContentLoaded', init);
  </script>
</AdminLayout>
