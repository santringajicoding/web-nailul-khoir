---
import AdminLayout from '../../layouts/AdminLayout.astro';
---
<AdminLayout title="Konfirmasi Donasi">
  
  <div class="mb-8">
    <h2 class="text-3xl font-extrabold text-gray-900 tracking-tight">Data Donasi Masuk</h2>
    <p class="text-gray-600 mt-2 text-lg">Pantau konfirmasi donasi dari para muhsinin untuk pembangunan dan operasional pesantren.</p>
  </div>

  <div class="bg-white rounded-2xl shadow-xl overflow-hidden border border-gray-100 p-6 flex flex-col md:flex-row justify-between gap-4 mb-8">
      <div class="flex items-center gap-4">
          <div class="bg-emas text-white p-3 rounded-2xl shadow-lg">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
          </div>
          <div>
              <p class="text-sm font-bold text-gray-400 uppercase tracking-widest leading-none mb-1">Total Donasi Terverifikasi</p>
              <h3 class="text-2xl font-black text-gray-900" id="totalVerifiedAmount">Rp 0</h3>
          </div>
      </div>
      <button id="btnRefresh" class="bg-pesantren hover:bg-green-800 text-white px-6 py-3 rounded-xl font-bold shadow-md transition-all flex items-center gap-2 justify-center">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" /></svg>
          Segarkan Data
      </button>
  </div>

  <div class="bg-white rounded-2xl shadow-xl overflow-hidden border border-gray-100">
    <div class="overflow-x-auto min-h-[400px]">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-4 text-left text-xs font-black text-gray-500 uppercase tracking-widest">Waktu</th>
            <th class="px-6 py-4 text-left text-xs font-black text-gray-500 uppercase tracking-widest">Nama Donatur</th>
            <th class="px-6 py-4 text-left text-xs font-black text-gray-500 uppercase tracking-widest">Jumlah</th>
            <th class="px-6 py-4 text-left text-xs font-black text-gray-500 uppercase tracking-widest">Status</th>
            <th class="px-6 py-4 text-left text-xs font-black text-gray-500 uppercase tracking-widest">Bukti Transfer</th>
            <th class="px-6 py-4 text-center text-xs font-black text-gray-500 uppercase tracking-widest">Aksi</th>
          </tr>
        </thead>
        <tbody id="donasiTableBody" class="bg-white divide-y divide-gray-100">
           <tr><td colspan="6" class="p-20 text-center text-gray-500">Memuat data...</td></tr>
        </tbody>
      </table>
    </div>
  </div>

  <script>
    import { supabase } from '../../lib/supabase.js';

    const loadDonasi = async () => {
      const tbody = document.getElementById('donasiTableBody');
      const totalAmountEl = document.getElementById('totalVerifiedAmount');
      if(!tbody) return;

      console.log("AdminDonasi: Mencoba memuat data 'donasi'...");
      const { data, error, count } = await supabase.from('donasi').select('*', { count: 'exact' }).order('created_at', { ascending: false });
      
      if (error) {
        console.error("AdminDonasi Error:", error);
        tbody.innerHTML = `<tr><td colspan="6" class="p-8 text-center text-red-500 font-bold bg-red-50">Gagal Mengambil Data: ${error.message}<br><span class="text-xs font-normal">Hint: ${error.hint || '-'}</span></td></tr>`;
        return;
      }

      console.log("AdminDonasi Success:", data?.length || 0, "baris ditemukan.");
      
      const formatIDR = (num: number) => new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', maximumFractionDigits: 0 }).format(num);
      
      const totalVerified = (data || []).filter(d => d.status === 'Terverifikasi').reduce((acc, curr) => acc + Number(curr.jumlah), 0);
      if(totalAmountEl) totalAmountEl.textContent = formatIDR(totalVerified);

      if (!data || data.length === 0) {
        tbody.innerHTML = `<tr><td colspan="6" class="p-24 text-center text-gray-400 font-medium italic bg-gray-50/50">
          <svg class="w-12 h-12 mx-auto mb-4 opacity-20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path></svg>
          Sistem Terhubung (0 Data)<br>Belum ada pendaftaran donasi baru yang masuk ke database.
        </td></tr>`;
        return;
      }

      tbody.innerHTML = data.map(item => `
        <tr class="hover:bg-green-50/30 transition-colors border-b border-gray-100">
          <td class="px-6 py-4 whitespace-nowrap text-[10px] text-gray-400 font-bold uppercase tracking-tighter">
            ${new Date(item.created_at).toLocaleDateString('id-ID', {day:'2-digit', month:'short', year:'numeric'})}<br>
            <span class="text-gray-300 font-normal">${new Date(item.created_at).toLocaleTimeString('id-ID', {hour:'2-digit', minute:'2-digit'})}</span>
          </td>
          <td class="px-6 py-4 whitespace-nowrap">
            <div class="text-sm font-bold text-gray-900">${item.nama_donatur}</div>
            <div class="text-xs text-gray-500 flex items-center gap-1">
               <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
               ${item.kontak}
            </div>
          </td>
          <td class="px-6 py-4 whitespace-nowrap">
             <div class="text-sm font-black text-pesantren">${formatIDR(item.jumlah)}</div>
             <div class="text-[10px] text-gray-400 font-bold uppercase">${item.metode}</div>
          </td>
          <td class="px-6 py-4 whitespace-nowrap">
            <span class="px-3 py-1 text-[10px] font-black uppercase rounded-full shadow-sm border ${item.status === 'Terverifikasi' ? 'bg-green-100 border-green-200 text-green-700' : 'bg-yellow-100 border-yellow-200 text-yellow-700'}">${item.status}</span>
          </td>
          <td class="px-6 py-4 whitespace-nowrap">
            ${item.bukti_url ? `<a href="${item.bukti_url}" target="_blank" class="text-blue-600 hover:text-white hover:bg-blue-600 border border-blue-600 px-3 py-1 rounded-full text-[10px] font-black transition-all flex items-center gap-1 w-max group"><svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" /></svg> LIHAT STRUK</a>` : '<span class="text-gray-300 italic text-xs">Tanpa Lampiran</span>'}
          </td>
          <td class="px-6 py-4 whitespace-nowrap text-center">
             <div class="flex justify-center gap-2">
                ${item.status === 'Tertunda' ? `<button data-action="verify" data-id="${item.id}" class="bg-pesantren text-white px-4 py-2 rounded-xl text-[10px] font-black hover:bg-green-800 transition-all shadow-md hover:shadow-lg hover:-translate-y-0.5 active:translate-y-0">VERIFIKASI</button>` : ''}
                <button data-action="delete" data-id="${item.id}" class="text-red-500 hover:bg-red-50 p-2 rounded-xl transition-all border border-transparent hover:border-red-100" title="Hapus"><svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg></button>
             </div>
          </td>
        </tr>
      `).join('');
    };

    const init = () => {
      loadDonasi();
      document.getElementById('btnRefresh')?.addEventListener('click', loadDonasi);

      const tbody = document.getElementById('donasiTableBody');
      if (tbody) {
        tbody.addEventListener('click', async (e) => {
          const target = (e.target as Element).closest('button');
          if (!target) return;
          const action = target.getAttribute('data-action');
          const id = target.getAttribute('data-id');

          if (action === 'verify') {
             try {
                const { error } = await supabase.from('donasi').update({ status: 'Terverifikasi' }).eq('id', id);
                if (error) throw error;
                loadDonasi();
             } catch (err: any) { alert("Verifikasi Gagal: " + err.message); }
          } else if (action === 'delete') {
            if(confirm('Hapus data donasi ini secara permanen?')) {
               try {
                  const { error } = await supabase.from('donasi').delete().eq('id', id);
                  if (error) throw error;
                  loadDonasi();
               } catch (err: any) { alert("Hapus Gagal: " + err.message); }
            }
          }
        });
      }

      // --- REALTIME SUBSCRIPTION ---
      try {
          supabase.channel('donasi-realtime')
            .on('postgres_changes', { event: '*', schema: 'public', table: 'donasi' }, () => {
              console.log('Realtime change in donasi table!');
              loadDonasi();
            })
            .subscribe((status) => {
                console.log("Realtime Donasi Status:", status);
            });
      } catch (e) {
          console.error("Realtime Init Error:", e);
      }
    };

    document.addEventListener('DOMContentLoaded', init);
  </script>
</AdminLayout>
