---
import MainLayout from '../layouts/MainLayout.astro';
---
<MainLayout 
  title="SMPIT Nailul Khoir" 
  description="SMP Islam Terpadu (SMPIT) Nailul Khoir memadukan kurikulum nasional dengan tradisi pesantren salaf untuk membentuk kader muslim yang cerdas dan berakhlak.">
  <!-- Hero Section -->
  <div class="relative bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-green-800 via-pesantren to-[#032415] py-20 md:py-32 text-white overflow-hidden">
    <div class="absolute inset-0 opacity-10 mix-blend-overlay bg-[url('https://www.transparenttextures.com/patterns/arabesque.png')]"></div>
    <div class="absolute inset-0 bg-gradient-to-b from-transparent to-[#0a1f11]/80"></div>
    
    <div class="max-w-4xl mx-auto px-4 relative z-10 text-center" data-aos="zoom-in" data-aos-duration="1000">
      <div class="w-28 h-28 bg-white/10 backdrop-blur-md rounded-full flex items-center justify-center mx-auto mb-8 shadow-[0_0_40px_rgba(250,204,21,0.2)] p-2 border border-white/20 transition-transform duration-500 hover:scale-110">
        <div class="w-full h-full bg-white rounded-full flex items-center justify-center p-2 shadow-inner">
          <img src="/images/logo-smp.png" alt="Logo SMPIT" class="w-full h-full object-contain mix-blend-multiply drop-shadow-sm" />
        </div>
      </div>
      <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-display font-black mb-6 text-transparent bg-clip-text bg-gradient-to-r from-yellow-300 via-emas to-yellow-500 drop-shadow-sm tracking-tight">SMPIT Nailul Khoir</h1>
      <p class="text-lg md:text-2xl text-green-50 font-light max-w-3xl mx-auto drop-shadow-md leading-relaxed border-b border-emas/30 pb-8 inline-block">Mencetak Generasi Qur'ani Berprestasi Melalui Kurikulum Terpadu & Pembinaan Karakter Islami.</p>
    </div>
  </div>

  <!-- Content Section -->
  <div class="max-w-5xl mx-auto px-4 py-8 -mt-12 md:-mt-24 relative z-20 mb-20">
    <div class="bg-white rounded-3xl shadow-[0_20px_60px_rgba(0,0,0,0.05)] border border-gray-100 p-6 md:p-14 mx-auto" data-aos="fade-up">
      <div class="text-center md:text-left mb-12">
        <h2 class="text-xs font-bold text-emas uppercase tracking-widest mb-2">Tentang Kami</h2>
        <h3 class="text-3xl md:text-4xl font-display text-pesantren font-bold">Profil & Kurikulum SMPIT</h3>
      </div>
      
      <p class="text-lg md:text-xl text-gray-600 leading-relaxed font-light mb-12 border-l-4 border-emas pl-6 bg-gray-50 p-6 rounded-r-2xl">
        Sekolah Menengah Pertama Islam Terpadu (SMPIT) Nailul Khoir hadir untuk memadukan kurikulum pendidikan nasional dengan sistem kepesantrenan modern dan salafiyah, membentuk pribadi yang tangguh secara akademik maupun spiritual.
      </p>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-16">
        <div class="bg-gradient-to-br from-[#f8fdfa] to-white p-8 md:p-10 rounded-3xl border border-green-100 shadow-[0_10px_40px_rgba(6,78,59,0.03)] relative overflow-hidden group hover:shadow-[0_10px_40px_rgba(6,78,59,0.08)] transition-all duration-500 hover:-translate-y-1">
          <div class="absolute -right-10 -top-10 w-40 h-40 bg-green-100 rounded-full blur-3xl opacity-50 group-hover:bg-green-200 transition-colors duration-500"></div>
          <div class="w-12 h-12 bg-pesantren text-white rounded-xl flex items-center justify-center mb-6 shadow-lg shadow-green-900/20">
             <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" /></svg>
          </div>
          <h4 class="font-display font-bold text-pesantren text-2xl mb-6 relative z-10">Program Unggulan</h4>
          <ul class="space-y-4 text-gray-600 relative z-10 font-medium">
            <li class="flex items-center p-3 bg-white rounded-xl shadow-sm border border-gray-50"><span class="flex-shrink-0 w-8 h-8 bg-emas/20 text-emas rounded-full flex items-center justify-center mr-4 text-xl">1</span> <span>Tahfidz Al-Qur'an 3-5 Juz</span></li>
            <li class="flex items-center p-3 bg-white rounded-xl shadow-sm border border-gray-50"><span class="flex-shrink-0 w-8 h-8 bg-emas/20 text-emas rounded-full flex items-center justify-center mr-4 text-xl">2</span> <span>Pembiasaan Ibadah Sunnah Rutin</span></li>
            <li class="flex items-center p-3 bg-white rounded-xl shadow-sm border border-gray-50"><span class="flex-shrink-0 w-8 h-8 bg-emas/20 text-emas rounded-full flex items-center justify-center mr-4 text-xl">3</span> <span>Bahasa Arab & Inggris Aktif</span></li>
            <li class="flex items-center p-3 bg-white rounded-xl shadow-sm border border-gray-50"><span class="flex-shrink-0 w-8 h-8 bg-emas/20 text-emas rounded-full flex items-center justify-center mr-4 text-xl">4</span> <span>Bimbingan Akhlakul Karimah</span></li>
          </ul>
        </div>
        
        <div class="bg-gradient-to-br from-gray-50 to-white p-8 md:p-10 rounded-3xl border border-gray-100 shadow-[0_10px_40px_rgba(0,0,0,0.03)] relative overflow-hidden group hover:shadow-[0_10px_40px_rgba(0,0,0,0.08)] transition-all duration-500 hover:-translate-y-1">
          <div class="absolute -left-10 -bottom-10 w-40 h-40 bg-gray-200 rounded-full blur-3xl opacity-50 group-hover:bg-gray-300 transition-colors duration-500"></div>
          <div class="w-12 h-12 bg-gray-800 text-white rounded-xl flex items-center justify-center mb-6 shadow-lg shadow-gray-900/20">
             <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" /></svg>
          </div>
          <h4 class="font-display font-bold text-gray-800 text-2xl mb-6 relative z-10">Fasilitas Penunjang</h4>
          <ul class="space-y-4 text-gray-600 relative z-10 font-medium">
            <li class="flex items-center p-3 bg-white rounded-xl shadow-sm border border-gray-50"><span class="flex-shrink-0 w-8 h-8 bg-green-100 text-green-600 rounded-full flex items-center justify-center mr-4">✓</span> <span>Ruang Kelas Cerdas & Nyaman</span></li>
            <li class="flex items-center p-3 bg-white rounded-xl shadow-sm border border-gray-50"><span class="flex-shrink-0 w-8 h-8 bg-green-100 text-green-600 rounded-full flex items-center justify-center mr-4">✓</span> <span>Asrama Santri Reguler & Tahfidz</span></li>
            <li class="flex items-center p-3 bg-white rounded-xl shadow-sm border border-gray-50"><span class="flex-shrink-0 w-8 h-8 bg-green-100 text-green-600 rounded-full flex items-center justify-center mr-4">✓</span> <span>Laboratorium Komputer Terpadu</span></li>
            <li class="flex items-center p-3 bg-white rounded-xl shadow-sm border border-gray-50"><span class="flex-shrink-0 w-8 h-8 bg-green-100 text-green-600 rounded-full flex items-center justify-center mr-4">✓</span> <span>Fasilitas Olahraga & Seni Islam</span></li>
          </ul>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center mb-16">
        <div>
           <h3 class="font-display text-3xl font-bold text-pesantren mb-4">Misi Pendidikan Holistik</h3>
           <p class="text-gray-600 leading-relaxed font-light mb-6">
             Visi kami adalah mewujudkan generasi muda Islam yang cerdas, berakhlak mulia, hafal Al-Qur'an, dan memiliki wawasan global berlandaskan akidah Ahlussunnah Wal Jama'ah.
           </p>
           <ul class="space-y-3 text-gray-700 font-medium">
             <li class="flex items-start"><span class="text-emas mr-2 mt-1">●</span> Memadukan kurikulum pendidikan umum dan pesantren.</li>
             <li class="flex items-start"><span class="text-emas mr-2 mt-1">●</span> Membekali siswa dengan hafalan Al-Qur'an secara teruji.</li>
             <li class="flex items-start"><span class="text-emas mr-2 mt-1">●</span> Menumbuhkan budaya literasi dan prestasi tinggi.</li>
             <li class="flex items-start"><span class="text-emas mr-2 mt-1">●</span> Full Day Assesment untuk perilaku dan adab.</li>
           </ul>
        </div>
        <div class="bg-gray-100 rounded-3xl h-full min-h-[300px] border border-gray-200 overflow-hidden relative group">
           <!-- Placeholder for an image or dynamic asset -->
           <img src="/images/hero-bg.jpg" alt="Kegiatan Santri SMP" class="w-full h-full object-cover filter grayscale-[20%] group-hover:scale-105 transition-transform duration-700" />
           <div class="absolute inset-0 bg-gradient-to-t from-pesantren/80 to-transparent flex items-end p-6">
             <p class="text-white font-medium text-lg">Kegiatan Belajar Siswa SMPIT berseragam pondok</p>
           </div>
        </div>
      </div>

      <div class="bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-pesantren via-[#043322] to-[#01140d] text-white p-8 md:p-12 rounded-3xl shadow-2xl relative overflow-hidden text-center" data-aos="zoom-in">
          <div class="absolute top-0 right-0 w-96 h-96 bg-emas/10 rounded-full blur-3xl translate-x-1/2 -translate-y-1/2 pointer-events-none"></div>
          <div class="absolute bottom-0 left-0 w-64 h-64 bg-green-500/10 rounded-full blur-3xl -translate-x-1/2 translate-y-1/2 pointer-events-none"></div>
          
          <h3 class="font-display font-light text-green-100 uppercase tracking-widest text-sm mb-2 relative z-10">Kegiatan Tambahan</h3>
          <h4 class="font-display font-bold text-emas text-3xl mb-10 relative z-10">Ekstrakurikuler Pilihan</h4>
          <div class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6 text-center relative z-10">
            <div class="bg-white/5 backdrop-blur-md p-6 rounded-2xl border border-white/10 hover:bg-white/10 hover:border-emas/50 transition-all font-semibold text-white shadow-xl flex flex-col items-center justify-center gap-3 group">
               <span class="text-3xl text-emas group-hover:scale-125 transition-transform">🏕️</span> Pramuka SIT
            </div>
            <div class="bg-white/5 backdrop-blur-md p-6 rounded-2xl border border-white/10 hover:bg-white/10 hover:border-emas/50 transition-all font-semibold text-white shadow-xl flex flex-col items-center justify-center gap-3 group">
               <span class="text-3xl text-emas group-hover:scale-125 transition-transform">🥋</span> Pagar Nusa
            </div>
            <div class="bg-white/5 backdrop-blur-md p-6 rounded-2xl border border-white/10 hover:bg-white/10 hover:border-emas/50 transition-all font-semibold text-white shadow-xl flex flex-col items-center justify-center gap-3 group">
               <span class="text-3xl text-emas group-hover:scale-125 transition-transform">📝</span> Jurnalistik
            </div>
            <div class="bg-white/5 backdrop-blur-md p-6 rounded-2xl border border-white/10 hover:bg-white/10 hover:border-emas/50 transition-all font-semibold text-white shadow-xl flex flex-col items-center justify-center gap-3 group">
               <span class="text-3xl text-emas group-hover:scale-125 transition-transform">🥁</span> Hadroh
            </div>
          </div>
       </div>

      <!-- Pendaftaran Call to Action -->
      <div class="mt-20 text-center flex flex-col items-center" data-aos="fade-up">
        <h3 class="font-display text-3xl md:text-4xl font-black text-gray-900 mb-6 tracking-tight">Siap Bergabung Bersama Kami?</h3>
        <p class="text-gray-500 mb-8 max-w-lg mx-auto">Daftarkan putra/putri Anda sekarang untuk menjadi bagian dari generasi emas Islami masa depan.</p>
        <a href="/pendaftaran?jalur=SMPIT" class="bg-gradient-to-r from-emas to-yellow-500 text-pesantren font-black px-12 py-5 rounded-full shadow-[0_10px_30px_rgba(250,204,21,0.3)] transition-all duration-300 hover:scale-[1.03] hover:-translate-y-1 hover:shadow-[0_15px_40px_rgba(250,204,21,0.5)] inline-flex items-center gap-3 text-lg group">
          <span>Isi Formulir Pendaftaran PPDB</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 group-hover:translate-x-2 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
        </a>
      </div>
    </div>
  </div>
</MainLayout>
