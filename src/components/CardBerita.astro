---
interface Props {
  judul: string;
  foto_url: string;
  description: string;
  tanggal: string;
  id?: string | number;
}

const { judul, foto_url, description, tanggal, id } = Astro.props;

// Helper to truncate text dan strip HTML
const truncate = (str: string, length: number) => {
  if (!str) return '';
  const stripped = str.replace(/<[^>]*>?/gm, '').replace(/&nbsp;/g, ' ').trim();
  if (stripped.length > length) return stripped.substring(0, length) + '...';
  return stripped;
};

// Format tanggal jika ada
const formatTanggal = (dateStr: string) => {
  if(!dateStr) return '';
  try {
    const options: Intl.DateTimeFormatOptions = { year: 'numeric', month: 'long', day: 'numeric' };
    return new Date(dateStr).toLocaleDateString('id-ID', options);
  } catch(e) {
    return dateStr;
  }
}
---
<article class="bg-white rounded-xl shadow-md overflow-hidden hover:shadow-xl transition-all duration-300 border border-gray-100 flex flex-col hover:-translate-y-1">
  <div class="h-48 bg-gray-200 relative overflow-hidden group">
    {foto_url ? (
      <img src={foto_url} alt={judul} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
    ) : (
      <div class="w-full h-full flex items-center justify-center bg-green-50 text-pesantren">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16 opacity-30" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
        </svg>
      </div>
    )}
    <div class="absolute top-0 right-0 bg-emas text-pesantren font-bold px-3 py-1 m-3 rounded shadow-sm text-xs">
      {formatTanggal(tanggal)}
    </div>
  </div>
  <div class="p-6 flex-grow flex flex-col">
    <h3 class="font-bold text-xl text-gray-900 mb-3 line-clamp-2 leading-tight group-hover:text-pesantren transition-colors">{judul}</h3>
    <p class="text-gray-600 text-sm mb-5 line-clamp-3 flex-grow leading-relaxed">{truncate(description, 120)}</p>
    <a href={id ? `/berita/${id}` : '#'} class="inline-flex items-center text-pesantren font-bold hover:text-green-800 transition-colors text-sm mt-auto group">
      Baca selengkapnya
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-1 group-hover:translate-x-1 transition-transform" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
      </svg>
    </a>
  </div>
</article>
