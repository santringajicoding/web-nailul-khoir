---
const pathname = Astro.url.pathname;

// Helper to determine if a route is active
const isActive = (path: string) => {
  if (path === '/') {
    return pathname === '/' || pathname === '';
  }
  return pathname.startsWith(path);
};
---

<div class="lg:hidden fixed bottom-0 left-0 right-0 z-[90] bg-[#05291e]/95 backdrop-blur-xl border-t border-white/10 px-4 py-2 flex justify-around items-end h-20 shadow-[0_-10px_35px_rgba(0,0,0,0.5)]">
  <!-- Beranda -->
  <a href="/" class={`flex flex-col items-center justify-center gap-1 w-12 h-14 transition-all duration-300 ${isActive('/') ? 'text-emas scale-105 font-bold' : 'text-white/60 hover:text-white active:scale-95'}`}>
    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
    </svg>
    <span data-translate="beranda" class="text-[9.5px] tracking-wide">Beranda</span>
  </a>
  
  <!-- Berita -->
  <a href="/berita" class={`flex flex-col items-center justify-center gap-1 w-12 h-14 transition-all duration-300 ${isActive('/berita') ? 'text-emas scale-105 font-bold' : 'text-white/60 hover:text-white active:scale-95'}`}>
    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
    </svg>
    <span data-translate="berita" class="text-[9.5px] tracking-wide">Berita</span>
  </a>

  <!-- PPDB (Pendaftaran) - Centered & Popping Out -->
  <div class="relative -top-5 flex flex-col items-center w-16">
    <a href="/pendaftaran" class="w-14 h-14 bg-gradient-to-br from-yellow-400 via-emas to-yellow-600 rounded-full flex items-center justify-center shadow-[0_8px_25px_rgba(234,179,8,0.4)] border-4 border-[#05291e] active:scale-90 transition-transform duration-300">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7 text-[#064e3b]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 14l9-5-9-5-9 5 9 5z" />
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z" />
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 14v7" />
      </svg>
    </a>
    <span data-translate="ppdb" class="text-[9.5px] mt-1 text-emas font-black uppercase tracking-wider">PPDB</span>
  </div>

  <!-- Donasi -->
  <a href="/donasi" class={`flex flex-col items-center justify-center gap-1 w-12 h-14 transition-all duration-300 ${isActive('/donasi') ? 'text-emas scale-105 font-bold' : 'text-white/60 hover:text-white active:scale-95'}`}>
    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
    </svg>
    <span data-translate="donasi" class="text-[9.5px] tracking-wide">Donasi</span>
  </a>

  <!-- Kontak -->
  <a href="/kontak" class={`flex flex-col items-center justify-center gap-1 w-12 h-14 transition-all duration-300 ${isActive('/kontak') ? 'text-emas scale-105 font-bold' : 'text-white/60 hover:text-white active:scale-95'}`}>
    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
    </svg>
    <span data-translate="kontak" class="text-[9.5px] tracking-wide">Kontak</span>
  </a>
</div>
