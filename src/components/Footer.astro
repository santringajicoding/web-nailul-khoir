<script>
  import { supabase } from '../lib/supabase.js';

  async function syncFooter() {
    try {
      const { data } = await supabase.from('pengaturan_web').select('*');
      if (data) {
        data.forEach(item => {
          if (item.key === 'contact_wa') {
            const el = document.getElementById('footerWA');
            if (el) {
              el.textContent = `+${item.value}`;
              el.setAttribute('href', `https://wa.me/${item.value.replace(/[^0-9]/g, '')}`);
            }
          }
          if (item.key === 'contact_email') {
            const el = document.getElementById('footerEmail');
            if (el) {
              el.textContent = item.value;
              el.setAttribute('href', `mailto:${item.value}`);
            }
          }
          if (item.key === 'contact_address') {
            const el = document.getElementById('footerAddress');
            if (el) el.textContent = item.value;
          }
        });
      }
    } catch (e) {}
  }

  syncFooter();
</script>
