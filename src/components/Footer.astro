---
const currentYear = new Date().getFullYear();
---
<footer class="bg-pesantren text-white py-10 mt-16 border-t-4 border-emas">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-8">
      <div>
        <div class="bg-white p-2 rounded-xl inline-block mb-4 shadow-sm">
          <img src="/images/logo.png" alt="Logo PP Nailul Khoir" class="h-14 w-auto object-contain" />
        </div>
        <p class="text-sm text-gray-200 leading-relaxed font-medium italic">
          "Terwujudnya Kader Muslim Yang Kaya Akan Ilmu Kuat Dalam Aqidah dan Berakhlaqul Karimah"
        </p>
      </div>
      <div>
        <h3 class="text-lg font-bold mb-4 text-emas">Kontak Kami</h3>
        <ul class="space-y-4 text-sm text-gray-200">
          <li class="flex items-start">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-3 mt-0.5 text-emas shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
            <span class="break-all">pesantrennailulkhoir@gmail.com</span>
          </li>
          <li class="flex items-start">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-3 mt-0.5 text-emas shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
            <div>
              <p>+62 882-1833-6152 (Mang Aan)</p>
              <p>+62 857-9440-5083 (Panitia PPDB)</p>
            </div>
          </li>
          <li class="flex items-start">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-3 mt-0.5 text-emas shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
            <p>Blok Desa, RT 01/RW 01, Desa Panyindangan, Kec. Banjaran, Kab. Majalengka, Jawa Barat 45468</p>
          </li>
        </ul>
      </div>
      <div>
        <h3 class="text-lg font-bold mb-4 text-emas">Tautan Cepat</h3>
        <ul class="space-y-2 text-sm text-gray-200">
          <li><a href="/tentang" class="hover:text-emas transition-colors flex items-center">- Tentang Kami</a></li>
          <li><a href="/pendaftaran" class="hover:text-emas transition-colors flex items-center">- Pendaftaran Santri Baru</a></li>
          <li><a href="/admin/login" class="hover:text-emas transition-colors flex items-center">- Portal Pengurus</a></li>
        </ul>
      </div>
    </div>
    <div class="border-t border-green-800 pt-6 text-center text-sm text-gray-400 flex flex-col md:flex-row justify-between items-center">
      <p>&copy; {currentYear} Yayasan Pondok Pesantren Nailul Khoir. Hak Cipta Dilindungi.</p>
      <p class="mt-2 md:mt-0">Sistem Informasi Berbasis Cloud & Serverless</p>
    </div>
  </div>
</footer>
