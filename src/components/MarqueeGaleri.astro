---
// src/components/MarqueeGaleri.astro

import { supabase } from '../lib/supabase.js';

// Mengambil galeri asli dari database
const { data: dbGaleri, error } = await supabase
  .from('galeri')
  .select('*')
  .order('created_at', { ascending: false });

interface GaleriItem {
  id?: string;
  url?: string;
  foto_url?: string;
  alt?: string;
  judul?: string;
  deskripsi?: string;
}

let galeriFotos: GaleriItem[] = [];

if (dbGaleri && dbGaleri.length > 0) {
  galeriFotos = dbGaleri;
} else {
  galeriFotos = [
    { id: 'g1', foto_url: "/images/hero-bg.jpg", judul: "Kajian Mingguan Santri" },
    { id: 'g2', foto_url: "/images/hero-bg.jpg", judul: "Fasilitas Perpustakaan" },
    { id: 'g3', foto_url: "/images/hero-bg.jpg", judul: "Kelas Belajar Mandiri" },
    { id: 'g4', foto_url: "/images/hero-bg.jpg", judul: "Kegiatan Olahraga Sore" }
  ];
}
---

<section class="py-24 bg-white border-t border-b border-gray-100 overflow-hidden relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Header Section -->
    <div class="flex justify-between items-center mb-12">
      <div>
        <h2 class="text-base text-emas font-bold tracking-wide uppercase">Galeri Kegiatan</h2>
        <p class="mt-2 text-3xl font-display leading-8 font-extrabold tracking-tight text-gray-900 sm:text-4xl">
          Sekilas Aktivitas Santri
        </p>
      </div>
      
      <!-- Navigation Buttons -->
      <div class="flex items-center gap-3 shrink-0">
        <button id="btnGaleriPrev" class="p-3 bg-white hover:bg-gray-100 text-gray-800 rounded-full border border-gray-200 shadow-sm transition-all active:scale-95 hover:scale-105" aria-label="Previous Photo">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
          </svg>
        </button>
        <button id="btnGaleriNext" class="p-3 bg-white hover:bg-gray-100 text-gray-800 rounded-full border border-gray-200 shadow-sm transition-all active:scale-95 hover:scale-105" aria-label="Next Photo">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Coverflow Slider Wrapper -->
    <div class="relative w-full h-[320px] sm:h-[420px] md:h-[480px] flex items-center justify-center">
      <div id="galeriSliderContainer" class="relative w-full h-full max-w-[1200px] flex items-center justify-center">
        {galeriFotos.map((foto, idx) => (
          <div 
            class="galeri-slide absolute h-[240px] sm:h-[320px] md:h-[380px] w-auto rounded-3xl overflow-hidden shadow-xl hover:shadow-2xl transition-all duration-500 ease-out transform cursor-pointer group bg-gray-100"
            data-index={idx}
          >
            <img 
              src={foto.url || foto.foto_url} 
              alt={foto.alt || foto.judul || `Galeri Kegiatan ${idx + 1}`} 
              class="h-full w-auto object-contain select-none group-hover:scale-105 transition-transform duration-700" 
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex flex-col justify-end p-6">
              <h4 class="text-white font-black text-sm sm:text-base leading-snug drop-shadow-md">{foto.judul || "Aktivitas Santri"}</h4>
              {foto.deskripsi && (
                <p class="text-gray-200 text-xs mt-1.5 line-clamp-2 drop-shadow-sm font-medium">{foto.deskripsi}</p>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>

<script>
  import { supabase } from '../lib/supabase.js';

  function initGaleriSlider() {
    const slides = document.querySelectorAll('.galeri-slide');
    if (slides.length === 0) return;

    let activeIndex = 0;
    let intervalId: any = null;

    function updateSlider() {
      slides.forEach((slide: any) => {
        const index = parseInt(slide.getAttribute('data-index') || '0');
        let diff = index - activeIndex;
        const total = slides.length;

        // Normalize diff untuk shortest circular distance
        while (diff < -total / 2) diff += total;
        while (diff > total / 2) diff -= total;

        // Reset classes
        slide.className = "galeri-slide absolute h-[240px] sm:h-[320px] md:h-[380px] w-auto rounded-3xl overflow-hidden shadow-xl hover:shadow-2xl transition-all duration-500 ease-out transform cursor-pointer group bg-gray-100";

        if (diff === 0) {
          // Slide Aktif di Tengah
          slide.classList.add('z-30', 'scale-100', 'opacity-100', 'translate-x-0', 'pointer-events-auto');
        } else if (diff === 1 || (diff === -1 * (total - 1) && total > 2)) {
          // Slide Kanan (Next)
          slide.classList.add('z-20', 'scale-[0.82]', 'opacity-40', 'translate-x-[140px]', 'sm:translate-x-[220px]', 'md:translate-x-[280px]', 'pointer-events-none', 'blur-[1.5px]');
        } else if (diff === -1 || (diff === total - 1 && total > 2)) {
          // Slide Kiri (Prev)
          slide.classList.add('z-20', 'scale-[0.82]', 'opacity-40', '-translate-x-[140px]', '-sm:translate-x-[220px]', '-md:translate-x-[280px]', 'pointer-events-none', 'blur-[1.5px]');
        } else {
          // Slide Tersembunyi Jauh
          slide.classList.add('z-10', 'scale-[0.6]', 'opacity-0', 'pointer-events-none');
          if (diff < 0) {
            slide.classList.add('-translate-x-[360px]');
          } else {
            slide.classList.add('translate-x-[360px]');
          }
        }
      });
    }

    function nextSlide() {
      activeIndex = (activeIndex + 1) % slides.length;
      updateSlider();
    }

    function prevSlide() {
      activeIndex = (activeIndex - 1 + slides.length) % slides.length;
      updateSlider();
    }

    // Auto slide
    function startInterval() {
      stopInterval();
      intervalId = setInterval(nextSlide, 5000);
    }

    function stopInterval() {
      if (intervalId) {
        clearInterval(intervalId);
        intervalId = null;
      }
    }

    function resetInterval() {
      stopInterval();
      startInterval();
    }

    // Event Listeners Buttons (Cloned to clear old listeners)
    const btnPrev = document.getElementById('btnGaleriPrev');
    if (btnPrev) {
      const newBtn = btnPrev.cloneNode(true);
      btnPrev.parentNode?.replaceChild(newBtn, btnPrev);
      newBtn.addEventListener('click', () => {
        prevSlide();
        resetInterval();
      });
    }

    const btnNext = document.getElementById('btnGaleriNext');
    if (btnNext) {
      const newBtn = btnNext.cloneNode(true);
      btnNext.parentNode?.replaceChild(newBtn, btnNext);
      newBtn.addEventListener('click', () => {
        nextSlide();
        resetInterval();
      });
    }

    // Click on adjacent slides to navigate
    slides.forEach((slide: any) => {
      slide.addEventListener('click', () => {
        const index = parseInt(slide.getAttribute('data-index') || '0');
        let diff = index - activeIndex;
        const total = slides.length;
        while (diff < -total / 2) diff += total;
        while (diff > total / 2) diff -= total;

        if (diff === 1) {
          nextSlide();
          resetInterval();
        } else if (diff === -1) {
          prevSlide();
          resetInterval();
        }
      });
    });

    // Pause on hover
    const sliderContainer = document.getElementById('galeriSliderContainer');
    if (sliderContainer) {
      sliderContainer.addEventListener('mouseenter', stopInterval);
      sliderContainer.addEventListener('mouseleave', startInterval);
    }

    // Initial Update and Start
    updateSlider();
    startInterval();
  }

  async function loadDynamicGaleri() {
    try {
      const { data, error } = await supabase
        .from('galeri')
        .select('*')
        .order('created_at', { ascending: false });

      if (!error && data && data.length > 0) {
        const oldContainer = document.getElementById('galeriSliderContainer');
        if (oldContainer) {
          const newContainer = oldContainer.cloneNode(false) as HTMLElement;
          newContainer.innerHTML = data.map((foto: any, idx: number) => {
            const descriptionHtml = foto.deskripsi 
              ? `<p class="text-gray-200 text-xs mt-1.5 line-clamp-2 drop-shadow-sm font-medium">${foto.deskripsi}</p>`
              : '';
            return `
              <div 
                class="galeri-slide absolute h-[240px] sm:h-[320px] md:h-[380px] w-auto rounded-3xl overflow-hidden shadow-xl hover:shadow-2xl transition-all duration-500 ease-out transform cursor-pointer group bg-gray-100"
                data-index="${idx}"
              >
                <img 
                  src="${foto.url || foto.foto_url}" 
                  alt="${foto.alt || foto.judul || `Galeri Kegiatan ${idx + 1}`}" 
                  class="h-full w-auto object-contain select-none group-hover:scale-105 transition-transform duration-700" 
                  loading="lazy"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex flex-col justify-end p-6">
                  <h4 class="text-white font-black text-sm sm:text-base leading-snug drop-shadow-md">${foto.judul || "Aktivitas Santri"}</h4>
                  ${descriptionHtml}
                </div>
              </div>
            `;
          }).join('');
          oldContainer.parentNode?.replaceChild(newContainer, oldContainer);
          initGaleriSlider();
        }
      } else {
        initGaleriSlider();
      }
    } catch (e) {
      console.error("Gagal memuat galeri dinamis:", e);
      initGaleriSlider();
    }
  }

  // Memicu inisialisasi slider setelah DOM siap
  document.addEventListener('DOMContentLoaded', () => {
    loadDynamicGaleri();
  });
</script>
