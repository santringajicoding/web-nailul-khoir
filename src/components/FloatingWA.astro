---
// Dynamic WhatsApp Numbers can be overridden via client script
---

<div class="fixed bottom-24 right-6 lg:bottom-6 lg:right-6 z-[100]">
  <!-- Speed Dial Panel -->
  <div id="waSpeedDial" class="absolute bottom-16 right-0 w-72 bg-[#05291e]/98 backdrop-blur-xl border border-white/10 rounded-3xl p-5 shadow-2xl transition-all duration-300 ease-out transform scale-95 opacity-0 pointer-events-none translate-y-4 origin-bottom-right z-50">
    <h4 class="font-display font-black text-white text-lg mb-1 flex items-center gap-2">
      <span class="w-2 h-2 rounded-full bg-[#25D366] animate-pulse"></span>
      Hubungi Kami via WA
    </h4>
    <p class="text-xs text-green-100/70 mb-4 font-medium">Silakan pilih admin layanan yang sesuai dengan kebutuhan Anda:</p>
    
    <div class="space-y-3">
      <!-- Admin Yayasan -->
      <a href="https://wa.me/6288218336152?text=Assalamualaykum%20Admin%20Nailul%20Khoir,%20saya%20ingin%20bertanya%20seputar%20informasi%20pesantren." 
         target="_blank" 
         id="waAdminPusat"
         class="flex items-center gap-3 p-3.5 bg-white/5 border border-white/10 rounded-2xl hover:bg-white/10 active:scale-[0.98] transition-all group">
        <div class="bg-[#25D366]/20 p-2.5 rounded-xl text-[#25D366] group-hover:scale-110 transition-transform">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
          </svg>
        </div>
        <div class="text-left">
          <span class="block text-sm font-bold text-white leading-tight">Admin Yayasan (Pusat)</span>
          <span class="block text-[11px] text-green-200/60 mt-0.5 font-medium">Informasi & Layanan Umum</span>
        </div>
      </a>

      <!-- Admin PPDB -->
      <a href="https://wa.me/6285794405083?text=Assalamualaykum%20Panitia%20PPDB%20Nailul%20Khoir,%20saya%20ingin%20bertanya%20seputar%20pendaftaran%20santri%20baru." 
         target="_blank" 
         id="waAdminPPDB"
         class="flex items-center gap-3 p-3.5 bg-white/5 border border-white/10 rounded-2xl hover:bg-white/10 active:scale-[0.98] transition-all group">
        <div class="bg-[#25D366]/20 p-2.5 rounded-xl text-[#25D366] group-hover:scale-110 transition-transform">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 14l9-5-9-5-9 5 9 5z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z" />
          </svg>
        </div>
        <div class="text-left">
          <span class="block text-sm font-bold text-white leading-tight">Panitia PPDB</span>
          <span class="block text-[11px] text-green-200/60 mt-0.5 font-medium">Pendaftaran Santri Baru</span>
        </div>
      </a>
    </div>
  </div>

  <!-- Trigger Button -->
  <button id="waTriggerBtn" 
          class="relative bg-[#25D366] text-white p-3.5 md:p-4 rounded-full shadow-2xl hover:scale-110 active:scale-90 md:hover:-translate-y-2 transition-all duration-300 group flex items-center justify-center border-4 border-white z-50"
          aria-label="Tanya Admin Kami">
    <!-- Desktop Tooltip -->
    <span class="absolute hidden lg:block right-20 bg-white text-gray-800 text-sm font-bold px-4 py-2 rounded-xl shadow-xl opacity-0 translate-x-4 group-hover:translate-x-0 group-hover:opacity-100 transition-all duration-300 pointer-events-none whitespace-nowrap">
      Tanya Admin Kami 👋
      <span class="absolute top-1/2 -right-1 -mt-1 w-3 h-3 bg-white rotate-45"></span>
    </span>
    
    <!-- WhatsApp Icon -->
    <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 md:w-8 md:h-8 fill-current drop-shadow-sm" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.878-.788-1.47-1.761-1.643-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>

    <!-- Ripple Effect -->
    <span class="absolute inline-flex w-full h-full rounded-full bg-[#25D366] opacity-20 animate-ping z-[-1] pointer-events-none"></span>
  </button>
</div>

<script>
  import { supabase } from '../lib/supabase.js';

  document.addEventListener('DOMContentLoaded', () => {
    const trigger = document.getElementById('waTriggerBtn');
    const dial = document.getElementById('waSpeedDial');

    if (trigger && dial) {
      trigger.addEventListener('click', (e) => {
        e.stopPropagation();
        const isOpen = dial.classList.contains('opacity-100');
        if (isOpen) {
          dial.classList.remove('opacity-100', 'scale-100', 'pointer-events-auto', 'translate-y-0');
          dial.classList.add('opacity-0', 'scale-95', 'pointer-events-none', 'translate-y-4');
        } else {
          dial.classList.remove('opacity-0', 'scale-95', 'pointer-events-none', 'translate-y-4');
          dial.classList.add('opacity-100', 'scale-100', 'pointer-events-auto', 'translate-y-0');
        }
      });

      // Close speed dial when clicking outside
      document.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        if (!dial.contains(target) && !trigger.contains(target)) {
          dial.classList.remove('opacity-100', 'scale-100', 'pointer-events-auto', 'translate-y-0');
          dial.classList.add('opacity-0', 'scale-95', 'pointer-events-none', 'translate-y-4');
        }
      });
    }

    // Dynamic numbers sync from database settings table
    async function syncNumbers() {
      try {
        const { data: waSetting } = await supabase.from('pengaturan_web').select('value').eq('key', 'contact_wa').single();
        if (waSetting && waSetting.value) {
          const formatted = waSetting.value.replace(/[^0-9]/g, '');
          const waAdmin = document.getElementById('waAdminPusat') as HTMLAnchorElement;
          if (waAdmin) {
            waAdmin.href = `https://wa.me/${formatted}?text=Assalamualaykum%20Admin%20Nailul%20Khoir,%20saya%20ingin%20bertanya%20seputar%20informasi%20pesantren.`;
          }
        }
      } catch (e) {
        // Fallback to static html urls
      }
    }
    syncNumbers();
  });
</script>
