---
---
<nav id="mainNavbar" class="fixed top-4 left-1/2 -translate-x-1/2 w-[92%] max-w-[1400px] bg-[#064e3b]/90 backdrop-blur-xl text-white shadow-[0_20px_50px_rgba(0,0,0,0.3)] z-[100] border border-white/10 rounded-[24px] transition-all duration-500">
  <div class="w-full max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-4 xl:px-6 2xl:px-10">
    <div class="flex justify-between h-16 sm:h-20 lg:h-24">
      <!-- Brand Section -->
      <div class="flex items-center flex-shrink-0">
        <a href="/" class="flex-shrink-0 relative group flex items-center gap-2.5 sm:gap-3.5 select-none py-1 overflow-hidden rounded-xl">
          <!-- Logo Emblem (Pentagon) - Tanpa Kotak Putih, Tampil Besar & Anggun -->
          <div class="relative flex-shrink-0 flex items-center justify-center h-12 w-12 sm:h-14 sm:w-14 lg:h-16 lg:w-16 opacity-0 animate-fade-slide" style="animation-delay: 0.05s;">
            <img src="/images/logo.png" alt="Logo PP Nailul Khoir" class="h-full w-auto object-contain drop-shadow-[0_2px_10px_rgba(255,255,255,0.15)] group-hover:scale-105 transition-all duration-500" />
          </div>
          
          <!-- Logo Text Details (Coded to match official header design logo - Tall aligned layout) -->
          <div class="flex flex-col justify-between h-12 sm:h-14 lg:h-16 leading-none relative z-10 transition-all duration-500 select-none">
            <!-- 1. Arabic Calligraphy Line -->
            <span class="font-arabic-calligraphy text-green-300 font-medium text-[11px] sm:text-[13px] lg:text-[12px] xl:text-[14px] leading-none select-none opacity-0 animate-fade-slide tracking-normal pb-1 sm:pb-1.5" style="animation-delay: 0.15s;">
              مَعْهَدُ التَّرْبِيَّةِ الإِسْلَامِيَّةِ نَيْلُ الْخَيْرِ
            </span>
            
            <!-- 2. Yayasan Pondok Pesantren -->
            <span class="font-display font-bold text-[7px] sm:text-[9px] lg:text-[8px] xl:text-[10px] text-white/90 uppercase leading-none opacity-0 animate-fade-slide" style="animation-delay: 0.25s;">
              Yayasan Pondok Pesantren
            </span>
            
            <!-- 3. NAILUL KHOIR Title -->
            <span class="font-display font-black text-sm sm:text-lg lg:text-base xl:text-xl uppercase leading-none drop-shadow-[0_2px_4px_rgba(0,0,0,0.3)] opacity-0 animate-fade-slide flex items-center gap-1.5" style="animation-delay: 0.35s;">
              <span class="text-[#dfb15b]">Nailul</span>
              <span class="text-green-400">Khoir</span>
            </span>
            
            <!-- 4. Underline Divider (Gradient line) -->
            <div class="h-[1.5px] w-full bg-gradient-to-r from-[#dfb15b] via-green-400 to-[#dfb15b] opacity-0 animate-fade-slide" style="animation-delay: 0.45s;"></div>
            
            <!-- 5. Address / Location -->
            <span class="font-display font-bold text-[5.5px] sm:text-[7.5px] lg:text-[7px] xl:text-[8.5px] text-white/60 uppercase leading-none opacity-0 animate-fade-slide" style="animation-delay: 0.55s;">
              Panyingangan - Banjaran - Majalengka
            </span>
          </div>

          <!-- Periodic Shimmer Shine Overlay covering the whole brand block on a loop -->
          <div class="absolute inset-0 w-full h-full bg-gradient-to-r from-transparent via-white/15 to-transparent -translate-x-full animate-shine-loop pointer-events-none z-20"></div>
          
          <!-- Hover Instant Shine sweep -->
          <div class="absolute inset-0 w-full h-full bg-gradient-to-r from-transparent via-white/25 to-transparent -translate-x-full hover-shine pointer-events-none z-20"></div>
        </a>
      </div>
      
      <!-- Actions & Menu Section -->
      <div class="flex items-center gap-1.5 sm:gap-2.5">
        <!-- 1. Theme Toggle (Always visible) -->
        <button id="themeToggleBtn" class="p-2 sm:p-2.5 rounded-full hover:bg-white/10 active:scale-95 transition-all text-emas relative overflow-hidden focus:outline-none" title="Ubah Mode Layar">
          <!-- Sun Icon (visible in dark mode) -->
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4.5 w-4.5 sm:h-5 sm:w-5 hidden dark:block" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364-6.364l-.707.707M6.343 17.657l-.707.707m12.728 0l-.707-.707M6.343 6.364l-.707-.707M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
          <!-- Moon Icon (visible in light mode) -->
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4.5 w-4.5 sm:h-5 sm:w-5 block dark:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
          </svg>
        </button>

        <!-- 2. Language Dropdown Selector (Always visible) -->
        <div class="relative group">
          <button class="flex items-center gap-1 p-2 sm:p-2.5 rounded-full hover:bg-white/10 active:scale-95 transition-all text-white/90 focus:outline-none text-[11px] sm:text-xs font-bold tracking-wider">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4.5 w-4.5 sm:h-5 sm:w-5 text-emas" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
            </svg>
            <span id="currentLangLabel">ID</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 opacity-60" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          <!-- Dropdown list -->
          <div class="absolute right-0 mt-2 w-28 bg-[#05291e]/98 backdrop-blur-xl border border-white/10 rounded-2xl shadow-[0_15px_30px_rgba(0,0,0,0.5)] py-1.5 scale-95 opacity-0 pointer-events-none group-hover:scale-100 group-hover:opacity-100 group-hover:pointer-events-auto transition-all duration-300 origin-top-right z-50">
            <button onclick="setLang('id')" class="w-full text-left px-3.5 py-1.5 hover:bg-white/5 text-xs font-semibold text-white/90 hover:text-white flex items-center justify-between">
              <span>Indonesia</span>
              <span class="text-[9px] text-emas font-bold">ID</span>
            </button>
            <button onclick="setLang('ar')" class="w-full text-left px-3.5 py-1.5 hover:bg-white/5 text-xs font-semibold text-white/90 hover:text-white flex items-center justify-between">
              <span>العربية</span>
              <span class="text-[9px] text-emas font-bold">AR</span>
            </button>
            <button onclick="setLang('su')" class="w-full text-left px-3.5 py-1.5 hover:bg-white/5 text-xs font-semibold text-white/90 hover:text-white flex items-center justify-between">
              <span>Sunda</span>
              <span class="text-[9px] text-emas font-bold">SU</span>
            </button>
            <button onclick="setLang('jv')" class="w-full text-left px-3.5 py-1.5 hover:bg-white/5 text-xs font-semibold text-white/90 hover:text-white flex items-center justify-between">
              <span>Jawa</span>
              <span class="text-[9px] text-emas font-bold">JV</span>
            </button>
          </div>
        </div>

        <!-- Desktop Menu - Mengatur Jarak Lebih Proporsional -->
        <div class="hidden lg:flex items-center gap-1.5 xl:gap-3 2xl:gap-6 ml-2 xl:ml-4 flex-shrink-0">
          <a href="/" class="relative text-white/80 hover:text-white py-2 text-[11px] xl:text-xs 2xl:text-[14px] font-display font-bold tracking-wider xl:tracking-widest transition-all duration-300 group">
            <span data-translate="beranda">BERANDA</span>
            <span class="absolute bottom-0 left-0 w-0 h-[3px] bg-gradient-to-r from-emas to-yellow-200 opacity-0 transition-all duration-500 ease-out rounded-full group-hover:w-full group-hover:opacity-100"></span>
          </a>
          <a href="/berita" class="relative text-white/80 hover:text-white py-2 text-[11px] xl:text-xs 2xl:text-[14px] font-display font-bold tracking-wider xl:tracking-widest transition-all duration-300 group">
            <span data-translate="berita">BERITA</span>
            <span class="absolute bottom-0 left-0 w-0 h-[3px] bg-gradient-to-r from-emas to-yellow-200 opacity-0 transition-all duration-500 ease-out rounded-full group-hover:w-full group-hover:opacity-100"></span>
          </a>
          <a href="/asatidz" class="relative text-white/80 hover:text-white py-2 text-[11px] xl:text-xs 2xl:text-[14px] font-display font-bold tracking-wider xl:tracking-widest transition-all duration-300 group">
            <span data-translate="asatidz">ASATIDZ</span>
            <span class="absolute bottom-0 left-0 w-0 h-[3px] bg-gradient-to-r from-emas to-yellow-200 opacity-0 transition-all duration-500 ease-out rounded-full group-hover:w-full group-hover:opacity-100"></span>
          </a>
          <a href="/kajian" class="relative text-white/80 hover:text-white py-2 text-[11px] xl:text-xs 2xl:text-[14px] font-display font-bold tracking-wider xl:tracking-widest transition-all duration-300 group">
            <span data-translate="kajian">KAJIAN</span>
            <span class="absolute bottom-0 left-0 w-0 h-[3px] bg-gradient-to-r from-emas to-yellow-200 opacity-0 transition-all duration-500 ease-out rounded-full group-hover:w-full group-hover:opacity-100"></span>
          </a>
          <a href="/galeri" class="relative text-white/80 hover:text-white py-2 text-[11px] xl:text-xs 2xl:text-[14px] font-display font-bold tracking-wider xl:tracking-widest transition-all duration-300 group">
            <span data-translate="galeri">GALERI</span>
            <span class="absolute bottom-0 left-0 w-0 h-[3px] bg-gradient-to-r from-emas to-yellow-200 opacity-0 transition-all duration-500 ease-out rounded-full group-hover:w-full group-hover:opacity-100"></span>
          </a>
          <a href="/tentang" class="relative text-white/80 hover:text-white py-2 text-[11px] xl:text-xs 2xl:text-[14px] font-display font-bold tracking-wider xl:tracking-widest transition-all duration-300 group">
            <span data-translate="tentang">TENTANG</span>
            <span class="absolute bottom-0 left-0 w-0 h-[3px] bg-gradient-to-r from-emas to-yellow-200 opacity-0 transition-all duration-500 ease-out rounded-full group-hover:w-full group-hover:opacity-100"></span>
          </a>
          <a href="/faq" class="relative text-white/80 hover:text-white py-2 text-[11px] xl:text-xs 2xl:text-[14px] font-display font-bold tracking-wider xl:tracking-widest transition-all duration-300 group">
            <span data-translate="faq">FAQ</span>
            <span class="absolute bottom-0 left-0 w-0 h-[3px] bg-gradient-to-r from-emas to-yellow-200 opacity-0 transition-all duration-500 ease-out rounded-full group-hover:w-full group-hover:opacity-100"></span>
          </a>
          
          <div class="flex items-center gap-1.5 xl:gap-2 ml-2 flex-shrink-0">
              <a href="/donasi" class="px-2.5 py-1.5 xl:px-4 xl:py-2 rounded-xl xl:rounded-2xl text-[10.5px] xl:text-[11.5px] font-display font-black border border-emas/40 text-emas hover:bg-emas hover:text-[#064e3b] hover:scale-105 active:scale-95 transition-all duration-500 flex items-center gap-1 shadow-lg shadow-emas/5 group/donasi">
                  <span class="w-2 h-2 rounded-full bg-emas animate-pulse"></span>
                  <span data-translate="donasi">DONASI</span>
              </a>
              <a href="/pendaftaran" class="bg-gradient-to-br from-yellow-400 via-emas to-yellow-600 text-[#064e3b] px-3 py-2 xl:px-4 xl:py-2.5 rounded-xl xl:rounded-2xl text-[10.5px] xl:text-[11.5px] font-display font-black shadow-[0_15px_30px_rgba(234,179,8,0.25)] hover:shadow-[0_20px_40px_rgba(234,179,8,0.45)] hover:scale-105 active:scale-95 transition-all duration-500 border border-yellow-300/50 flex items-center gap-1 uppercase tracking-wide">
                  <span data-translate="ppdb">PPDB ONLINE</span>
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 group-hover:translate-x-1.5 transition-transform" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" /></svg>
              </a>
          </div>
        </div>
      </div>

      <!-- Mobile Menu Button - Hidden to prevent overlap on mobile, using BottomNav instead -->
      <div class="hidden">
        <button id="mobileMenuBtn" class="text-white hover:text-emas focus:outline-none p-3 rounded-2xl bg-white/5 border border-white/10 transition-all active:scale-95">
          <svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path id="menuIcon" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 6h16M4 12h16M4 18h16" />
            <path id="closeIcon" class="hidden" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <style>
    .animate-shine-loop {
      animation: shine-loop 5.5s infinite ease-in-out;
    }

    @keyframes shine-loop {
      0%, 75% {
        transform: translateX(-150%) skewX(-25deg);
      }
      100% {
        transform: translateX(150%) skewX(-25deg);
      }
    }

    @keyframes shine-once {
      0% {
        transform: translateX(-150%) skewX(-25deg);
      }
      100% {
        transform: translateX(150%) skewX(-25deg);
      }
    }

    .group:hover .hover-shine {
      animation: shine-once 0.8s ease-in-out forwards;
    }

    .font-arabic-calligraphy {
      font-family: 'Aref Ruqaa', 'Amiri', serif;
    }

    .animate-fade-slide {
      animation: fade-slide-in 1.0s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    @keyframes fade-slide-in {
      0% {
        opacity: 0;
        transform: translateX(15px);
      }
      100% {
        opacity: 1;
        transform: translateX(0);
      }
    }
  </style>

  <!-- Mobile Menu Panel Premium -->
  <div id="mobileMenu" class="lg:hidden bg-[#05291e]/98 backdrop-blur-xl border border-white/10 rounded-[24px] mt-3 w-full absolute shadow-[0_30px_60px_rgba(0,0,0,0.6)] transition-all duration-300 ease-out transform opacity-0 scale-95 pointer-events-none -translate-y-4 origin-top z-[100]">
    <div class="px-5 pt-6 pb-10 space-y-1 flex flex-col">
      <a href="/" class="flex items-center gap-4 px-5 py-4 rounded-2xl text-[17px] font-display font-bold text-white hover:bg-white/5 active:scale-95 transition-all">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-emas" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" /></svg>
        BERANDA
      </a>
      <a href="/berita" class="flex items-center gap-4 px-5 py-4 rounded-2xl text-[17px] font-display font-bold text-white hover:bg-white/5 active:scale-95 transition-all">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-emas" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" /></svg>
        BERITA
      </a>
      <a href="/asatidz" class="flex items-center gap-4 px-5 py-4 rounded-2xl text-[17px] font-display font-bold text-white hover:bg-white/5 active:scale-95 transition-all">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-emas" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" /></svg>
        ASATIDZ
      </a>
      <a href="/kajian" class="flex items-center gap-4 px-5 py-4 rounded-2xl text-[17px] font-display font-bold text-white hover:bg-white/5 active:scale-95 transition-all">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-emas" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
        KAJIAN
      </a>
      <a href="/galeri" class="flex items-center gap-4 px-5 py-4 rounded-2xl text-[17px] font-display font-bold text-white hover:bg-white/5 active:scale-95 transition-all">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-emas" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
        GALERI
      </a>
      <a href="/donasi" class="flex items-center gap-4 px-5 py-4 rounded-2xl text-[17px] font-display font-bold text-emas hover:bg-white/5 active:scale-95 transition-all">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" /></svg>
        DONASI
      </a>
      
      <div class="pt-6 mt-4 border-t border-white/5 px-2">
        <a href="/pendaftaran" class="flex justify-center items-center w-full bg-gradient-to-r from-yellow-500 to-emas text-[#064e3b] active:scale-95 px-4 py-5 rounded-[20px] text-xl font-display font-black shadow-2xl transition-all uppercase tracking-tight">
          PPDB ONLINE
        </a>
      </div>
    </div>
  </div>
</nav>

<script>
  // Script Toggle Mobile Menu
  document.addEventListener('DOMContentLoaded', () => {
    const btn = document.getElementById('mobileMenuBtn');
    const menu = document.getElementById('mobileMenu');
    const menuIcon = document.getElementById('menuIcon');
    const closeIcon = document.getElementById('closeIcon');

    if (btn && menu) {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const isClosed = menu.classList.contains('pointer-events-none');
        if (isClosed) {
          menu.classList.remove('opacity-0', 'scale-95', 'pointer-events-none', '-translate-y-4');
          menu.classList.add('opacity-100', 'scale-100', 'pointer-events-auto', 'translate-y-0');
          menuIcon?.classList.add('hidden');
          closeIcon?.classList.remove('hidden');
        } else {
          menu.classList.remove('opacity-100', 'scale-100', 'pointer-events-auto', 'translate-y-0');
          menu.classList.add('opacity-0', 'scale-95', 'pointer-events-none', '-translate-y-4');
          menuIcon?.classList.remove('hidden');
          closeIcon?.classList.add('hidden');
        }
      });

      // Tutup menu saat mengklik bagian luar layar
      document.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        if (!menu.contains(target) && !btn.contains(target)) {
          menu.classList.remove('opacity-100', 'scale-100', 'pointer-events-auto', 'translate-y-0');
          menu.classList.add('opacity-0', 'scale-95', 'pointer-events-none', '-translate-y-4');
          menuIcon?.classList.remove('hidden');
          closeIcon?.classList.add('hidden');
        }
      });
    }

    // Script interaksi scroll untuk memperkecil navbar
    const nav = document.getElementById('mainNavbar');
    const adjustNavbar = () => {
      if (window.scrollY > 20) {
        nav?.classList.remove('top-4', 'w-[92%]', 'bg-[#064e3b]/90', 'rounded-[24px]');
        nav?.classList.add('top-0', 'w-full', 'bg-[#053e2f]/98', 'rounded-none', 'border-x-0', 'border-t-0', 'shadow-[0_10px_30px_rgba(0,0,0,0.4)]');
      } else {
        nav?.classList.remove('top-0', 'w-full', 'bg-[#053e2f]/98', 'rounded-none', 'border-x-0', 'border-t-0', 'shadow-[0_10px_30px_rgba(0,0,0,0.4)]');
        nav?.classList.add('top-4', 'w-[92%]', 'bg-[#064e3b]/90', 'rounded-[24px]');
      }
    };
    
    window.addEventListener('scroll', adjustNavbar);
    adjustNavbar(); // Jalankan sekali saat load

    // Script Theme Toggle
    const themeBtn = document.getElementById('themeToggleBtn');
    if (themeBtn) {
      themeBtn.addEventListener('click', () => {
        const docClass = document.documentElement.classList;
        if (docClass.contains('dark')) {
          docClass.remove('dark');
          localStorage.setItem('theme', 'light');
        } else {
          docClass.add('dark');
          localStorage.setItem('theme', 'dark');
        }
      });
    }

    // Set Language label on load
    const savedLang = localStorage.getItem('lang') || 'id';
    const label = document.getElementById('currentLangLabel');
    if (label) {
      label.textContent = savedLang.toUpperCase();
    }
  });
</script>
