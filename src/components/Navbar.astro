---
---
<nav id="mainNavbar" class="fixed top-4 left-1/2 -translate-x-1/2 w-[92%] max-w-[1400px] bg-[#064e3b]/90 backdrop-blur-xl text-white shadow-[0_20px_50px_rgba(0,0,0,0.3)] z-[100] border border-white/10 rounded-[24px] transition-all duration-500">
  <div class="max-w-[1400px] mx-auto px-6 lg:px-10">
    <div class="flex justify-between h-24">
      <!-- Brand Section -->
      <div class="flex items-center">
        <a href="/" class="flex-shrink-0 flex items-center gap-4 group">
          <div class="bg-white p-2 rounded-2xl shadow-[0_0_30px_rgba(255,255,255,0.2)] group-hover:shadow-[0_0_40px_rgba(255,255,255,0.4)] transition-all duration-700 group-hover:rotate-[10deg] transform">
            <img src="/images/logo.png" alt="Logo PP Nailul Khoir" class="h-10 sm:h-12 lg:h-14 w-auto object-contain" />
          </div>
          <div class="flex flex-col justify-center leading-tight">
            <span class="font-display font-medium text-[9px] md:text-[10px] lg:text-[12px] tracking-[0.25em] text-emas group-hover:text-white transition-colors uppercase">Yayasan Pondok Pesantren</span>
            <span class="font-display font-black text-base md:text-lg lg:text-[22px] tracking-tight text-white transition-all duration-500 group-hover:drop-shadow-[0_0_15px_rgba(255,255,255,0.5)] uppercase">
              Nailul <span class="text-emas whitespace-nowrap">Khoir</span>
            </span>
            <span class="text-[8px] md:text-[9px] font-bold text-green-400 mt-1 tracking-[0.3em] uppercase opacity-70">Banjaran - Majalengka</span>
          </div>
        </a>
      </div>
      
      <!-- Desktop Menu - Mengatur Jarak Lebih Proporsional -->
      <div class="hidden lg:flex items-center gap-2 xl:gap-6 ml-10 xl:ml-16">
        <a href="/" class="nav-link group">
          BERANDA
          <span class="nav-underline"></span>
        </a>
        <a href="/berita" class="nav-link group">
          BERITA
          <span class="nav-underline"></span>
        </a>
        <a href="/asatidz" class="nav-link group">
          ASATIDZ
          <span class="nav-underline"></span>
        </a>
        <a href="/kajian" class="nav-link group">
          KAJIAN
          <span class="nav-underline"></span>
        </a>
        <a href="/galeri" class="nav-link group">
          GALERI
          <span class="nav-underline"></span>
        </a>
        <a href="/tentang" class="nav-link group">
          TENTANG
          <span class="nav-underline"></span>
        </a>
        <a href="/faq" class="nav-link group">
          FAQ
          <span class="nav-underline"></span>
        </a>
        
        <div class="flex items-center gap-3 ml-4 xl:ml-8">
            <a href="/donasi" class="donasi-btn group/donasi">
                <span class="donasi-dot"></span>
                DONASI
            </a>
            <a href="/pendaftaran" class="ppdb-btn">
                PPDB ONLINE
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 group-hover:translate-x-1.5 transition-transform" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" /></svg>
            </a>
        </div>
      </div>

      <!-- Mobile Menu Button -->
      <div class="flex items-center lg:hidden">
        <button id="mobileMenuBtn" class="text-white hover:text-emas focus:outline-none p-3 rounded-2xl bg-white/5 border border-white/10 transition-all active:scale-95">
          <svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path id="menuIcon" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 6h16M4 12h16M4 18h16" />
            <path id="closeIcon" class="hidden" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <style>
    .nav-link {
        @apply relative text-white/80 hover:text-white py-2 text-[14px] font-display font-bold tracking-widest transition-all duration-300;
    }
    .nav-underline {
        @apply absolute bottom-0 left-0 w-0 h-[3px] bg-gradient-to-r from-emas to-yellow-200 opacity-0 transition-all duration-500 ease-out rounded-full;
    }
    .nav-link:hover .nav-underline {
        @apply w-full opacity-100;
    }
    .donasi-btn {
        @apply px-6 py-2.5 rounded-2xl text-[13px] font-display font-black border border-emas/40 text-emas hover:bg-emas hover:text-[#064e3b] hover:scale-105 active:scale-95 transition-all duration-500 flex items-center gap-2 shadow-lg shadow-emas/5;
    }
    .donasi-dot {
        @apply w-2.5 h-2.5 rounded-full bg-emas animate-pulse;
    }
    .ppdb-btn {
        @apply bg-gradient-to-br from-yellow-400 via-emas to-yellow-600 text-[#064e3b] px-7 py-3 rounded-2xl text-[13px] font-display font-black shadow-[0_15px_30px_rgba(234,179,8,0.25)] hover:shadow-[0_20px_40px_rgba(234,179,8,0.45)] hover:scale-105 active:scale-95 transition-all duration-500 border border-yellow-300/50 flex items-center gap-2 uppercase tracking-wider;
    }
  </style>

  <!-- Mobile Menu Panel Premium -->
  <div id="mobileMenu" class="hidden lg:hidden bg-[#042f22]/98 backdrop-blur-3xl border border-white/10 rounded-[24px] mt-3 w-full absolute shadow-[0_30px_60px_rgba(0,0,0,0.6)] transition-all duration-300">
    <div class="px-5 pt-6 pb-10 space-y-1 flex flex-col">
      <a href="/" class="flex items-center gap-4 px-5 py-4 rounded-2xl text-[17px] font-display font-bold text-white hover:bg-white/5 active:scale-95 transition-all">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-emas" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" /></svg>
        BERANDA
      </a>
      <a href="/berita" class="flex items-center gap-4 px-5 py-4 rounded-2xl text-[17px] font-display font-bold text-white hover:bg-white/5 active:scale-95 transition-all">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-emas" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" /></svg>
        BERITA
      </a>
      <a href="/asatidz" class="flex items-center gap-4 px-5 py-4 rounded-2xl text-[17px] font-display font-bold text-white hover:bg-white/5 active:scale-95 transition-all">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-emas" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" /></svg>
        ASATIDZ
      </a>
      <a href="/kajian" class="flex items-center gap-4 px-5 py-4 rounded-2xl text-[17px] font-display font-bold text-white hover:bg-white/5 active:scale-95 transition-all">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-emas" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
        KAJIAN
      </a>
      <a href="/galeri" class="flex items-center gap-4 px-5 py-4 rounded-2xl text-[17px] font-display font-bold text-white hover:bg-white/5 active:scale-95 transition-all">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-emas" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
        GALERI
      </a>
      <a href="/donasi" class="flex items-center gap-4 px-5 py-4 rounded-2xl text-[17px] font-display font-bold text-emas hover:bg-white/5 active:scale-95 transition-all">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" /></svg>
        DONASI
      </a>
      
      <div class="pt-6 mt-4 border-t border-white/5 px-2">
        <a href="/pendaftaran" class="flex justify-center items-center w-full bg-gradient-to-r from-yellow-500 to-emas text-[#064e3b] active:scale-95 px-4 py-5 rounded-[20px] text-xl font-display font-black shadow-2xl transition-all uppercase tracking-tight">
          PPDB ONLINE
        </a>
      </div>
    </div>
  </div>
</nav>

<script>
  // Script Toggle Mobile Menu
  document.addEventListener('DOMContentLoaded', () => {
    const btn = document.getElementById('mobileMenuBtn');
    const menu = document.getElementById('mobileMenu');
    const menuIcon = document.getElementById('menuIcon');
    const closeIcon = document.getElementById('closeIcon');

    if (btn && menu) {
      btn.addEventListener('click', () => {
        menu.classList.toggle('hidden');
        menuIcon?.classList.toggle('hidden');
        closeIcon?.classList.toggle('hidden');
      });
    }

    // Script interaksi scroll untuk memperkecil navbar
    const nav = document.getElementById('mainNavbar');
    const adjustNavbar = () => {
      if (window.scrollY > 20) {
        nav?.classList.remove('top-4', 'w-[92%]', 'bg-[#064e3b]/90', 'rounded-[24px]');
        nav?.classList.add('top-0', 'w-full', 'bg-[#053e2f]/98', 'rounded-none', 'border-x-0', 'border-t-0', 'shadow-[0_10px_30px_rgba(0,0,0,0.4)]');
      } else {
        nav?.classList.remove('top-0', 'w-full', 'bg-[#053e2f]/98', 'rounded-none', 'border-x-0', 'border-t-0', 'shadow-[0_10px_30px_rgba(0,0,0,0.4)]');
        nav?.classList.add('top-4', 'w-[92%]', 'bg-[#064e3b]/90', 'rounded-[24px]');
      }
    };
    
    window.addEventListener('scroll', adjustNavbar);
    adjustNavbar(); // Jalankan sekali saat load
  });
</script>
