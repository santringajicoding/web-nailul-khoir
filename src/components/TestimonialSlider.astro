---
// src/components/TestimonialSlider.astro
import { supabase } from '../lib/supabase.js';

// Mengambil testimoni dari database
const { data: dbTestimoni, error } = await supabase
  .from('testimoni')
  .select('*')
  .order('created_at', { ascending: false });

interface Testimonial {
  nama: string;
  peran: string;
  teks: string;
  foto: string;
}

// Fallback jika database kosong
let testimoniList: Testimonial[] = [];

if (dbTestimoni && dbTestimoni.length > 0) {
  testimoniList = dbTestimoni.map(t => ({
    nama: t.nama,
    peran: t.peran,
    teks: t.teks,
    foto: t.foto_url || `https://ui-avatars.com/api/?name=${encodeURIComponent(t.nama)}&background=15803d&color=fff`
  }));
} else {
  testimoniList = [
    {
      nama: "Muhammad Farhan Al-Ghifari",
      peran: "Alumni Al-Azhar University, Kairo",
      teks: "Belajar di Nailul Khoir menanamkan kecintaan yang mendalam pada kitab turats salaf. Alhamdulillah, dasar keilmuan bahasa Arab yang kuat memudahkan saya menuntut ilmu syariah di Universitas Al-Azhar, Kairo.",
      foto: "https://ui-avatars.com/api/?name=Muhammad+Farhan&background=064e3b&color=fff"
    },
    {
      nama: "Ahmad Fachrurozi",
      peran: "Alumni SMK - Software Engineer",
      teks: "Kurikulum teknologi digital di SMK Nailul Khoir sangat relevan dengan industri. Berkat bimbingan intensif dan praktek riil di lab komputer, saya berhasil menembus karir sebagai software engineer profesional.",
      foto: "https://ui-avatars.com/api/?name=Ahmad+Fachrurozi&background=dfb15b&color=fff"
    },
    {
      nama: "Siti Hajar Nurhasanah",
      peran: "Alumni Tahfidz - Universitas Islam",
      teks: "Memadukan hafalan Al-Qur'an (Tahfidz) dengan pendidikan formal SMP-SMK di Nailul Khoir membentuk karakter saya menjadi mandiri dan disiplin. Hal ini menjadi kunci sukses saya saat kuliah.",
      foto: "https://ui-avatars.com/api/?name=Siti+Hajar&background=EC4899&color=fff"
    }
  ];
}
---

<section class="py-16 bg-white overflow-hidden relative">
  <!-- Dekorasi -->
  <div class="absolute top-0 right-0 w-64 h-64 bg-green-50 rounded-full blur-3xl opacity-50 -translate-y-1/2 translate-x-1/2 pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12" data-aos="fade-up">
      <h2 class="text-base text-emas font-bold tracking-wide uppercase">Testimoni Mereka</h2>
      <p class="mt-2 text-3xl font-display leading-8 font-extrabold tracking-tight text-pesantren sm:text-4xl">
        Apa Kata Alumni & Wali Santri?
      </p>
    </div>

    <!-- Gunakan Grid di desktop, Flex-scrollable di mobile -->
    <div class="flex overflow-x-auto snap-x snap-mandatory gap-6 pb-8 md:grid md:grid-cols-3 hide-scrollbar">
      {testimoniList.map((testi, i) => (
        <div class="min-w-[85vw] md:min-w-0 snap-center bg-gray-50 rounded-3xl p-8 border border-gray-100 shadow-md hover:shadow-xl transition-shadow relative" data-aos="fade-up" data-aos-delay={i * 150}>
          <!-- Quote Icon -->
          <svg class="absolute top-6 right-6 w-12 h-12 text-emas opacity-20" fill="currentColor" viewBox="0 0 24 24"><path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z" /></svg>
          
          <p class="text-gray-700 leading-loose italic mb-8 relative z-10">"{testi.teks}"</p>
          
          <div class="flex items-center gap-4 mt-auto">
            <img src={testi.foto} alt={testi.nama} class="w-14 h-14 rounded-full border-2 border-emas shadow-sm" loading="lazy" />
            <div>
              <h4 class="font-display font-bold text-gray-900">{testi.nama}</h4>
              <span class="text-sm font-medium text-pesantren">{testi.peran}</span>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>

  <style>
    /* CSS untuk menyembunyikan scrollbar di slider tipe flex di HP */
    .hide-scrollbar::-webkit-scrollbar {
      display: none;
    }
    .hide-scrollbar {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }
  </style>
</section>
