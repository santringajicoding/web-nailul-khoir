# Credentials untuk koneksi database Supabase Nailul Khoir
# Ganti nilai di bawah ini dengan URL dan Anon Key proyek Supabase Anda sendiri.
# Salin file ini menjadi ".env" di komputer lokal Anda sebelum menjalankan "npm run dev".

PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
